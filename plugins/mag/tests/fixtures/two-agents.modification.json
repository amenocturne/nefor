{
  "actors": [
    {
      "id": "docs-explorer.entry",
      "factory": "adapter",
      "params": { "seed": "provider-in" },
      "routes": {
        "generic-provider.ProviderOut": ["docs-explorer.llm"]
      }
    },
    {
      "id": "docs-explorer.llm",
      "factory": "llm",
      "params": {
        "model": "opus",
        "provider": "chatgpt-provider",
        "system": "Explore the codebase and report findings.",
        "tools": ["fs/read", "grep"]
      },
      "routes": {
        "generic-tool.ToolCalls": ["docs-explorer.run-tool"],
        "generic-provider.FinalAnswer": ["code-writer.entry"]
      }
    },
    {
      "id": "docs-explorer.run-tool",
      "factory": "run-tool",
      "params": {},
      "routes": {
        "generic-tool.ToolHandle": ["docs-explorer.tool-result"]
      }
    },
    {
      "id": "docs-explorer.tool-result",
      "factory": "tool-result",
      "params": {},
      "routes": {
        "generic-provider.ProviderOut": ["docs-explorer.llm"]
      }
    },

    {
      "id": "code-writer.entry",
      "factory": "adapter",
      "params": { "seed": "provider-in" },
      "routes": {
        "generic-provider.ProviderOut": ["code-writer.llm"]
      }
    },
    {
      "id": "code-writer.llm",
      "factory": "llm",
      "params": {
        "model": "opus",
        "provider": "chatgpt-provider",
        "system": "Implement the change from the findings.",
        "tools": ["fs/read", "fs/edit", "shell"]
      },
      "routes": {
        "generic-tool.ToolCalls": ["code-writer.run-tool"],
        "generic-provider.FinalAnswer": ["sink"]
      }
    },
    {
      "id": "code-writer.run-tool",
      "factory": "run-tool",
      "params": {},
      "routes": {
        "generic-tool.ToolHandle": ["code-writer.tool-result"]
      }
    },
    {
      "id": "code-writer.tool-result",
      "factory": "tool-result",
      "params": {},
      "routes": {
        "generic-provider.ProviderOut": ["code-writer.llm"]
      }
    },

    {
      "id": "sink",
      "factory": "sink",
      "params": {},
      "routes": {}
    }
  ],
  "messages": [
    {
      "to": "docs-explorer.entry",
      "content": { "kind": "task", "prompt": "<initial task text>" }
    }
  ],
  "kills": [],
  "rules": []
}
