{
  "aggregates": {
    "default": "test-default",
    "full": "test-full"
  },
  "cargo_full": {
    "harness_packages": [
      "basic-tools-plugin",
      "chatgpt-provider",
      "mag-plugin",
      "mock-plugin",
      "nefor",
      "nefor-cargo-test-harness",
      "nefor-provider-http",
      "nefor-test-watchdog",
      "openai-provider"
    ],
    "separate": [
      {
        "package": "nefor-tui",
        "test_args": ["--test-threads=1"]
      }
    ]
  },
  "non_cargo": [
    { "recipe": "check-test-lanes", "lane": "default", "entrypoint": "tools/check-test-lanes.sh" },
    { "recipe": "test-test-lanes-checker", "lane": "default", "entrypoint": "tools/test-test-lanes-checker.sh" },
    { "recipe": "test-package-release", "lane": "default", "entrypoint": "tools/test-package-release.sh" },
    { "recipe": "test-lua-dylibs", "lane": "default", "entrypoint": "tools/test-lua-dylibs.sh" },
    { "recipe": "test-docs", "lane": "default", "entrypoint": "tools/check-markdown-links.ts" },
    { "recipe": "test-session-inspector", "lane": "default", "entrypoint": "tools/session-inspector/server.test.ts" },
    { "recipe": "test-release-bundle", "lane": "full", "entrypoint": "tools/test-release-bundle.sh" },
    { "recipe": "test-build-version", "lane": "full", "entrypoint": "tools/test-build-version.sh" },
    { "recipe": "test-tui-scenarios", "lane": "full" },
    { "recipe": "test-source-prerequisites", "lane": "default", "entrypoint": "tools/source-prerequisites.test.ts" }
  ]
}
