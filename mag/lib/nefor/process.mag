// Running one program directly, without a shell, as a workflow step.
import nefor.capability.{}

import nefor.contracts.{}

import nefor.graph.{}

// The directory the runtime was started in, for a cwd field. A relative cwd
// is resolved against that directory.
let cwd = "."

// argv is the program followed by its arguments; nothing is expanded or
// interpreted by a shell.
type ProcessExecParams {argv: List<String>, cwd: String, timeout: nefor.contracts.Timeout}

// A node that runs the program when the workflow reaches it and produces what
// it printed and how it ended. id names the node in the run.
let exec: fn(String, ProcessExecParams) -> nefor.graph.Node<Unit, nefor.contracts.ProcessResult> = |id, params| =>
  nefor.capability.process_exec<nefor.contracts.ProcessResult>(id, get(params, "argv"), get(params, "cwd"), get(params, "timeout"))
