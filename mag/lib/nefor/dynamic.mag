import nefor.artifact.{}

import nefor.contracts.{}

import core.map.{}

import core.set.{}

import nefor.graph.{}

import nefor.mag.{}

import nefor.node.{}

type DynamicList<T> {}

type Indexed<T> {collection: String, index: Int, value: T}

type DynamicCount {collection: String, count: Int}

type DynamicEvent<T> = Item(Indexed<T>) | Complete(DynamicCount)

type DynamicParams {}

type DynamicIndexParams {collection: String, index: Int}

type DynamicContextParams {item_schema: TypeSchema}

type CaptureValueIdentity {`type`: SemanticTypeId, value: PackedValue}

type CaptureIdentity {capture: String, `type`: SemanticTypeId}

type FieldIdentity {field: String, record: String, `type`: SemanticTypeId}

type DecimalIdentity {int_to_decimal_string: String}

type ConcatIdentity {concat_strings: List<String>}

let dynamic_each_factory = "nefor.factory.dynamic-each"

let dynamic_output_factory = "nefor.factory.dynamic-output"

let dynamic_index_factory = "nefor.factory.dynamic-index"

let dynamic_all_factory = "nefor.factory.dynamic-all"

type ValueRef<T> {id: String, `type`: TypeTag<T>, captures: Map<String, nefor.mag.TypedCapture>, expressions: List<nefor.mag.Expression>}


let expression_id<T>: fn(T) -> String = |value| => canonical(value)

type OrderedExpressions {seen: Set<String>, values: List<nefor.mag.Expression>}

let stored_expression_id: fn(nefor.mag.Expression) -> String = |value| => match value { case Trigger(expression) => get(expression, "id"), case Capture(expression) => get(expression, "id"), case Field(expression) => get(expression, "id"), case IntToDecimalString(expression) => get(expression, "id"), case ConcatStrings(expression) => get(expression, "id") }

let insert_expression: fn(OrderedExpressions, nefor.mag.Expression) -> OrderedExpressions = |state, value| => {
  let id = stored_expression_id(value)
  if core.set.contains(get(state, "seen"), id) then state else OrderedExpressions {seen: core.set.insert(get(state, "seen"), id), values: concat(get(state, "values"), [value])}
}

let unique_expressions: fn(List<nefor.mag.Expression>) -> List<nefor.mag.Expression> = |values| => get(fold(insert_expression, OrderedExpressions {seen: core.set.empty<String>(), values: ([]: List<nefor.mag.Expression>)}, values), "values")

let merge_expressions: fn(List<List<nefor.mag.Expression>>) -> List<nefor.mag.Expression> = |values| => unique_expressions(fold(((|out, next| => concat(out, next)) : fn(List<nefor.mag.Expression>, List<nefor.mag.Expression>) -> List<nefor.mag.Expression>), ([]: List<nefor.mag.Expression>), values))

let merge_captures: fn(List<Map<String, nefor.mag.TypedCapture>>) -> Map<String, nefor.mag.TypedCapture> = |values| => fold(((|out, next| => __map_union_left(out, next)) : fn(Map<String, nefor.mag.TypedCapture>, Map<String, nefor.mag.TypedCapture>) -> Map<String, nefor.mag.TypedCapture>), (core.map.empty<String, _>(): Map<String, nefor.mag.TypedCapture>), values)

let trigger_ref<T>: fn(TypeTag<T>) -> ValueRef<T> = |`type`| => {
  let descriptor = type_evidence(`type`)
  ValueRef<T> {id: "trigger", `type`: `type`, captures: (core.map.empty<String, _>(): Map<String, nefor.mag.TypedCapture>), expressions: [named(nefor.mag.Expression, Trigger, nefor.mag.Trigger {id: "trigger", result_type: type_id(descriptor)})]}
}

let capture_ref<T>: fn(T) -> ValueRef<T> = |value| => {
  let `type` = type_tag<T>()
  let descriptor = value_type_evidence(value, type_evidence(`type`))
  let capture_id = expression_id(CaptureValueIdentity {`type`: type_id(descriptor), value: pack(value)})
  let id = expression_id(CaptureIdentity {capture: capture_id, `type`: type_id(descriptor)})
  let captured = nefor.mag.TypedCapture {semantic_type: descriptor, semantic_type_id: type_id(descriptor), value: pack(value)}
  ValueRef<T> {id: id, `type`: `type`, captures: core.map.insert((core.map.empty<String, _>(): Map<String, nefor.mag.TypedCapture>), capture_id, captured), expressions: [named(nefor.mag.Expression, Capture, nefor.mag.Capture {id: id, result_type: type_id(descriptor), capture: capture_id})]}
}

let field_ref<R, T>: fn(ValueRef<R>, String, TypeTag<T>) -> ValueRef<T> = |record, field, `type`| => {
  let id = expression_id(FieldIdentity {field: field, record: get(record, "id"), `type`: type_id(type_evidence(`type`))})
  ValueRef<T> {id: id, `type`: `type`, captures: get(record, "captures"), expressions: concat(get(record, "expressions"), [named(nefor.mag.Expression, Field, nefor.mag.Field {id: id, result_type: type_id(type_evidence(`type`)), record: get(record, "id"), field: field})])}
}

let int_to_decimal_string_ref: fn(ValueRef<Int>) -> ValueRef<String> = |value| => {
  let id = expression_id(DecimalIdentity {int_to_decimal_string: get(value, "id")})
  ValueRef<String> {id: id, `type`: type_tag<String>(), captures: get(value, "captures"), expressions: concat(get(value, "expressions"), [named(nefor.mag.Expression, IntToDecimalString, nefor.mag.IntToDecimalString {id: id, result_type: type_id(type_evidence(type_tag<String>())), value: get(value, "id")})])}
}

let concat_strings_ref: fn(List<ValueRef<String>>) -> ValueRef<String> = |values| => {
  let ids = map(((|value| => get(value, "id")) : fn(ValueRef<String>) -> String), values)
  let id = expression_id(ConcatIdentity {concat_strings: ids})
  ValueRef<String> {id: id, `type`: type_tag<String>(), captures: merge_captures(map(((|value| => get(value, "captures")) : fn(ValueRef<String>) -> Map<String, nefor.mag.TypedCapture>), values)), expressions: concat(merge_expressions(map(((|value| => get(value, "expressions")) : fn(ValueRef<String>) -> List<nefor.mag.Expression>), values)), [named(nefor.mag.Expression, ConcatStrings, nefor.mag.ConcatStrings {id: id, result_type: type_id(type_evidence(type_tag<String>())), values: ids})])}
}

let local_actor_ref: fn(String) -> nefor.mag.TemplateEndpoint = |slot| => named(nefor.mag.TemplateEndpoint, LocalActorRef, nefor.mag.LocalActorRef {slot: slot})

let existing_actor_ref: fn(String) -> nefor.mag.TemplateEndpoint = |id| => named(nefor.mag.TemplateEndpoint, ExistingActorRef, nefor.mag.ExistingActorRef {id: id})

let template_port<T>: fn(nefor.mag.TemplateEndpoint, TypeTag<T>, String) -> nefor.mag.TemplatePort = |endpoint, `type`, wire| => {
  let descriptor = type_evidence(`type`)
  nefor.mag.TemplatePort {endpoint: endpoint, `type`: descriptor, type_id: type_id(descriptor), wire: wire}
}

let fixed_segment: fn(String) -> nefor.mag.PathSegment = |value| => named(nefor.mag.PathSegment, FixedPathSegment, nefor.mag.FixedPathSegment {value: value})

let bound_segment: fn(ValueRef<String>) -> nefor.mag.PathSegment = |value| => named(nefor.mag.PathSegment, BoundPathSegment, nefor.mag.BoundPathSegment {value: get(value, "id")})

let actor_id_relocation: fn(String, List<String>) -> nefor.mag.ActorReferenceRelocation = |slot, path| => nefor.mag.ActorReferenceRelocation {actor: nefor.mag.LocalActorRef {slot: slot}, path: path, shape: "actor_id"}

let actor_id_list_relocation: fn(String, List<String>) -> nefor.mag.ActorReferenceRelocation = |slot, path| => nefor.mag.ActorReferenceRelocation {actor: nefor.mag.LocalActorRef {slot: slot}, path: path, shape: "actor_id_list"}

let indexed_result<T, O>: fn(String, Indexed<T>) -> nefor.graph.Node<O, DynamicEvent<O>> = |id, entry| => {
  let output_type = type_tag<O>()
  let input = nefor.graph.port(id, output_type, "nefor.dynamic.IndexInput")
  let output = nefor.graph.port(id, type_tag<DynamicEvent<O>>(), "nefor.dynamic.Event")
  nefor.graph.node(id, "ordinary", [nefor.graph.actor(id, dynamic_index_factory, [type_evidence(output_type), type_evidence(type_tag<DynamicEvent<O>>())], DynamicIndexParams {collection: get(entry, "collection"), index: get(entry, "index")}, nefor.graph.store_port(input), [nefor.graph.store_port(output)])], [], [], input, output)
}

let context<T>: fn(String) -> nefor.graph.Node<DynamicList<T>, nefor.contracts.ProviderInput> = |id| => {
  let item_type = type_tag<T>()
  let input = nefor.graph.port(id, type_tag<DynamicList<T>>(), "nefor.dynamic.Input")
  let output = nefor.graph.port(id, type_tag<nefor.contracts.ProviderInput>(), "generic-provider.ProviderOut")
  nefor.graph.node(id, "ordinary", [nefor.graph.actor(id, dynamic_all_factory, [type_evidence(item_type)], DynamicContextParams {item_schema: type_schema(item_type)}, nefor.graph.store_port(input), [nefor.graph.store_port(output)])], [], [], input, output)
}

// A closed actor contract is an affirmative, audited single-result assertion.
// The runtime checks the same relocations against its factory declarations.
let audited_relocations: fn(String, String) -> List<nefor.graph.Relocation> = |factory, actor| =>
  if (=)(factory, "nefor.factory.run-tool") then [nefor.graph.Relocation {path: ["conversation_peer"], shape: "actor_id"}] else if nefor.graph.contains_string(["nefor.factory.source", "nefor.factory.adapter", "nefor.factory.llm", "nefor.factory.structured-output", "nefor.factory.tool-result", "nefor.factory.shell-script", "nefor.factory.process-exec", "nefor.factory.worktree-create", "nefor.factory.worktree-open"], factory) then [] else fail([str("traverse: actor ", actor, " has unsupported factory ", factory)])

let checked_relocations: fn(List<String>, nefor.graph.Actor) -> List<nefor.graph.Relocation> = |ids, actor| => match get(actor, "templateability") {
  case Unsupported(reason) => fail([str("traverse: actor ", get(actor, "id"), " (", get(actor, "factory"), "): ", reason)]),
  case Closed(relocations) => (((| | => {
    let expected = audited_relocations(get(actor, "factory"), get(actor, "id"))
    let refs = flat_map(((|relocation| => packed_path_strings(get(actor, "params"), get(relocation, "path"), (=)(get(relocation, "shape"), "actor_id_list"))) : fn(nefor.graph.Relocation) -> List<String>), relocations)
    if not(nefor.graph.serialized_equal(relocations, expected)) then fail([str("traverse: actor ", get(actor, "id"), " has missing, duplicate, overlapping or undeclared relocation paths")]) else if not(nefor.graph.all_strings_in(refs, ids)) then fail([str("traverse: actor ", get(actor, "id"), " references an actor outside the closed worker")]) else relocations
  }) : fn() -> List<nefor.graph.Relocation>))(),
}

let worker_check_id: fn(List<String>, String) -> String = |ids, candidate| => if nefor.graph.contains_string(ids, candidate) then worker_check_id(ids, str(candidate, "-")) else candidate

// Inspect record fields, sum payloads, and collection/product components too:
// nominal generic arguments alone do not describe every nested protocol.
let descriptor_streaming: fn(TypeDescriptor) -> Bool = |descriptor| =>
  if (=)(type_constructor(descriptor), type_constructor(type_evidence(type_tag<DynamicList<Unit>>()))) then true else not((=)(count(filter(descriptor_streaming, type_components(descriptor))), 0))

// Actor reachability is checked inside the node boundary as well as across
// nodes; an internally disconnected cycle is not a closed worker computation.
let worker_reachable: fn(List<String>, List<nefor.graph.StoredRoute>, Bool) -> List<String> = |visited, routes, reverse| => {
  let next = nefor.graph.ordered_strings(concat(visited, flat_map(((|route| => {
    let from = canonical(get(if reverse then get(route, "to") else get(route, "from"), "endpoint"))
    let to = canonical(get(if reverse then get(route, "from") else get(route, "to"), "endpoint"))
    if nefor.graph.contains_string(visited, from) then [to] else []
  }) : fn(nefor.graph.StoredRoute) -> List<String>), routes)))
  if (=)(count(next), count(visited)) then next else worker_reachable(next, routes, reverse)
}

let boundary_leaf_endpoints: fn(List<nefor.graph.BoundaryLeaf>) -> List<String> = |leaves| => nefor.graph.ordered_strings(map(((|leaf| => canonical(get(get(leaf, "port"), "endpoint"))) : fn(nefor.graph.BoundaryLeaf) -> String), leaves))

let identity_flow: fn(nefor.graph.Flow) -> Bool = |flow| => (=)(count(get(flow, "steps")), 0)

// Validate a worker before converting it. Exactly one occurrence value is the
// exposed input's activation; anonymous boundary flow is retained as metadata.
let checked_worker<I, O>: fn(nefor.graph.Node<I, O>) -> nefor.graph.Node<I, O> = |value| => {
  let worker = nefor.graph.normalize_node(value)
  let identity_conflicts = nefor.graph.node_identity_conflicts(worker)
  let actors = get(worker, "actors")
  let ids = nefor.graph.actor_ids(actors)
  let endpoint_ids = map(((|id| => canonical(nefor.graph.actor_endpoint(id))) : fn(String) -> String), ids)
  let checked_actor_refs = map(((|actor| => checked_relocations(ids, actor)) : fn(nefor.graph.Actor) -> List<nefor.graph.Relocation>), actors)
  let terminal = nefor.graph.output<O>(worker_check_id(ids, "traverse.validation.output"))
  let topology = nefor.graph.graph([nefor.graph.edge(worker, terminal)])
  let analysis = nefor.graph.analyze_graph(topology)
  let input = nefor.graph.store_boundary(get(worker, "input"))
  let output = nefor.graph.store_boundary(get(worker, "output"))
  let input_leaves = get(input, "leaves")
  let output_leaves = get(output, "leaves")
  let input_starts = boundary_leaf_endpoints(input_leaves)
  let output_ends = boundary_leaf_endpoints(output_leaves)
  let actor_free_boundary = if (=)(count(actors), 0) then if (=)(count(input_leaves), 0) then if (=)(count(output_leaves), 0) then if not((=)(count(get(input, "through")), 0)) then not((=)(count(get(output, "through")), 0)) else false else false else false else false
  let input_transformations = filter(((|leaf| => not(descriptor_accepts(get(get(leaf, "port"), "type"), nefor.graph.transformed_type(get(input, "type"), get(leaf, "steps"))))) : fn(nefor.graph.BoundaryLeaf) -> Bool), input_leaves)
  let output_transformations = filter(((|leaf| => not(descriptor_accepts(get(output, "type"), nefor.graph.transformed_type(get(get(leaf, "port"), "type"), get(leaf, "steps"))))) : fn(nefor.graph.BoundaryLeaf) -> Bool), output_leaves)
  let anonymous_output_transformations = filter(((|flow| => not(descriptor_accepts(get(output, "type"), nefor.graph.transformed_type(get(input, "type"), get(flow, "steps"))))) : fn(nefor.graph.Flow) -> Bool), get(output, "through"))
  let bad_inputs = filter(((|actor| => {
    let port = get(actor, "input")
    let incoming_routes = map(((|route| => nefor.graph.transformed_type(get(get(route, "from"), "type"), get(route, "transforms"))) : fn(nefor.graph.StoredRoute) -> TypeDescriptor), filter(((|route| => nefor.graph.same_port_address(get(route, "to"), port)) : fn(nefor.graph.StoredRoute) -> Bool), get(worker, "routes")))
    let boundary_sources = map(((|leaf| => nefor.graph.transformed_type(get(input, "type"), get(leaf, "steps"))) : fn(nefor.graph.BoundaryLeaf) -> TypeDescriptor), filter(((|leaf| => nefor.graph.same_port_address(get(leaf, "port"), port)) : fn(nefor.graph.BoundaryLeaf) -> Bool), input_leaves))
    not(descriptor_input_covered_by(get(port, "type"), concat(boundary_sources, incoming_routes)))
  }) : fn(nefor.graph.Actor) -> Bool), actors)
  let bad_outputs = filter(((|actor| => not(nefor.graph.actor_outputs_coverage_valid(analysis, get(analysis, "graph_operations_by_output"), actor))) : fn(nefor.graph.Actor) -> Bool), actors)
  let malformed_ports = filter(((|actor| => {
    let ports = concat([get(actor, "input")], get(actor, "outputs"))
    not((=)(count(filter(((|port| => if not(nefor.graph.endpoint_is_actor(get(port, "endpoint"))) then true else if not((=)(nefor.graph.endpoint_id(get(port, "endpoint")), get(actor, "id"))) then true else not(nefor.graph.serialized_equal(get(port, "type_id"), type_id(get(port, "type"))))) : fn(nefor.graph.StoredPort) -> Bool), ports)), 0))
  }) : fn(nefor.graph.Actor) -> Bool), actors)
  let bad_routes = filter(((|route| => if not(nefor.graph.contains_string(endpoint_ids, canonical(get(get(route, "from"), "endpoint")))) then true else if not(nefor.graph.contains_string(endpoint_ids, canonical(get(get(route, "to"), "endpoint")))) then true else not(descriptor_accepts(get(get(route, "to"), "type"), nefor.graph.transformed_type(get(get(route, "from"), "type"), get(route, "transforms")))) ) : fn(nefor.graph.StoredRoute) -> Bool), get(worker, "routes"))
  if not((=)(count(identity_conflicts), 0)) then fail(map(((|error| => str("traverse: ", error)) : fn(String) -> String), identity_conflicts)) else if not((=)(count(get(worker, "operations")), 0)) then fail(["traverse: nested worker operations are unsupported"]) else if not((=)(count(get(worker, "messages")), 0)) then fail(["traverse: authored worker messages/extra activations are unsupported"]) else if descriptor_streaming(get(input, "type")) then fail(["traverse: streaming worker input is unsupported"]) else if descriptor_streaming(get(output, "type")) then fail(["traverse: streaming worker output is unsupported"]) else if not((=)(count(checked_actor_refs), count(actors))) then fail(["traverse: actor contracts are incomplete"]) else if not(nefor.graph.actor_ids_valid(analysis)) then fail(["traverse: duplicate actor IDs"]) else if not(nefor.graph.logical_paths_valid(topology)) then fail(["traverse: malformed logical hierarchy"]) else if not(nefor.graph.logical_members_valid(topology)) then fail(["traverse: malformed logical member references"]) else if not((=)(count(malformed_ports), 0)) then fail(["traverse: malformed actor port evidence or ownership"]) else if not((=)(count(input_transformations), 0)) then fail(["traverse: invalid worker input boundary transformation"]) else if not((=)(count(output_transformations), 0)) then fail(["traverse: invalid worker output boundary transformation"]) else if not((=)(count(anonymous_output_transformations), 0)) then fail(["traverse: invalid anonymous worker output transformation"]) else if not((=)(count(bad_inputs), 0)) then fail([str("traverse: invalid worker input coverage: ", canonical(nefor.graph.actor_ids(bad_inputs)))]) else if not((=)(count(bad_outputs), 0)) then fail(["traverse: invalid worker output coverage"]) else if not((=)(count(bad_routes), 0)) then fail(["traverse: invalid internal routes"]) else if (=)(count(actors), 0) then if actor_free_boundary then worker else fail(["traverse: actor-free workers need anonymous input and output flow"]) else if not(nefor.graph.all_strings_in(endpoint_ids, worker_reachable(input_starts, get(worker, "routes"), false))) then fail(["traverse: every actor must be reachable from the worker input"]) else if not(nefor.graph.all_strings_in(endpoint_ids, worker_reachable(output_ends, get(worker, "routes"), true))) then fail(["traverse: every actor must reach the worker output"]) else worker
}

let template_stored_port: fn(nefor.graph.StoredPort) -> nefor.mag.TemplatePort = |port| => nefor.mag.TemplatePort {endpoint: local_actor_ref(nefor.graph.endpoint_id(get(port, "endpoint"))), `type`: get(port, "type"), type_id: get(port, "type_id"), wire: get(port, "wire")}

// Length delimiters protect arbitrary authored ids; collection:index is an
// injective pair because index is a nonnegative decimal integer at the end.
let occurrence_actor_id: fn(String, String, ValueRef<String>, ValueRef<String>) -> ValueRef<String> = |traversal, actor, collection, index| => concat_strings_ref([capture_ref(str("traverse:", count(traversal), ":", traversal, count(actor), ":", actor)), collection, capture_ref(":"), index])

let worker_template_actor: fn(nefor.graph.Actor, ValueRef<String>) -> nefor.mag.TemplateActor = |actor, id| => nefor.mag.TemplateActor {slot: get(actor, "id"), id: get(id, "id"), factory: get(actor, "factory"), type_arguments: get(actor, "type_arguments"), params: get(actor, "params"), input: template_stored_port(get(actor, "input")), outputs: map(template_stored_port, get(actor, "outputs")), parameter_bindings: []}

let worker_template_route: fn(nefor.graph.StoredRoute) -> nefor.mag.TemplateRoute = |route| => nefor.mag.TemplateRoute {from: template_stored_port(get(route, "from")), to: template_stored_port(get(route, "to")), transforms: get(route, "transforms")}

let output_template_route: fn(nefor.graph.BoundaryLeaf, nefor.mag.TemplatePort) -> nefor.mag.TemplateRoute = |leaf, target| => nefor.mag.TemplateRoute {from: template_stored_port(get(leaf, "port")), to: target, transforms: get(leaf, "steps")}

let input_template_message<I>: fn(nefor.graph.BoundaryLeaf, ValueRef<I>) -> nefor.mag.TemplateMessage = |leaf, item| => {
  let port = get(leaf, "port")
  nefor.mag.TemplateMessage {to: template_stored_port(port), transforms: get(leaf, "steps"), semantic_type: type_evidence(get(item, "type")), semantic_type_id: type_id(type_evidence(get(item, "type"))), content: named(nefor.mag.TemplatePayload, Expression, get(item, "id"))}
}

let traverse<I, O>: fn(String, nefor.graph.Node<I, O>) -> nefor.graph.Node<DynamicList<I>, DynamicList<O>> = |id, value| => {
  let worker = checked_worker(value)
  let input_id = str(id, ".input")
  let output_id = str(id, ".output")
  let input = nefor.graph.port(input_id, type_tag<DynamicList<I>>(), "nefor.dynamic.Input")
  let indexed = nefor.graph.port(input_id, type_tag<Indexed<I>>(), "nefor.dynamic.Indexed")
  let completed = nefor.graph.port(input_id, type_tag<DynamicCount>(), "nefor.dynamic.Complete")
  let collect = nefor.graph.port(output_id, type_tag<DynamicEvent<O>>(), "nefor.dynamic.Collect")
  let output = nefor.graph.port(output_id, type_tag<DynamicList<O>>(), "nefor.dynamic.Output")
  let input_actor = nefor.graph.actor(input_id, dynamic_each_factory, [type_evidence(type_tag<I>())], DynamicParams {}, nefor.graph.store_port(input), [nefor.graph.store_port(indexed), nefor.graph.store_port(completed)])
  let output_actor = nefor.graph.actor(output_id, dynamic_output_factory, [type_evidence(type_tag<O>()), type_evidence(type_tag<DynamicEvent<O>>())], DynamicParams {}, nefor.graph.store_port(collect), [nefor.graph.store_port(output)])
  let trigger = trigger_ref(type_tag<Indexed<I>>())
  let collection = field_ref(trigger, "collection", type_tag<String>())
  let index = field_ref(trigger, "index", type_tag<Int>())
  let item = field_ref(trigger, "value", type_tag<I>())
  let index_text = int_to_decimal_string_ref(index)
  let worker_actors = get(worker, "actors")
  let worker_input = nefor.graph.store_boundary(get(worker, "input"))
  let worker_output = nefor.graph.store_boundary(get(worker, "output"))
  let result_slot = worker_check_id(nefor.graph.actor_ids(worker_actors), "traverse.result")
  let result_id = occurrence_actor_id(id, result_slot, collection, index_text)
  let actor_ids = map(((|actor| => occurrence_actor_id(id, get(actor, "id"), collection, index_text)) : fn(nefor.graph.Actor) -> ValueRef<String>), worker_actors)
  let template_actors = map(((|actor| => worker_template_actor(actor, occurrence_actor_id(id, get(actor, "id"), collection, index_text))) : fn(nefor.graph.Actor) -> nefor.mag.TemplateActor), worker_actors)
  let result_input = template_port(local_actor_ref(result_slot), type_tag<O>(), "nefor.dynamic.IndexInput")
  let result_output = template_port(local_actor_ref(result_slot), type_tag<DynamicEvent<O>>(), "nefor.dynamic.Event")
  let result_actor = nefor.mag.TemplateActor {slot: result_slot, id: get(result_id, "id"), factory: dynamic_index_factory, type_arguments: [type_evidence(type_tag<O>()), type_evidence(type_tag<DynamicEvent<O>>())], params: pack(DynamicIndexParams {collection: "", index: 0}), input: result_input, outputs: [result_output], parameter_bindings: [nefor.mag.ScalarParameterBinding {path: ["collection"], value: get(collection, "id")}, nefor.mag.ScalarParameterBinding {path: ["index"], value: get(index, "id")}]}
  let worker_routes = map(worker_template_route, get(worker, "routes"))
  let result_routes = map(((|leaf| => output_template_route(leaf, result_input)) : fn(nefor.graph.BoundaryLeaf) -> nefor.mag.TemplateRoute), get(worker_output, "leaves"))
  let collect_route = nefor.mag.TemplateRoute {from: result_output, to: nefor.mag.TemplatePort {endpoint: existing_actor_ref(output_id), `type`: type_evidence(type_tag<DynamicEvent<O>>()), type_id: type_id(type_evidence(type_tag<DynamicEvent<O>>())), wire: "nefor.dynamic.Collect"}, transforms: []}
  let occurrence_segment = concat_strings_ref([collection, capture_ref(":"), index_text])
  let occurrence_path = [named(nefor.mag.PathSegment, TriggerPathSegment, nefor.mag.TriggerPathSegment {}), bound_segment(occurrence_segment)]
  let nodes = concat([nefor.mag.TemplateLogicalNode {path: occurrence_path, members: [nefor.mag.LocalActorRef {slot: result_slot}]}], map(((|node| => nefor.mag.TemplateLogicalNode {path: concat(occurrence_path, map(fixed_segment, get(node, "path"))), members: map(((|member| => nefor.mag.LocalActorRef {slot: member}) : fn(String) -> nefor.mag.LocalActorRef), get(node, "members"))}) : fn(nefor.graph.LogicalNode) -> nefor.mag.TemplateLogicalNode), get(worker, "nodes")))
  let relocations = flat_map(((|actor| => map(((|relocation| => nefor.mag.ActorReferenceRelocation {actor: nefor.mag.LocalActorRef {slot: get(actor, "id")}, path: get(relocation, "path"), shape: get(relocation, "shape")}) : fn(nefor.graph.Relocation) -> nefor.mag.ActorReferenceRelocation), checked_relocations(nefor.graph.actor_ids(worker_actors), actor))) : fn(nefor.graph.Actor) -> List<nefor.mag.ActorReferenceRelocation>), worker_actors)
  let input_messages = map(((|leaf| => input_template_message<I>(leaf, item)) : fn(nefor.graph.BoundaryLeaf) -> nefor.mag.TemplateMessage), get(worker_input, "leaves"))
  let anonymous_messages = map(((|flow| => nefor.mag.TemplateMessage {to: result_input, transforms: get(flow, "steps"), semantic_type: type_evidence(type_tag<I>()), semantic_type_id: type_id(type_evidence(type_tag<I>())), content: named(nefor.mag.TemplatePayload, Expression, get(item, "id"))}) : fn(nefor.graph.Flow) -> nefor.mag.TemplateMessage), get(worker_output, "through"))
  let template = nefor.mag.DeltaTemplate {types: descriptor_table(concat(nefor.graph.actor_descriptors(worker_actors), [type_evidence(type_tag<I>()), type_evidence(type_tag<O>()), type_evidence(type_tag<DynamicEvent<O>>())])), actors: concat(template_actors, [result_actor]), routes: concat(worker_routes, concat(result_routes, [collect_route])), messages: concat(input_messages, anonymous_messages), nodes: nodes, actor_reference_relocations: relocations}
  let refs = concat(actor_ids, [result_id, collection, index_text, occurrence_segment])
  let captures = merge_captures(concat(map(((|ref| => get(ref, "captures")) : fn(ValueRef<String>) -> Map<String, nefor.mag.TypedCapture>), refs), [get(item, "captures")]))
  let expressions = merge_expressions(concat(map(((|ref| => get(ref, "expressions")) : fn(ValueRef<String>) -> List<nefor.mag.Expression>), refs), [get(item, "expressions")]))
  let operation = nefor.graph.instantiate_delta_template(str(id, ".expand"), indexed, captures, expressions, template)
  let completion = nefor.graph.transformed_route(nefor.graph.store_port(completed), nefor.graph.store_port(collect), [named(nefor.graph.Transform, Pack, nefor.graph.AdtTransform {owner: type_evidence(type_tag<DynamicEvent<O>>()), payload: type_evidence(type_tag<DynamicCount>()), constructor: "Complete"})])
  nefor.graph.node_with_operations_and_nodes(id, "ordinary", [input_actor, output_actor], [completion], [], [operation], [nefor.graph.logical_node([id], [input_id, output_id])], input, output)
}
