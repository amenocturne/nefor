import core.types.{}

import nefor.graph.{}
import nefor.node.{}

let lift_anonymous<I, E, O>: fn(String, nefor.graph.Node<I, O>) -> nefor.graph.Node<I, core.types.Result<E, O>> = |id, value| => nefor.node.compose(id, value, nefor.node.pack_adt<O, core.types.Result<E, O>>(id, "Ok"))
let lift<I, E, O>: fn(String, nefor.graph.Node<I, O>) -> nefor.graph.Node<I, core.types.Result<E, O>> = |id, value| => nefor.node.named(id, lift_anonymous<I, E, O>(id, value))

// Result routing is an anonymous ADT transformation. Only the selected branch
// receives an activation; both already-packed outcomes share one boundary.
let branch_result<E, A, F, B>: fn(String, nefor.graph.Node<E, core.types.Result<F, B>>, nefor.graph.Node<A, core.types.Result<F, B>>) -> nefor.graph.Node<core.types.Result<E, A>, core.types.Result<F, B>> = |id, error_path, ok_path| => nefor.node.branch_adt<core.types.Result<E, A>, core.types.Result<F, B>, E, A>(id, "Error", "Ok", error_path, ok_path)

let and_then_anonymous<I, E, A, B>: fn(String, nefor.graph.Node<I, core.types.Result<E, A>>, nefor.graph.Node<A, core.types.Result<E, B>>) -> nefor.graph.Node<I, core.types.Result<E, B>> = |id, left, right| => {
  let preserve_error = nefor.node.pack_adt<E, core.types.Result<E, B>>(id, "Error")
  let branch = branch_result<E, A, E, B>(id, preserve_error, right)
  nefor.node.compose(id, left, branch)
}
let and_then<I, E, A, B>: fn(String, nefor.graph.Node<I, core.types.Result<E, A>>, nefor.graph.Node<A, core.types.Result<E, B>>) -> nefor.graph.Node<I, core.types.Result<E, B>> = |id, left, right| => nefor.node.named(id, and_then_anonymous(id, left, right))
let map_anonymous<I, E, A, B>: fn(String, nefor.graph.Node<I, core.types.Result<E, A>>, nefor.graph.Node<A, B>) -> nefor.graph.Node<I, core.types.Result<E, B>> = |id, result_node, value_node| => and_then_anonymous(id, result_node, lift_anonymous<A, E, B>(id, value_node))
let map_named<I, E, A, B>: fn(String, nefor.graph.Node<I, core.types.Result<E, A>>, nefor.graph.Node<A, B>) -> nefor.graph.Node<I, core.types.Result<E, B>> = |id, result_node, value_node| => nefor.node.named(id, map_anonymous(id, result_node, value_node))
let map<I, E, A, B>: fn(nefor.graph.Node<I, core.types.Result<E, A>>, nefor.graph.Node<A, B>) -> nefor.graph.Node<I, core.types.Result<E, B>> = |result_node, value_node| => map_anonymous(get(result_node, "id"), result_node, value_node)

let map_error_anonymous<I, E, F, A>: fn(String, nefor.graph.Node<I, core.types.Result<E, A>>, nefor.graph.Node<E, F>) -> nefor.graph.Node<I, core.types.Result<F, A>> = |id, result_node, error_node| => {
  let mapped_error = nefor.node.compose(id, error_node, nefor.node.pack_adt<F, core.types.Result<F, A>>(id, "Error"))
  let preserve_ok = nefor.node.pack_adt<A, core.types.Result<F, A>>(id, "Ok")
  let branch = branch_result<E, A, F, A>(id, mapped_error, preserve_ok)
  nefor.node.compose(id, result_node, branch)
}
let map_error_named<I, E, F, A>: fn(String, nefor.graph.Node<I, core.types.Result<E, A>>, nefor.graph.Node<E, F>) -> nefor.graph.Node<I, core.types.Result<F, A>> = |id, result_node, error_node| => nefor.node.named(id, map_error_anonymous(id, result_node, error_node))
let map_error<I, E, F, A>: fn(nefor.graph.Node<I, core.types.Result<E, A>>, nefor.graph.Node<E, F>) -> nefor.graph.Node<I, core.types.Result<F, A>> = |result_node, error_node| => map_error_anonymous(get(result_node, "id"), result_node, error_node)
let `>=>`<I, E, A, B>: fn(nefor.graph.Node<I, core.types.Result<E, A>>, nefor.graph.Node<A, core.types.Result<E, B>>) -> nefor.graph.Node<I, core.types.Result<E, B>> = |left, right| => and_then_anonymous(get(left, "id"), left, right)
