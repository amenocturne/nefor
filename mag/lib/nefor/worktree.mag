// Git worktrees as workflow steps. A worktree made by a workflow is never
// removed by it.
import nefor.capability.{}

import nefor.graph.{}

// A new worktree: at path, on the new branch, starting from base, in the
// repository at the given directory.
type CreateSpec {repository: String, path: String, branch: String, base: String}

// A worktree that already exists at path and has branch checked out.
type OpenSpec {repository: String, path: String, branch: String}

// A ready worktree; head is the commit it is on.
type Worktree {repository: String, path: String, branch: String, head: String}

type WorktreeError {operation: String, kind: String, message: String}

// A node that creates the worktree. It fails when the path or the branch
// already exists.
let create: fn(String, CreateSpec) -> nefor.graph.Node<Unit, Worktree> = |id, spec| =>
  nefor.capability.worktree_create<CreateSpec, Worktree>(id, spec)

// A node that checks that the worktree exists as described and reuses it.
let open: fn(String, OpenSpec) -> nefor.graph.Node<Unit, Worktree> = |id, spec| =>
  nefor.capability.worktree_open<OpenSpec, Worktree>(id, spec)
