// Running a POSIX shell script as a workflow step.
import nefor.capability.{}

import nefor.contracts.{}

import nefor.graph.{}

// The script text, the directory it runs in, and how long it may run.
type ShellScriptParams {script: String, cwd: String, timeout: nefor.contracts.Timeout}

// A node that runs the script when the workflow reaches it and produces what
// the script printed and how it ended. id names the node in the run.
let script: fn(String, ShellScriptParams) -> nefor.graph.Node<Unit, nefor.contracts.ProcessResult> = |id, params| =>
  nefor.capability.shell_script<nefor.contracts.ProcessResult>(id, get(params, "script"), get(params, "cwd"), get(params, "timeout"))
