import core.map.{}

import core.set.{}

import core.validated.{}

import nefor.contracts.{}

import nefor.mag.{}

// A graph is an immutable edge set. The list is a deterministic storage
// detail: graph/add-edges/remove-edges normalize it to set semantics.
type ActorEndpoint = nefor.mag.ActorEndpoint
type Endpoint = nefor.mag.Endpoint
type StoredPort = nefor.mag.StoredPort
// Boundaries are flattened compile-time values, not endpoint identities.
// Input leaves map the boundary value into concrete actor inputs. Output leaves
// map concrete actor outputs into the boundary value; through paths consume the
// enclosing node input directly and disappear when that node is composed.
type Projection = nefor.mag.Projection
type AdtTransform = nefor.mag.AdtTransform
type Assembly = nefor.mag.Assembly
type Transform = nefor.mag.Transform
type Flow {steps: List<Transform>}
type BoundaryLeaf {port: StoredPort, steps: List<Transform>}
type StoredBoundary {`type`: TypeDescriptor, type_id: SemanticTypeId, leaves: List<BoundaryLeaf>, through: List<Flow>}
type Port<T> {`type`: TypeTag<T>, boundary: StoredBoundary}
type Relocation {path: List<String>, shape: String}
type Templateability = Unsupported(String) | Closed(List<Relocation>)
type Actor {templateability: Templateability, id: String, factory: String, type_arguments: List<TypeDescriptor>, params: PackedValue, input: StoredPort, outputs: List<StoredPort>}
type StoredRoute {id: String, from: StoredPort, to: StoredPort, transforms: List<Transform>}
type Message {to: StoredPort, transforms: List<Transform>, semantic_type: TypeDescriptor, semantic_type_id: SemanticTypeId, content: PackedValue}
type LogicalNode {path: List<String>, members: List<String>}
type ActorLogicalPath {actor: String, path: List<String>}
type CompositionPosition {node: String, position: Int}
type DefinitionField {field: String, value: String}
type DefinitionProvenance {containing_node: String, logical_paths: List<List<String>>, composition_path: List<CompositionPosition>, node_occurrence: Int, entity_occurrence: Int}
type DefinitionOccurrence {kind: String, identity: String, fields: List<DefinitionField>, provenance: DefinitionProvenance}
type ExecutionDefinition {role: String, actors: List<Actor>, routes: List<StoredRoute>, messages: List<Message>, operations: List<nefor.mag.ProgramOperation>, input: StoredBoundary, output: StoredBoundary}
type ExecutionOccurrence {identity: String, definition: ExecutionDefinition, provenance: DefinitionProvenance}
type StoredNode {id: String, role: String, actors: List<Actor>, routes: List<StoredRoute>, messages: List<Message>, operations: List<nefor.mag.ProgramOperation>, nodes: List<LogicalNode>, occurrences: List<DefinitionOccurrence>, executions: List<ExecutionOccurrence>, input: StoredBoundary, output: StoredBoundary}
type Node<I, O> {id: String, role: String, actors: List<Actor>, routes: List<StoredRoute>, messages: List<Message>, operations: List<nefor.mag.ProgramOperation>, nodes: List<LogicalNode>, occurrences: List<DefinitionOccurrence>, executions: List<ExecutionOccurrence>, input: Port<I>, output: Port<O>}
type Edge {from: StoredNode, to: StoredNode, routes: List<StoredRoute>}
type Graph {edges: List<Edge>}
type GraphAnalysis {edges: List<Edge>, all_nodes: List<StoredNode>, nodes: List<StoredNode>, nodes_by_id: Map<String, List<StoredNode>>, actors: List<Actor>, actors_by_id: Map<String, List<Actor>>, input_ports_by_address: Map<String, List<StoredPort>>, output_ports_by_address: Map<String, List<StoredPort>>, routes: List<StoredRoute>, route_input_addresses: List<String>, diagnostic_routes_by_input: Map<String, List<StoredRoute>>, routes_by_input: Map<String, List<StoredRoute>>, routes_by_output: Map<String, List<StoredRoute>>, routes_by_source_actor: Map<String, List<StoredRoute>>, messages: List<Message>, messages_by_input: Map<String, List<Message>>, graph_operations: List<nefor.mag.ProgramOperation>, graph_operations_by_output: Map<String, List<nefor.mag.ProgramOperation>>, edges_by_from_node: Map<String, List<Edge>>, edges_by_to_node: Map<String, List<Edge>>, roots: List<StoredNode>, outputs: List<StoredNode>, terminal_outputs_by_full_port: Map<String, List<StoredNode>>, identity_conflicts: List<String>}
type GraphProjection {edges: List<Edge>, all_nodes: List<StoredNode>, nodes: List<StoredNode>, actors: List<Actor>, routes: List<StoredRoute>, messages: List<Message>, graph_operations: List<nefor.mag.ProgramOperation>, logical_nodes: List<LogicalNode>, edges_by_from_node: Map<String, List<Edge>>, edges_by_to_node: Map<String, List<Edge>>, roots: List<StoredNode>, outputs: List<StoredNode>, identity_conflicts: List<String>}
type LoweringAnalysis {actors: List<Actor>, routes: List<StoredRoute>, route_input_addresses: List<String>, routes_by_input: Map<String, List<StoredRoute>>, messages: List<Message>, operations: List<nefor.mag.ProgramOperation>, logical_nodes: List<LogicalNode>, outputs: List<StoredNode>}
type OrderedStrings {seen: Set<String>, values: List<String>}
type OrderedDefinitions<T> {seen: Set<String>, values: List<T>}
type FieldDifference {field: String, first_value: String, conflicting_value: String}
type ConflictDescription {entity: String, identity: String, differences: List<FieldDifference>, first_definition: String, first_provenance: DefinitionProvenance, conflicting_definition: String, conflicting_provenance: DefinitionProvenance}
type NodeOccurrence {value: StoredNode, occurrence: Int}
type ActorOccurrence {value: Actor, provenance: DefinitionProvenance}
type RouteOccurrence {value: StoredRoute, provenance: DefinitionProvenance}
type OperationOccurrence {value: nefor.mag.ProgramOperation, provenance: DefinitionProvenance}
type LogicalNodeOccurrence {value: LogicalNode, provenance: DefinitionProvenance}
type ReachabilityState {visited: Set<String>, frontier: List<String>}
type FactoryTypeScheme {input_tags: List<String>, outputs: List<String>}
type FactoryContract {identity: String, type_scheme: FactoryTypeScheme}
type SourceParams<T> {value: T, value_type: SemanticTypeId}
type LowerRoute {id: String, from: StoredPort, to: StoredPort, transforms: List<Transform>}
type LowerActor {id: String, factory: String, type_arguments: List<TypeDescriptor>, input: StoredPort, outputs: List<StoredPort>, params: PackedValue}
type LowerMessage {to: StoredPort, transforms: List<Transform>, semantic_type: TypeDescriptor, semantic_type_id: SemanticTypeId, content: PackedValue}
type ResultBoundary {from: StoredBoundary}
type RouteIdentity {from: StoredPort, to: StoredPort, transforms: List<Transform>}
type MessageContent<T> {kind: String, value: T}
type EdgeIdentity {from_node: String, to_node: String, routes: List<StoredRoute>}
type PortAddressIdentity {endpoint: Endpoint, wire: String}
type RouteSourceDescription {kind: String, from: String, `type`: TypeDescriptor}
type RouteHandlerDescription {kind: String, to: String, `type`: TypeDescriptor}
type OperationDescription {kind: String, id: String, `type`: TypeDescriptor}
type OutputCoverageDescription {actor: String, output: String, output_type: TypeDescriptor, available_handlers: List<String>, reason: String}
type InputCoverageDescription {actor: String, input: String, expected_type: TypeDescriptor, incoming_sources: List<String>, reason: String}
type RootValidationDescription {node: String, input: String, input_type: TypeDescriptor, reason: String}
type Modification {actors: List<LowerActor>, routes: List<LowerRoute>, messages: List<LowerMessage>, kills: List<String>, types: Map<String, TypeDescriptor>, nodes: List<LogicalNode>, result: ResultBoundary}
// Delta artifacts are an operation format over the running actor kernel.
type Delta {actors: List<Actor>, routes: List<StoredRoute>, messages: List<Message>, nodes: List<LogicalNode>, kills: List<String>}
type LowerDelta {actors: List<LowerActor>, routes: List<LowerRoute>, messages: List<LowerMessage>, kills: List<String>, types: Map<String, TypeDescriptor>, nodes: List<LogicalNode>}

let actor_endpoint: fn(String) -> Endpoint = |id| => named(nefor.mag.Endpoint, ActorEndpoint, nefor.mag.ActorEndpoint {id: id})
let endpoint_id: fn(Endpoint) -> String = |endpoint| => match endpoint { case ActorEndpoint(value) => get(value, "id") }
let endpoint_is_actor: fn(Endpoint) -> Bool = |endpoint| => match endpoint { case ActorEndpoint(value) => true }
let boundary<T>: fn(TypeTag<T>, List<BoundaryLeaf>, List<Flow>) -> Port<T> = |tag, leaves, through| => Port<T> {`type`: tag, boundary: StoredBoundary {`type`: type_evidence(tag), type_id: type_id(type_evidence(tag)), leaves: leaves, through: through}}
let port<T>: fn(String, TypeTag<T>, String) -> Port<T> = |actor, semantic_type, wire_type| => {
  let descriptor = type_evidence(semantic_type)
  let concrete = nefor.mag.StoredPort {endpoint: actor_endpoint(actor), `type`: descriptor, type_id: type_id(descriptor), wire: wire_type}
  boundary(semantic_type, [BoundaryLeaf {port: concrete, steps: []}], [])
}
let store_boundary<T>: fn(Port<T>) -> StoredBoundary = |value| => get(value, "boundary")
let store_port<T>: fn(Port<T>) -> StoredPort = |value| => {
  let value_boundary = store_boundary(value)
  let leaves = get(value_boundary, "leaves")
  if (=)(count(get(value_boundary, "through")), 0) then if (=)(count(leaves), 1) then if (=)(count(get(first(leaves), "steps")), 0) then get(first(leaves), "port") else fail(["expected an untransformed concrete actor port"]) else fail(["expected exactly one concrete actor port"]) else fail(["transparent boundaries are not concrete actor ports"])
}
let transparent_port<T>: fn() -> Port<T> = | | => boundary(type_tag<T>(), [], [Flow {steps: []}])
let pass_node<T>: fn(String, String) -> Node<T, T> = |id, role| => node_with_operations_and_nodes(id, role, [], [], [], [], [], transparent_port<T>(), transparent_port<T>())

let actor<P>: fn(String, String, List<TypeDescriptor>, P, StoredPort, List<StoredPort>) -> Actor = |id, factory, type_arguments, params, input, outputs| => Actor {templateability: Templateability.Unsupported("arbitrary actor constructor has no closed single-result contract"), id: id, factory: factory, type_arguments: type_arguments, params: pack(params), input: input, outputs: outputs}

// Only audited constructors may assert a closed per-occurrence contract.
let closed_actor<P>: fn(String, String, List<TypeDescriptor>, P, StoredPort, List<StoredPort>, List<Relocation>) -> Actor = |id, factory, type_arguments, params, input, outputs, relocations| => Actor {templateability: Templateability.Closed(relocations), id: id, factory: factory, type_arguments: type_arguments, params: pack(params), input: input, outputs: outputs}

let actor_ids: fn(List<Actor>) -> List<String> = |actors| => map(((|candidate| => get(candidate, "id")) : fn(Actor) -> String), actors)

let logical_node: fn(List<String>, List<String>) -> LogicalNode = |path, actors| => LogicalNode {path: path, members: ordered_strings(actors)}

let prefix_logical_node: fn(String, LogicalNode) -> LogicalNode = |name, value| => logical_node(concat([name], get(value, "path")), get(value, "members"))

let prefix_logical_nodes: fn(String, List<LogicalNode>) -> List<LogicalNode> = |name, values| => map(((|value| => prefix_logical_node(name, value)) : fn(LogicalNode) -> LogicalNode), values)

let attach_logical_members: fn(List<LogicalNode>, List<String>) -> List<LogicalNode> = |values, members| => if (=)(count(values), 0) then [] else concat([logical_node(get(first(values), "path"), concat(get(first(values), "members"), members))], remove_at(values, 0))

let serialized_equal<T>: fn(T, T) -> Bool = |left, right| => (=)(canonical(left), canonical(right))

let insert_definition<T>: fn(OrderedDefinitions<T>, T) -> OrderedDefinitions<T> = |state, candidate| => {
  let key = canonical(candidate)
  if core.set.contains(get(state, "seen"), key) then state else OrderedDefinitions<T> {seen: core.set.insert(get(state, "seen"), key), values: concat(get(state, "values"), [candidate])}
}

let unique_definitions<T>: fn(List<T>) -> List<T> = |values| => get(fold(insert_definition, OrderedDefinitions<T> {seen: core.set.empty<String>(), values: ([]: List<T>)}, values), "values")

let insert_canonical_definition<T>: fn(Set<String>, T) -> Set<String> = |values, candidate| => core.set.insert(values, canonical(candidate))

let canonical_definition_set<T>: fn(List<T>) -> String = |values| => canonical(fold(insert_canonical_definition, core.set.empty<String>(), values))

let definition_field: fn(String, String) -> DefinitionField = |field, value| => DefinitionField {field: field, value: value}

let occurrence_provenance_for: fn(String, List<List<String>>, Int) -> DefinitionProvenance = |node, paths, entity_occurrence| => DefinitionProvenance {containing_node: node, logical_paths: paths, composition_path: [], node_occurrence: 0, entity_occurrence: entity_occurrence}

let logical_path_index: fn(List<LogicalNode>) -> Map<String, List<ActorLogicalPath>> = |nodes| => group_by(((|entry| => get(entry, "actor")) : fn(ActorLogicalPath) -> String), flat_map(((|node| => map(((|actor| => ActorLogicalPath {actor: actor, path: get(node, "path")}) : fn(String) -> ActorLogicalPath), get(node, "members"))) : fn(LogicalNode) -> List<ActorLogicalPath>), nodes))

let occurrence_paths_for_actor: fn(List<LogicalNode>, String) -> List<List<String>> = |nodes, id| => map(((|entry| => get(entry, "path")) : fn(ActorLogicalPath) -> List<String>), __map_get_or(logical_path_index(nodes), id, ([]: List<ActorLogicalPath>)))

let actor_definition_fields: fn(Actor) -> List<DefinitionField> = |value| => [definition_field("templateability", canonical(get(value, "templateability"))), definition_field("factory", canonical(get(value, "factory"))), definition_field("type_arguments", canonical(get(value, "type_arguments"))), definition_field("params", canonical(get(value, "params"))), definition_field("input", canonical(get(value, "input"))), definition_field("outputs", canonical(get(value, "outputs")))]

let route_definition_fields: fn(StoredRoute) -> List<DefinitionField> = |value| => [definition_field("from", canonical(get(value, "from"))), definition_field("to", canonical(get(value, "to"))), definition_field("transforms", canonical(get(value, "transforms")))]

let operation_definition_fields: fn(nefor.mag.ProgramOperation) -> List<DefinitionField> = |value| => [definition_field("on", canonical(get(value, "on"))), definition_field("captures", canonical(get(value, "captures"))), definition_field("expressions", canonical(get(value, "expressions"))), definition_field("template", canonical(get(value, "template")))]
let endpoint_logical_paths: fn(List<LogicalNode>, Endpoint) -> List<List<String>> = |nodes, endpoint| => if endpoint_is_actor(endpoint) then occurrence_paths_for_actor(nodes, endpoint_id(endpoint)) else []
let route_logical_paths: fn(List<LogicalNode>, StoredRoute) -> List<List<String>> = |nodes, route| => unique_definitions(concat(endpoint_logical_paths(nodes, get(get(route, "from"), "endpoint")), endpoint_logical_paths(nodes, get(get(route, "to"), "endpoint"))))

let definition_occurrences: fn(String, String, List<Actor>, List<StoredRoute>, List<Message>, List<nefor.mag.ProgramOperation>, List<LogicalNode>, StoredBoundary, StoredBoundary) -> List<DefinitionOccurrence> = |id, role, actors, routes, messages, operations, nodes, input, output| => {
  let actor_occurrences = indexed_map(((|index, actor| => DefinitionOccurrence {kind: "actor", identity: get(actor, "id"), fields: actor_definition_fields(actor), provenance: occurrence_provenance_for(id, occurrence_paths_for_actor(nodes, get(actor, "id")), index)}) : fn(Int, Actor) -> DefinitionOccurrence), actors)
  let route_occurrences = indexed_map(((|index, route| => DefinitionOccurrence {kind: "route", identity: get(route, "id"), fields: route_definition_fields(route), provenance: occurrence_provenance_for(id, route_logical_paths(nodes, route), index)}) : fn(Int, StoredRoute) -> DefinitionOccurrence), routes)
  let operation_occurrences = indexed_map(((|index, operation| => DefinitionOccurrence {kind: "operation", identity: get(operation, "id"), fields: operation_definition_fields(operation), provenance: occurrence_provenance_for(id, endpoint_logical_paths(nodes, get(get(operation, "on"), "endpoint")), index)}) : fn(Int, nefor.mag.ProgramOperation) -> DefinitionOccurrence), operations)
  let logical_occurrences = indexed_map(((|index, logical| => DefinitionOccurrence {kind: "logical node", identity: canonical(get(logical, "path")), fields: [definition_field("members", canonical(get(logical, "members")))], provenance: occurrence_provenance_for(id, [get(logical, "path")], index)}) : fn(Int, LogicalNode) -> DefinitionOccurrence), nodes)
  concat(actor_occurrences, concat(route_occurrences, concat(operation_occurrences, logical_occurrences)))
}

let attach_logical_occurrences: fn(List<DefinitionOccurrence>, List<LogicalNode>, List<String>) -> List<DefinitionOccurrence> = |values, nodes, members| => if (=)(count(nodes), 0) then values else {
  let old = first(nodes)
  let identity = canonical(get(old, "path"))
  let old_fields = [definition_field("members", canonical(get(old, "members")))]
  let new_fields = [definition_field("members", canonical(ordered_strings(concat(get(old, "members"), members))))]
  map(((|candidate| => if (=)(get(candidate, "kind"), "logical node") then if (=)(get(candidate, "identity"), identity) then if serialized_equal(get(candidate, "fields"), old_fields) then assoc(candidate, "fields", new_fields) else candidate else candidate else candidate) : fn(DefinitionOccurrence) -> DefinitionOccurrence), values)
}

let execution_occurrence: fn(String, String, List<Actor>, List<StoredRoute>, List<Message>, List<nefor.mag.ProgramOperation>, List<LogicalNode>, StoredBoundary, StoredBoundary) -> ExecutionOccurrence = |id, role, actors, routes, messages, operations, nodes, input, output| => ExecutionOccurrence {identity: id, definition: ExecutionDefinition {role: role, actors: actors, routes: routes, messages: messages, operations: operations, input: input, output: output}, provenance: occurrence_provenance_for(id, map(((|logical| => get(logical, "path")) : fn(LogicalNode) -> List<String>), nodes), -1)}

let occurrence_key: fn(DefinitionOccurrence) -> String = |value| => canonical([get(value, "kind"), get(value, "identity"), canonical(get(value, "fields"))])

type OrderedOccurrences {seen: Set<String>, values: List<DefinitionOccurrence>}

let insert_occurrence: fn(OrderedOccurrences, DefinitionOccurrence) -> OrderedOccurrences = |state, candidate| => {
  let key = occurrence_key(candidate)
  if core.set.contains(get(state, "seen"), key) then state else OrderedOccurrences {seen: core.set.insert(get(state, "seen"), key), values: concat(get(state, "values"), [candidate])}
}

let unique_occurrences: fn(List<DefinitionOccurrence>) -> List<DefinitionOccurrence> = |values| => get(fold(insert_occurrence, OrderedOccurrences {seen: core.set.empty<String>(), values: []}, values), "values")

let with_occurrence_provenance: fn(DefinitionOccurrence, DefinitionProvenance) -> DefinitionOccurrence = |value, provenance| => DefinitionOccurrence {kind: get(value, "kind"), identity: get(value, "identity"), fields: get(value, "fields"), provenance: provenance}

let place_occurrence: fn(String, Int, DefinitionOccurrence) -> DefinitionOccurrence = |parent, position, value| => {
  let provenance = get(value, "provenance")
  with_occurrence_provenance(value, DefinitionProvenance {containing_node: get(provenance, "containing_node"), logical_paths: get(provenance, "logical_paths"), composition_path: concat([CompositionPosition {node: parent, position: position}], get(provenance, "composition_path")), node_occurrence: get(provenance, "node_occurrence"), entity_occurrence: get(provenance, "entity_occurrence")})
}

let place_occurrences: fn(String, Int, List<DefinitionOccurrence>) -> List<DefinitionOccurrence> = |parent, position, values| => map(((|value| => place_occurrence(parent, position, value)) : fn(DefinitionOccurrence) -> DefinitionOccurrence), values)

let prefix_occurrence_paths: fn(String, DefinitionOccurrence) -> DefinitionOccurrence = |name, value| => {
  let provenance = get(value, "provenance")
  let paths = map(((|path| => concat([name], path)) : fn(List<String>) -> List<String>), get(provenance, "logical_paths"))
  with_occurrence_provenance(if (=)(get(value, "kind"), "logical node") then assoc(value, "identity", canonical(first(paths))) else value, DefinitionProvenance {containing_node: get(provenance, "containing_node"), logical_paths: paths, composition_path: get(provenance, "composition_path"), node_occurrence: get(provenance, "node_occurrence"), entity_occurrence: get(provenance, "entity_occurrence")})
}

let prefix_occurrences: fn(String, List<DefinitionOccurrence>) -> List<DefinitionOccurrence> = |name, values| => map(((|value| => prefix_occurrence_paths(name, value)) : fn(DefinitionOccurrence) -> DefinitionOccurrence), values)

let rename_occurrence_paths: fn(String, DefinitionOccurrence) -> DefinitionOccurrence = |name, value| => {
  let provenance = get(value, "provenance")
  let paths = map(((|path| => concat([name], remove_at(path, 0))) : fn(List<String>) -> List<String>), get(provenance, "logical_paths"))
  with_occurrence_provenance(if (=)(get(value, "kind"), "logical node") then assoc(value, "identity", canonical(first(paths))) else value, DefinitionProvenance {containing_node: get(provenance, "containing_node"), logical_paths: paths, composition_path: get(provenance, "composition_path"), node_occurrence: get(provenance, "node_occurrence"), entity_occurrence: get(provenance, "entity_occurrence")})
}

let rename_occurrences: fn(String, List<DefinitionOccurrence>) -> List<DefinitionOccurrence> = |name, values| => map(((|value| => rename_occurrence_paths(name, value)) : fn(DefinitionOccurrence) -> DefinitionOccurrence), values)

let with_execution_provenance: fn(ExecutionOccurrence, DefinitionProvenance) -> ExecutionOccurrence = |value, provenance| => ExecutionOccurrence {identity: get(value, "identity"), definition: get(value, "definition"), provenance: provenance}

let place_execution: fn(String, Int, ExecutionOccurrence) -> ExecutionOccurrence = |parent, position, value| => {
  let provenance = get(value, "provenance")
  with_execution_provenance(value, DefinitionProvenance {containing_node: get(provenance, "containing_node"), logical_paths: get(provenance, "logical_paths"), composition_path: concat([CompositionPosition {node: parent, position: position}], get(provenance, "composition_path")), node_occurrence: get(provenance, "node_occurrence"), entity_occurrence: get(provenance, "entity_occurrence")})
}

let place_executions: fn(String, Int, List<ExecutionOccurrence>) -> List<ExecutionOccurrence> = |parent, position, values| => map(((|value| => place_execution(parent, position, value)) : fn(ExecutionOccurrence) -> ExecutionOccurrence), values)

let prefix_execution_paths: fn(String, ExecutionOccurrence) -> ExecutionOccurrence = |name, value| => {
  let provenance = get(value, "provenance")
  let paths = map(((|path| => concat([name], path)) : fn(List<String>) -> List<String>), get(provenance, "logical_paths"))
  with_execution_provenance(value, DefinitionProvenance {containing_node: get(provenance, "containing_node"), logical_paths: paths, composition_path: get(provenance, "composition_path"), node_occurrence: get(provenance, "node_occurrence"), entity_occurrence: get(provenance, "entity_occurrence")})
}

let prefix_executions: fn(String, List<ExecutionOccurrence>) -> List<ExecutionOccurrence> = |name, values| => map(((|value| => prefix_execution_paths(name, value)) : fn(ExecutionOccurrence) -> ExecutionOccurrence), values)

let rename_execution_paths: fn(String, ExecutionOccurrence) -> ExecutionOccurrence = |name, value| => {
  let provenance = get(value, "provenance")
  let paths = map(((|path| => concat([name], remove_at(path, 0))) : fn(List<String>) -> List<String>), get(provenance, "logical_paths"))
  with_execution_provenance(value, DefinitionProvenance {containing_node: get(provenance, "containing_node"), logical_paths: paths, composition_path: get(provenance, "composition_path"), node_occurrence: get(provenance, "node_occurrence"), entity_occurrence: get(provenance, "entity_occurrence")})
}

let rename_executions: fn(String, List<ExecutionOccurrence>) -> List<ExecutionOccurrence> = |name, values| => map(((|value| => rename_execution_paths(name, value)) : fn(ExecutionOccurrence) -> ExecutionOccurrence), values)

let node_with_occurrences_and_nodes<I, O>: fn(String, String, List<Actor>, List<StoredRoute>, List<Message>, List<nefor.mag.ProgramOperation>, List<LogicalNode>, List<DefinitionOccurrence>, List<ExecutionOccurrence>, Port<I>, Port<O>) -> Node<I, O> = |id, role, actors, routes, messages, operations, nodes, inherited, inherited_executions, input, output| => {
  let normalized_actors = unique_definitions(actors)
  let normalized_routes = unique_definitions(routes)
  let normalized_messages = unique_definitions(messages)
  let normalized_operations = unique_definitions(operations)
  let normalized_nodes = unique_definitions(nodes)
  let generated = definition_occurrences(id, role, normalized_actors, normalized_routes, normalized_messages, normalized_operations, normalized_nodes, store_boundary(input), store_boundary(output))
  let current_keys = group_by(occurrence_key, generated)
  let retained = filter(((|candidate| => core.map.contains_key(current_keys, occurrence_key(candidate))) : fn(DefinitionOccurrence) -> Bool), inherited)
  Node<I, O> {id: id, role: role, actors: normalized_actors, routes: normalized_routes, messages: normalized_messages, operations: normalized_operations, nodes: normalized_nodes, occurrences: unique_occurrences(concat(retained, generated)), executions: inherited_executions, input: input, output: output}
}
let node_with_operations_and_nodes<I, O>: fn(String, String, List<Actor>, List<StoredRoute>, List<Message>, List<nefor.mag.ProgramOperation>, List<LogicalNode>, Port<I>, Port<O>) -> Node<I, O> = |id, role, actors, routes, messages, operations, nodes, input, output| => node_with_occurrences_and_nodes(id, role, actors, routes, messages, operations, nodes, [], if (=)(count(actors), 0) then [] else [execution_occurrence(id, role, actors, routes, messages, operations, nodes, store_boundary(input), store_boundary(output))], input, output)
let node_execution_occurrences<I, O>: fn(Node<I, O>) -> List<ExecutionOccurrence> = |value| => get(value, "executions")
let node<I, O>: fn(String, String, List<Actor>, List<StoredRoute>, List<Message>, Port<I>, Port<O>) -> Node<I, O> = |id, role, actors, routes, messages, input, output| => node_with_operations_and_nodes(id, role, actors, routes, messages, [], [logical_node([id], actor_ids(actors))], input, output)
let node_with_operations<I, O>: fn(String, String, List<Actor>, List<StoredRoute>, List<Message>, List<nefor.mag.ProgramOperation>, Port<I>, Port<O>) -> Node<I, O> = |id, role, actors, routes, messages, operations, input, output| => node_with_operations_and_nodes(id, role, actors, routes, messages, operations, [logical_node([id], actor_ids(actors))], input, output)
let with_operation<I, O>: fn(Node<I, O>, nefor.mag.ProgramOperation) -> Node<I, O> = |value, subscription| => node_with_occurrences_and_nodes(get(value, "id"), get(value, "role"), get(value, "actors"), get(value, "routes"), get(value, "messages"), concat(get(value, "operations"), [subscription]), get(value, "nodes"), get(value, "occurrences"), get(value, "executions"), get(value, "input"), get(value, "output"))
let normalize_node<I, O>: fn(Node<I, O>) -> Node<I, O> = |value| => node_with_occurrences_and_nodes(get(value, "id"), get(value, "role"), get(value, "actors"), get(value, "routes"), get(value, "messages"), get(value, "operations"), get(value, "nodes"), get(value, "occurrences"), get(value, "executions"), get(value, "input"), get(value, "output"))
let store_node<I, O>: fn(Node<I, O>) -> StoredNode = |authored| => {
  let value = normalize_node(authored)
  StoredNode {id: get(value, "id"), role: get(value, "role"), actors: get(value, "actors"), routes: get(value, "routes"), messages: get(value, "messages"), operations: get(value, "operations"), nodes: get(value, "nodes"), occurrences: get(value, "occurrences"), executions: node_execution_occurrences(value), input: store_boundary(get(value, "input")), output: store_boundary(get(value, "output"))}
}
let transformed_route: fn(StoredPort, StoredPort, List<Transform>) -> StoredRoute = |from, to, transforms| => StoredRoute {id: canonical(RouteIdentity {from: from, to: to, transforms: normalize_transforms(transforms)}), from: from, to: to, transforms: normalize_transforms(transforms)}
let stored_route<A, B>: fn(Port<A>, Port<B>) -> StoredRoute = |from, to| => transformed_route(store_port(from), store_port(to), [])
let boundary_routes: fn(StoredBoundary, StoredBoundary) -> List<StoredRoute> = |from, to| => flat_map(((|source| => map(((|destination| => transformed_route(get(source, "port"), get(destination, "port"), concat(get(source, "steps"), get(destination, "steps")))) : fn(BoundaryLeaf) -> StoredRoute), get(to, "leaves"))) : fn(BoundaryLeaf) -> List<StoredRoute>), get(from, "leaves"))
let connect<A, B>: fn(Port<A>, Port<B>) -> List<StoredRoute> = |from, to| => boundary_routes(store_boundary(from), store_boundary(to))
let edge<I, T, U, O>: fn(Node<I, T>, Node<U, O>) -> Edge = |from, to| => Edge {from: store_node(from), to: store_node(to), routes: connect(get(from, "output"), get(to, "input"))}
let stored_message<P>: fn(StoredPort, P) -> Message = |to, content| => Message {to: to, transforms: [], semantic_type: get(to, "type"), semantic_type_id: get(to, "type_id"), content: pack(content)}
let message<T, P>: fn(Port<T>, P) -> Message = |to, content| => stored_message(store_port(to), content)
let typed_message<T>: fn(Port<T>, T) -> Message = |to, value| => {
  let stored = store_port(to)
  let selected = value_type_evidence(value, get(stored, "type"))
  Message {to: stored, transforms: [], semantic_type: selected, semantic_type_id: type_id(selected), content: pack(MessageContent<T> {kind: get(stored, "wire"), value: value})}
}
let instantiate_delta_template<T>: fn(String, Port<T>, Map<String, nefor.mag.TypedCapture>, List<nefor.mag.Expression>, nefor.mag.DeltaTemplate) -> nefor.mag.ProgramOperation = |id, on, captures, expressions, template| => nefor.mag.ProgramOperation {id: id, on: store_port(on), captures: captures, expressions: expressions, template: template}
let operation_port: fn(nefor.mag.ProgramOperation) -> StoredPort = |value| => get(value, "on")
let source_factory = "nefor.factory.source"
let source<T>: fn(String, T) -> Node<Unit, T> = |id, value| => {
  let `type` = type_tag<T>()
  let input = port(id, type_tag<Unit>(), "mag.Unit")
  let output = port(id, `type`, "nefor.graph.Value")
  let source_actor = closed_actor(id, source_factory, [type_evidence(`type`)], SourceParams<T> {value: value, value_type: value_type_id(value, `type`)}, store_port(input), [store_port(output)], [])
  node(id, "source", [source_actor], [], [], input, output)
}
let output<T>: fn(String) -> Node<T, T> = |id| => pass_node<T>(id, "output")
let identity<T>: fn(String) -> Node<T, T> = |id| => pass_node<T>(id, "ordinary")
let output_for<I, T>: fn(String, Node<I, T>) -> Node<T, T> = |id, from| => output<T>(id)

let same_edge: fn(Edge, Edge) -> Bool = |left, right| => if (=)(get(get(left, "from"), "id"), get(get(right, "from"), "id")) then if (=)(get(get(left, "to"), "id"), get(get(right, "to"), "id")) then serialized_equal(get(left, "routes"), get(right, "routes")) else false else false

let edge_key: fn(Edge) -> String = |value| => canonical(EdgeIdentity {from_node: get(get(value, "from"), "id"), to_node: get(get(value, "to"), "id"), routes: get(value, "routes")})

let edge_in: fn(List<Edge>, Edge) -> Bool = |edges, candidate| => not((=)(count(filter(((|value| => same_edge(value, candidate)) : fn(Edge) -> Bool), edges)), 0))

let same_edge_definition: fn(Edge, Edge) -> Bool = |left, right| => serialized_equal(left, right)

let insert_edge: fn(List<Edge>, Edge) -> List<Edge> = |edges, candidate| => if edge_in(edges, candidate) then if not((=)(count(filter(((|value| => same_edge_definition(value, candidate)) : fn(Edge) -> Bool), edges)), 0)) then edges else concat(edges, [candidate]) else concat(edges, [candidate])

let normalize_edges: fn(List<Edge>) -> List<Edge> = |edges| => fold(insert_edge, ([]: List<Edge>), edges)

let empty_graph = Graph {edges: ([]: List<Edge>)}

let graph: fn(List<Edge>) -> Graph = |edges| => Graph {edges: normalize_edges(edges)}

let add_edges: fn(Graph, List<Edge>) -> Graph = |value, added| => graph(concat(get(value, "edges"), added))

let remove_edges: fn(Graph, List<Edge>) -> Graph = |value, removed| => graph(filter(((|candidate| => not(edge_in(removed, candidate))) : fn(Edge) -> Bool), get(value, "edges")))

let port_address_key: fn(StoredPort) -> String = |value| => canonical(PortAddressIdentity {endpoint: get(value, "endpoint"), wire: get(value, "wire")})

let full_port_key: fn(StoredPort) -> String = |value| => canonical(value)

let node_id: fn(StoredNode) -> String = |value| => get(value, "id")

let actor_id: fn(Actor) -> String = |value| => get(value, "id")

let route_id: fn(StoredRoute) -> String = |value| => get(value, "id")

let contract_id: fn(FactoryContract) -> String = |value| => get(value, "identity")

let nodes_from_edge: fn(Edge) -> List<StoredNode> = |value| => [get(value, "from"), get(value, "to")]

let insert_ordered_string: fn(OrderedStrings, String) -> OrderedStrings = |state, candidate| => if core.set.contains(get(state, "seen"), candidate) then state else OrderedStrings {seen: core.set.insert(get(state, "seen"), candidate), values: concat(get(state, "values"), [candidate])}

let ordered_strings: fn(List<String>) -> List<String> = |values| => get(fold(insert_ordered_string, OrderedStrings {seen: core.set.empty<String>(), values: ([]: List<String>)}, values), "values")

let paths_for_actor: fn(StoredNode, String) -> List<List<String>> = |node, id| => occurrence_paths_for_actor(get(node, "nodes"), id)

let occurrence_provenance: fn(StoredNode, Int, Int, List<List<String>>) -> DefinitionProvenance = |node, node_occurrence, entity_occurrence, paths| => DefinitionProvenance {containing_node: get(node, "id"), logical_paths: paths, composition_path: [], node_occurrence: node_occurrence, entity_occurrence: entity_occurrence}

let node_occurrences: fn(List<StoredNode>) -> List<NodeOccurrence> = |nodes| => indexed_map(((|index, node| => NodeOccurrence {value: node, occurrence: index}) : fn(Int, StoredNode) -> NodeOccurrence), nodes)

let actor_occurrences_for_node: fn(NodeOccurrence) -> List<ActorOccurrence> = |occurrence| => {
  let node = get(occurrence, "value")
  indexed_map(((|index, actor| => ActorOccurrence {value: actor, provenance: occurrence_provenance(node, get(occurrence, "occurrence"), index, paths_for_actor(node, get(actor, "id")))}) : fn(Int, Actor) -> ActorOccurrence), get(node, "actors"))
}

let route_paths: fn(StoredNode, StoredRoute) -> List<List<String>> = |node, route| => route_logical_paths(get(node, "nodes"), route)
let route_occurrences_for_node: fn(NodeOccurrence) -> List<RouteOccurrence> = |occurrence| => { let node = get(occurrence, "value")
  indexed_map(((|index, route| => RouteOccurrence {value: route, provenance: occurrence_provenance(node, get(occurrence, "occurrence"), index, route_paths(node, route))}) : fn(Int, StoredRoute) -> RouteOccurrence), get(node, "routes")) }
let operation_occurrences_for_node: fn(NodeOccurrence) -> List<OperationOccurrence> = |occurrence| => { let node = get(occurrence, "value")
  indexed_map(((|index, operation| => OperationOccurrence {value: operation, provenance: occurrence_provenance(node, get(occurrence, "occurrence"), index, endpoint_logical_paths(get(node, "nodes"), get(get(operation, "on"), "endpoint")))}) : fn(Int, nefor.mag.ProgramOperation) -> OperationOccurrence), get(node, "operations")) }
let logical_occurrences_for_node: fn(NodeOccurrence) -> List<LogicalNodeOccurrence> = |occurrence| => { let node = get(occurrence, "value")
  indexed_map(((|index, logical| => LogicalNodeOccurrence {value: logical, provenance: occurrence_provenance(node, get(occurrence, "occurrence"), index, [get(logical, "path")])}) : fn(Int, LogicalNode) -> LogicalNodeOccurrence), get(node, "nodes")) }
let field_difference: fn(String, String, String) -> List<FieldDifference> = |field, first_value, conflicting_value| => if (=)(first_value, conflicting_value) then [] else [FieldDifference {field: field, first_value: first_value, conflicting_value: conflicting_value}]
let operation_differences: fn(nefor.mag.ProgramOperation, nefor.mag.ProgramOperation) -> List<FieldDifference> = |first_value, conflicting_value| => concat(field_difference("on", canonical(get(first_value, "on")), canonical(get(conflicting_value, "on"))), concat(field_difference("captures", canonical(get(first_value, "captures")), canonical(get(conflicting_value, "captures"))), concat(field_difference("expressions", canonical(get(first_value, "expressions")), canonical(get(conflicting_value, "expressions"))), field_difference("template", canonical(get(first_value, "template")), canonical(get(conflicting_value, "template"))))))
let conflict_error: fn(String, String, List<FieldDifference>, String, DefinitionProvenance, String, DefinitionProvenance) -> String = |entity, identity, differences, first_definition, first_provenance, conflicting_definition, conflicting_provenance| => str("identity conflict: ", canonical(ConflictDescription {entity: entity, identity: identity, differences: differences, first_definition: first_definition, first_provenance: first_provenance, conflicting_definition: conflicting_definition, conflicting_provenance: conflicting_provenance}))
let definition_field_value: fn(List<DefinitionField>, String) -> String = |fields, name| => get(first(filter(((|candidate| => (=)(get(candidate, "field"), name)) : fn(DefinitionField) -> Bool), fields)), "value")
let definition_differences: fn(List<DefinitionField>, List<DefinitionField>) -> List<FieldDifference> = |first_fields, conflicting_fields| => flat_map(((|candidate| => field_difference(get(candidate, "field"), get(candidate, "value"), definition_field_value(conflicting_fields, get(candidate, "field")))) : fn(DefinitionField) -> List<FieldDifference>), first_fields)
let definition_group_key: fn(DefinitionOccurrence) -> String = |value| => canonical([get(value, "kind"), get(value, "identity")])
let definition_conflict_errors: fn(List<DefinitionOccurrence>) -> List<String> = |occurrences| => { let by_identity = group_by(definition_group_key, occurrences)
  unique_definitions(flat_map(((|candidate| => { let bucket = __map_get_or(by_identity, definition_group_key(candidate), ([]: List<DefinitionOccurrence>))
  let first_occurrence = first(bucket)
  if serialized_equal(get(first_occurrence, "fields"), get(candidate, "fields")) then [] else [conflict_error(get(candidate, "kind"), get(candidate, "identity"), definition_differences(get(first_occurrence, "fields"), get(candidate, "fields")), canonical(get(first_occurrence, "fields")), get(first_occurrence, "provenance"), canonical(get(candidate, "fields")), get(candidate, "provenance"))] }) : fn(DefinitionOccurrence) -> List<String>), occurrences)) }
let definition_set_equal<T>: fn(List<T>, List<T>) -> Bool = |left, right| => (=)(canonical_definition_set(left), canonical_definition_set(right))
let execution_equal: fn(ExecutionDefinition, ExecutionDefinition) -> Bool = |left, right| => if serialized_equal(left, right) then true else if not((=)(get(left, "role"), get(right, "role"))) then false else if not(serialized_equal(get(left, "input"), get(right, "input"))) then false else if not(serialized_equal(get(left, "output"), get(right, "output"))) then false else if not(definition_set_equal(get(left, "actors"), get(right, "actors"))) then false else if not(definition_set_equal(get(left, "routes"), get(right, "routes"))) then false else if not(definition_set_equal(get(left, "messages"), get(right, "messages"))) then false else definition_set_equal(get(left, "operations"), get(right, "operations"))
let execution_differences: fn(ExecutionDefinition, ExecutionDefinition) -> List<FieldDifference> = |first_value, conflicting_value| => concat(field_difference("role", canonical(get(first_value, "role")), canonical(get(conflicting_value, "role"))), concat(field_difference("input", canonical(get(first_value, "input")), canonical(get(conflicting_value, "input"))), concat(field_difference("output", canonical(get(first_value, "output")), canonical(get(conflicting_value, "output"))), concat(field_difference("actors", canonical_definition_set(get(first_value, "actors")), canonical_definition_set(get(conflicting_value, "actors"))), concat(field_difference("routes", canonical_definition_set(get(first_value, "routes")), canonical_definition_set(get(conflicting_value, "routes"))), concat(field_difference("messages", canonical_definition_set(get(first_value, "messages")), canonical_definition_set(get(conflicting_value, "messages"))), field_difference("operations", canonical_definition_set(get(first_value, "operations")), canonical_definition_set(get(conflicting_value, "operations")))))))))
let execution_conflict_errors: fn(List<ExecutionOccurrence>) -> List<String> = |occurrences| => { let by_identity = group_by(((|candidate| => get(candidate, "identity")) : fn(ExecutionOccurrence) -> String), occurrences)
  unique_definitions(flat_map(((|candidate| => { let bucket = __map_get_or(by_identity, get(candidate, "identity"), ([]: List<ExecutionOccurrence>))
  let first_occurrence = first(bucket)
  if (=)(count(bucket), 1) then [] else if execution_equal(get(first_occurrence, "definition"), get(candidate, "definition")) then [] else [conflict_error("stored node", get(candidate, "identity"), execution_differences(get(first_occurrence, "definition"), get(candidate, "definition")), canonical(get(first_occurrence, "definition")), get(first_occurrence, "provenance"), canonical(get(candidate, "definition")), get(candidate, "provenance"))] }) : fn(ExecutionOccurrence) -> List<String>), occurrences)) }
let operation_conflict_errors: fn(List<OperationOccurrence>) -> List<String> = |occurrences| => { let by_id = group_by(((|candidate| => get(get(candidate, "value"), "id")) : fn(OperationOccurrence) -> String), occurrences)
  flat_map(((|candidate| => { let value = get(candidate, "value")
  let first_occurrence = first(__map_get_or(by_id, get(value, "id"), ([]: List<OperationOccurrence>)))
  if serialized_equal(get(first_occurrence, "value"), value) then [] else [conflict_error("operation", get(value, "id"), operation_differences(get(first_occurrence, "value"), value), canonical(get(first_occurrence, "value")), get(first_occurrence, "provenance"), canonical(value), get(candidate, "provenance"))] }) : fn(OperationOccurrence) -> List<String>), occurrences) }
let standalone_operation_occurrences: fn(List<nefor.mag.ProgramOperation>) -> List<OperationOccurrence> = |operations| => indexed_map(((|index, operation| => OperationOccurrence {value: operation, provenance: DefinitionProvenance {containing_node: "<program operations>", logical_paths: [], composition_path: [], node_occurrence: 0, entity_occurrence: index}}) : fn(Int, nefor.mag.ProgramOperation) -> OperationOccurrence), operations)
let merge_node_bucket: fn(List<StoredNode>) -> StoredNode = |bucket| => { let first_node = first(bucket)
  StoredNode {id: get(first_node, "id"), role: get(first_node, "role"), actors: get(first_node, "actors"), routes: get(first_node, "routes"), messages: get(first_node, "messages"), operations: get(first_node, "operations"), nodes: unique_definitions(flat_map(((|candidate| => get(candidate, "nodes")) : fn(StoredNode) -> List<LogicalNode>), bucket)), occurrences: unique_occurrences(flat_map(((|candidate| => get(candidate, "occurrences")) : fn(StoredNode) -> List<DefinitionOccurrence>), bucket)), executions: flat_map(((|candidate| => get(candidate, "executions")) : fn(StoredNode) -> List<ExecutionOccurrence>), bucket), input: get(first_node, "input"), output: get(first_node, "output")} }
let merge_nodes: fn(List<StoredNode>) -> List<StoredNode> = |values| => { let ids = ordered_strings(map(node_id, values))
  let by_id = group_by(node_id, values)
  map(((|id| => merge_node_bucket(__map_get_or(by_id, id, ([]: List<StoredNode>)))) : fn(String) -> StoredNode), ids) }
let external_routes: fn(Graph) -> List<StoredRoute> = |value| => flat_map(((|candidate| => get(candidate, "routes")) : fn(Edge) -> List<StoredRoute>), get(value, "edges"))
let node_identity_conflicts<I, O>: fn(Node<I, O>) -> List<String> = |authored| => { let value = normalize_node(authored)
  concat(execution_conflict_errors(node_execution_occurrences(value)), definition_conflict_errors(get(value, "occurrences"))) }
let graph_projection: fn(Graph) -> GraphProjection = |value| => {
  let edges = resolved_edges(get(value, "edges"))
  let edges_by_from_node = group_by(((|candidate| => node_id(get(candidate, "from"))) : fn(Edge) -> String), edges)
  let edges_by_to_node = group_by(((|candidate| => node_id(get(candidate, "to"))) : fn(Edge) -> String), edges)
  let all_nodes = flat_map(nodes_from_edge, edges)
  let nodes = merge_nodes(all_nodes)
  let occurrences = node_occurrences(nodes)
  let authored_definition_occurrences = unique_occurrences(flat_map(((|candidate| => get(candidate, "occurrences")) : fn(StoredNode) -> List<DefinitionOccurrence>), all_nodes))
  let authored_execution_occurrences = flat_map(((|candidate| => get(candidate, "executions")) : fn(StoredNode) -> List<ExecutionOccurrence>), all_nodes)
  let actor_occurrences = flat_map(actor_occurrences_for_node, occurrences)
  let all_route_occurrences = concat(flat_map(route_occurrences_for_node, occurrences), external_route_occurrences(edges))
  let operation_occurrences = flat_map(operation_occurrences_for_node, occurrences)
  let logical_occurrences = flat_map(logical_occurrences_for_node, occurrences)
  let roots = filter(((|candidate| => (=)(count(__map_get_or(edges_by_to_node, node_id(candidate), ([]: List<Edge>))), 0)) : fn(StoredNode) -> Bool), nodes)
  let actors = unique_definitions(map(((|candidate| => get(candidate, "value")) : fn(ActorOccurrence) -> Actor), actor_occurrences))
  let routes = unique_definitions(map(((|candidate| => get(candidate, "value")) : fn(RouteOccurrence) -> StoredRoute), all_route_occurrences))
  let authored_messages = unique_definitions(flat_map(((|candidate| => get(candidate, "messages")) : fn(StoredNode) -> List<Message>), nodes))
  let messages = unique_definitions(concat(authored_messages, root_messages(roots, routes, authored_messages)))
  let graph_operations = unique_definitions(map(((|candidate| => get(candidate, "value")) : fn(OperationOccurrence) -> nefor.mag.ProgramOperation), operation_occurrences))
  let logical_nodes = unique_definitions(map(((|candidate| => get(candidate, "value")) : fn(LogicalNodeOccurrence) -> LogicalNode), logical_occurrences))
  let external_definition_occurrences = map(((|candidate| => DefinitionOccurrence {kind: "route", identity: get(get(candidate, "value"), "id"), fields: route_definition_fields(get(candidate, "value")), provenance: get(candidate, "provenance")}) : fn(RouteOccurrence) -> DefinitionOccurrence), external_route_occurrences(edges))
  let identity_conflicts = concat(execution_conflict_errors(authored_execution_occurrences), definition_conflict_errors(concat(authored_definition_occurrences, external_definition_occurrences)))
  GraphProjection {edges: edges, all_nodes: all_nodes, nodes: nodes, actors: actors, routes: routes, messages: messages, graph_operations: graph_operations, logical_nodes: logical_nodes, edges_by_from_node: edges_by_from_node, edges_by_to_node: edges_by_to_node, roots: roots, outputs: filter(((|candidate| => (=)(get(candidate, "role"), "output")) : fn(StoredNode) -> Bool), nodes), identity_conflicts: identity_conflicts}
}
let analyze_for_lowering: fn(Graph) -> LoweringAnalysis = |value| => { let projection = graph_projection(value)
  let routes = get(projection, "routes")
  LoweringAnalysis {actors: get(projection, "actors"), routes: routes, route_input_addresses: ordered_strings(map(((|candidate| => port_address_key(get(candidate, "to"))) : fn(StoredRoute) -> String), routes)), routes_by_input: group_by(((|candidate| => port_address_key(get(candidate, "to"))) : fn(StoredRoute) -> String), sort_by(route_id, routes)), messages: get(projection, "messages"), operations: get(projection, "graph_operations"), logical_nodes: get(projection, "logical_nodes"), outputs: get(projection, "outputs")} }
let analyze_graph: fn(Graph) -> GraphAnalysis = |value| => {
  let lowering = analyze_for_lowering(value)
  let projection = graph_projection(value)
  let edges = get(projection, "edges")
  let all_nodes = get(projection, "all_nodes")
  let nodes = get(projection, "nodes")
  let actors = get(projection, "actors")
  let routes = get(projection, "routes")
  let messages = get(projection, "messages")
  let graph_operations = get(projection, "graph_operations")
  let outputs = get(projection, "outputs")
  let input_ports = map(((|candidate| => get(candidate, "input")) : fn(Actor) -> StoredPort), actors)
  let output_ports = flat_map(((|candidate| => get(candidate, "outputs")) : fn(Actor) -> List<StoredPort>), actors)
  GraphAnalysis {edges: edges, all_nodes: all_nodes, nodes: nodes, nodes_by_id: group_by(node_id, all_nodes), actors: actors, actors_by_id: group_by(actor_id, actors), input_ports_by_address: group_by(port_address_key, input_ports), output_ports_by_address: group_by(port_address_key, output_ports), routes: routes, route_input_addresses: get(lowering, "route_input_addresses"), routes_by_input: get(lowering, "routes_by_input"), diagnostic_routes_by_input: group_by(((|route| => port_address_key(get(route, "to"))) : fn(StoredRoute) -> String), routes), routes_by_output: group_by(((|candidate| => port_address_key(get(candidate, "from"))) : fn(StoredRoute) -> String), routes), routes_by_source_actor: group_by(((|candidate| => endpoint_id(get(get(candidate, "from"), "endpoint"))) : fn(StoredRoute) -> String), routes), messages: messages, messages_by_input: group_by(((|candidate| => port_address_key(get(candidate, "to"))) : fn(Message) -> String), messages), graph_operations: graph_operations, graph_operations_by_output: group_by(((|candidate| => port_address_key(operation_port(candidate))) : fn(nefor.mag.ProgramOperation) -> String), graph_operations), edges_by_from_node: get(projection, "edges_by_from_node"), edges_by_to_node: get(projection, "edges_by_to_node"), roots: get(projection, "roots"), outputs: outputs, terminal_outputs_by_full_port: group_by(((|candidate| => canonical(get(candidate, "output"))) : fn(StoredNode) -> String), outputs), identity_conflicts: get(projection, "identity_conflicts")}
}
let graph_nodes: fn(Graph) -> List<StoredNode> = |value| => get(graph_projection(value), "nodes")
let graph_routes: fn(Graph) -> List<StoredRoute> = |value| => get(graph_projection(value), "routes")
let graph_actors: fn(Graph) -> List<Actor> = |value| => get(graph_projection(value), "actors")
let unit_input: fn(StoredPort) -> Bool = |input| => (=)(canonical(get(input, "type_id")), canonical(type_id(type_evidence(type_tag<Unit>()))))

let input_needs_bootstrap: fn(Map<String, List<StoredRoute>>, Map<String, List<Message>>, StoredPort) -> Bool = |routes_by_input, messages_by_input, input| => if unit_input(input) then if (=)(count(__map_get_or(routes_by_input, port_address_key(input), ([]: List<StoredRoute>))), 0) then (=)(count(__map_get_or(messages_by_input, port_address_key(input), ([]: List<Message>))), 0) else false else false

let graph_messages: fn(Graph) -> List<Message> = |value| => get(graph_projection(value), "messages")

let graph_operations: fn(Graph) -> List<nefor.mag.ProgramOperation> = |value| => get(graph_projection(value), "graph_operations")

let graph_logical_nodes: fn(Graph) -> List<LogicalNode> = |value| => get(graph_projection(value), "logical_nodes")

let string_set: fn(List<String>) -> Set<String> = |values| => fold(((|set, value| => if core.set.contains(set, value) then set else core.set.insert(set, value)) : fn(Set<String>, String) -> Set<String>), core.set.empty<String>(), values)

let logical_paths_valid: fn(Graph) -> Bool = |value| => {
  let nodes = graph_logical_nodes(value)
  let paths = map(((|candidate| => canonical(get(candidate, "path"))) : fn(LogicalNode) -> String), nodes)
  let segments = flat_map(((|candidate| => get(candidate, "path")) : fn(LogicalNode) -> List<String>), nodes)
  let empty_paths = filter(((|candidate| => (=)(count(get(candidate, "path")), 0)) : fn(LogicalNode) -> Bool), nodes)
  if (=)(count(empty_paths), 0) then if (=)(count(filter(((|name| => (=)(name, "")) : fn(String) -> Bool), segments)), 0) then (=)(core.set.count(string_set(paths)), count(paths)) else false else false
}

let logical_members_valid: fn(Graph) -> Bool = |value| => {
  let members = flat_map(((|candidate| => get(candidate, "members")) : fn(LogicalNode) -> List<String>), graph_logical_nodes(value))
  let actors = actor_ids(graph_actors(value))
  if (=)(core.set.count(string_set(members)), count(members)) then (=)(string_set(members), string_set(actors)) else false
}

let role: fn(StoredNode, String) -> Bool = |candidate, role| => (=)(get(candidate, "role"), role)

let indexed_count<T>: fn(Map<String, List<T>>, String) -> Int = |index, id| => count(__map_get_or(index, id, ([]: List<T>)))

let incoming_count: fn(GraphAnalysis, String) -> Int = |analysis, id| => indexed_count(get(analysis, "edges_by_to_node"), id)

let outgoing_count: fn(GraphAnalysis, String) -> Int = |analysis, id| => indexed_count(get(analysis, "edges_by_from_node"), id)

let output_shape_valid: fn(GraphAnalysis, StoredNode) -> Bool = |analysis, candidate| => if role(candidate, "output") then if not((=)(incoming_count(analysis, node_id(candidate)), 0)) then (=)(outgoing_count(analysis, node_id(candidate)), 0) else false else true

let enqueue_unvisited: fn(ReachabilityState, String) -> ReachabilityState = |state, id| => if core.set.contains(get(state, "visited"), id) then state else ReachabilityState {visited: core.set.insert(get(state, "visited"), id), frontier: concat(get(state, "frontier"), [id])}

let initial_reachability_state: fn(List<String>) -> ReachabilityState = |ids| => fold(enqueue_unvisited, ReachabilityState {visited: core.set.empty<String>(), frontier: ([]: List<String>)}, ids)

let next_forward_frontier: fn(GraphAnalysis, ReachabilityState) -> ReachabilityState = |analysis, state| => {
  let next = flat_map(((|id| => map(((|candidate| => node_id(get(candidate, "to"))) : fn(Edge) -> String), __map_get_or(get(analysis, "edges_by_from_node"), id, ([]: List<Edge>)))) : fn(String) -> List<String>), get(state, "frontier"))
  fold(enqueue_unvisited, ReachabilityState {visited: get(state, "visited"), frontier: ([]: List<String>)}, next)
}

let walk_forward: fn(GraphAnalysis, ReachabilityState) -> Set<String> = |analysis, state| => if (=)(count(get(state, "frontier")), 0) then get(state, "visited") else walk_forward(analysis, next_forward_frontier(analysis, state))

let forward_reachable: fn(GraphAnalysis) -> Set<String> = |analysis| => walk_forward(analysis, initial_reachability_state(map(node_id, get(analysis, "roots"))))

let next_reverse_frontier: fn(GraphAnalysis, ReachabilityState) -> ReachabilityState = |analysis, state| => {
  let previous = flat_map(((|id| => map(((|candidate| => node_id(get(candidate, "from"))) : fn(Edge) -> String), __map_get_or(get(analysis, "edges_by_to_node"), id, ([]: List<Edge>)))) : fn(String) -> List<String>), get(state, "frontier"))
  fold(enqueue_unvisited, ReachabilityState {visited: get(state, "visited"), frontier: ([]: List<String>)}, previous)
}

let walk_reverse: fn(GraphAnalysis, ReachabilityState) -> Set<String> = |analysis, state| => if (=)(count(get(state, "frontier")), 0) then get(state, "visited") else walk_reverse(analysis, next_reverse_frontier(analysis, state))

let reverse_reachable: fn(GraphAnalysis, StoredNode) -> Set<String> = |analysis, result| => walk_reverse(analysis, initial_reachability_state([node_id(result)]))

let factory_contract: fn(FactoryContract) -> FactoryContract = |entry| => entry

let contains_string: fn(List<String>, String) -> Bool = |values, value| => not((=)(count(filter(((|candidate| => (=)(candidate, value)) : fn(String) -> Bool), values)), 0))

let all_strings_in: fn(List<String>, List<String>) -> Bool = |left, right| => (=)(count(filter(((|value| => not(contains_string(right, value))) : fn(String) -> Bool), left)), 0)

let one_port: fn(List<StoredPort>, StoredPort) -> Bool = |ports, expected| => serialized_equal(ports, [expected])

let empty_packed_map: fn(PackedValue) -> Bool = |value| => packed_empty_record(value)

let source_params_valid: fn(PackedValue) -> Bool = |value| => packed_record_has_only_keys(value, ["value", "value_type"])

let source_value_valid: fn(Actor, StoredPort) -> Bool = |value, output| => packed_field_conforms(get(value, "params"), "value", get(output, "type"))

let one_type_argument: fn(Actor, TypeDescriptor) -> Bool = |value, expected| => serialized_equal(get(value, "type_arguments"), [expected])

let actor_endpoint_matches: fn(StoredPort, String) -> Bool = |value, id| => if endpoint_is_actor(get(value, "endpoint")) then (=)(endpoint_id(get(value, "endpoint")), id) else false
let actor_output_wires: fn(Actor) -> List<String> = |value| => map(((|output| => get(output, "wire")) : fn(StoredPort) -> String), get(value, "outputs"))

let actor_contract_errors: fn(Map<String, List<FactoryContract>>, Actor) -> List<String> = |contracts_by_id, value| => {
  let identity = get(value, "factory")
  let matching = __map_get_or(contracts_by_id, identity, ([]: List<FactoryContract>))
  if (=)(count(matching), 0) then [str(str(str("actor ", canonical(get(value, "id"))), ": factory identity "), str(canonical(identity), " is not present in the runtime inventory"))] else (((| | => {
    let scheme = get(first(matching), "type_scheme")
    let input_wire = get(get(value, "input"), "wire")
    let accepted_inputs = get(scheme, "input_tags")
    let output_wires = actor_output_wires(value)
    let accepted_outputs = get(scheme, "outputs")
    let input_errors = if contains_string(accepted_inputs, input_wire) then ([]: List<String>) else [str(str(str(str(str("actor ", canonical(get(value, "id"))), ": factory "), canonical(identity)), str(" rejects input wire ", canonical(input_wire))), str("; accepted input wires: ", canonical(accepted_inputs)))]
    let output_errors = if all_strings_in(output_wires, accepted_outputs) then ([]: List<String>) else [str(str(str(str(str("actor ", canonical(get(value, "id"))), ": factory "), canonical(identity)), str(" exposes output wires ", canonical(output_wires))), str("; accepted output wires: ", canonical(accepted_outputs)))]
    concat(input_errors, output_errors)
  }) : fn() -> List<String>))()
}

let actor_ids_valid: fn(GraphAnalysis) -> Bool = |analysis| => (=)(count(filter(((|candidate| => not((=)(indexed_count(get(analysis, "actors_by_id"), actor_id(candidate)), 1))) : fn(Actor) -> Bool), get(analysis, "actors"))), 0)
let port_evidence_valid: fn(StoredPort) -> Bool = |value| => serialized_equal(get(value, "type_id"), type_id(get(value, "type")))
let actor_port_owned: fn(String, StoredPort) -> Bool = |id, value| => if endpoint_is_actor(get(value, "endpoint")) then if (=)(endpoint_id(get(value, "endpoint")), id) then port_evidence_valid(value) else false else false
let actor_ports_owned: fn(Actor) -> Bool = |value| => if actor_port_owned(get(value, "id"), get(value, "input")) then (=)(count(filter(((|candidate| => not(actor_port_owned(get(value, "id"), candidate))) : fn(StoredPort) -> Bool), get(value, "outputs"))), 0) else false
let constructor_payload_matches: fn(TypeDescriptor, String, TypeDescriptor) -> Bool = |owner, constructor, payload| => serialized_equal(adt_constructor_payload(owner, constructor), payload)
let actor_ports_valid: fn(GraphAnalysis) -> Bool = |analysis| => (=)(count(filter(((|candidate| => not(actor_ports_owned(candidate))) : fn(Actor) -> Bool), get(analysis, "actors"))), 0)

let same_port_address: fn(StoredPort, StoredPort) -> Bool = |left, right| => (=)(port_address_key(left), port_address_key(right))

let port_is_output: fn(GraphAnalysis, StoredPort) -> Bool = |analysis, value| => {
  let candidates = __map_get_or(get(analysis, "output_ports_by_address"), port_address_key(value), ([]: List<StoredPort>))
  (=)(count(filter(((|output| => descriptor_accepts(get(output, "type"), get(value, "type"))) : fn(StoredPort) -> Bool), candidates)), 1)
}

let port_is_input: fn(GraphAnalysis, StoredPort) -> Bool = |analysis, value| => {
  let candidates = __map_get_or(get(analysis, "input_ports_by_address"), port_address_key(value), ([]: List<StoredPort>))
  (=)(count(filter(((|candidate| => descriptor_accepts(get(candidate, "type"), get(value, "type"))) : fn(StoredPort) -> Bool), candidates)), 1)
}

let port_address: fn(StoredPort) -> String = |value| => str(endpoint_id(get(value, "endpoint")), str(".", get(value, "wire")))

let describe_route_source: fn(StoredRoute) -> String = |route| => {
  let source = get(route, "from")
  canonical(RouteSourceDescription {kind: "route", from: port_address(source), `type`: get(source, "type")})
}

let describe_message_source: fn(Message) -> String = |message| => str("initial message type ", canonical(get(message, "semantic_type")))

let describe_route_handler: fn(StoredRoute) -> String = |route| => {
  let target = get(route, "to")
  canonical(RouteHandlerDescription {kind: "route", to: port_address(target), `type`: get(target, "type")})
}

let describe_operation_handler: fn(nefor.mag.ProgramOperation) -> String = |candidate| => canonical(OperationDescription {kind: "operation", id: get(candidate, "id"), `type`: get(operation_port(candidate), "type")})

let actor_input_sources: fn(GraphAnalysis, Actor) -> List<String> = |analysis, candidate| => {
  let key = port_address_key(get(candidate, "input"))
  concat(map(describe_route_source, __map_get_or(get(analysis, "diagnostic_routes_by_input"), key, ([]: List<StoredRoute>))), map(describe_message_source, __map_get_or(get(analysis, "messages_by_input"), key, ([]: List<Message>))))
}

let output_handlers: fn(GraphAnalysis, Map<String, List<nefor.mag.ProgramOperation>>, StoredPort) -> List<String> = |analysis, operations_by_output, output| => {
  let key = port_address_key(output)
  concat(map(describe_route_handler, __map_get_or(get(analysis, "routes_by_output"), key, ([]: List<StoredRoute>))), map(describe_operation_handler, __map_get_or(operations_by_output, key, ([]: List<nefor.mag.ProgramOperation>))))
}

let operation_handler_types: fn(Map<String, List<nefor.mag.ProgramOperation>>, StoredPort) -> List<TypeDescriptor> = |operations_by_output, output| => map(((|candidate| => get(operation_port(candidate), "type")) : fn(nefor.mag.ProgramOperation) -> TypeDescriptor), __map_get_or(operations_by_output, port_address_key(output), ([]: List<nefor.mag.ProgramOperation>)))

let actor_output_coverage_valid: fn(GraphAnalysis, Map<String, List<nefor.mag.ProgramOperation>>, StoredPort) -> Bool = |analysis, operations_by_output, output| => if terminal_output(analysis, output) then true else descriptor_output_covered_by(get(output, "type"), concat(route_handler_types(analysis, output), operation_handler_types(operations_by_output, output)))

let actor_outputs_coverage_valid: fn(GraphAnalysis, Map<String, List<nefor.mag.ProgramOperation>>, Actor) -> Bool = |analysis, operations_by_output, candidate| => (=)(count(filter(((|output| => not(actor_output_coverage_valid(analysis, operations_by_output, output))) : fn(StoredPort) -> Bool), get(candidate, "outputs"))), 0)

let validate_routes_stage: fn(Graph, GraphAnalysis) -> core.validated.Validated<String, Graph> = |value, analysis| => {
  let assembly_failures = assembly_errors(analysis)
  let bad_messages = filter(((|candidate| => not(message_valid(analysis, candidate))) : fn(Message) -> Bool), get(analysis, "messages"))
  let bad_results = filter(((|candidate| => not(result_value_valid(get(candidate, "output")))) : fn(StoredNode) -> Bool), get(analysis, "outputs"))
  let bad_routes = filter(((|candidate| => not(route_valid(analysis, candidate))) : fn(StoredRoute) -> Bool), get(analysis, "routes"))
  if not((=)(count(assembly_failures), 0)) then core.validated.invalid(assembly_failures) else if not((=)(count(bad_messages), 0)) then core.validated.invalid(["graph contains an unknown or incompatible initial message"]) else if not((=)(count(bad_results), 0)) then core.validated.invalid(["result boundary transformations do not produce the selected output type"]) else if (=)(count(bad_routes), 0) then core.validated.valid(value) else core.validated.invalid(["graph contains an unknown or incompatible edge"])
}

let validate_contracts_stage: fn(Graph, GraphAnalysis, List<FactoryContract>) -> core.validated.Validated<String, Graph> = |value, analysis, contracts| => {
  let contracts_by_id = group_by(contract_id, contracts)
  let contract_errors = flat_map(((|candidate| => actor_contract_errors(contracts_by_id, candidate)) : fn(Actor) -> List<String>), get(analysis, "actors"))
  if (=)(count(contract_errors), 0) then validate_routes_stage(value, analysis) else core.validated.invalid(contract_errors)
}

let validate_dead_stage: fn(Graph, GraphAnalysis, List<FactoryContract>, StoredNode) -> core.validated.Validated<String, Graph> = |value, analysis, contracts, result| => {
  let reverse = reverse_reachable(analysis, result)
  let dead = filter(((|candidate| => not(core.set.contains(reverse, node_id(candidate)))) : fn(StoredNode) -> Bool), get(analysis, "nodes"))
  if (=)(count(dead), 0) then validate_contracts_stage(value, analysis, contracts) else core.validated.invalid(["every node must have a path to the output node"])
}

let validate_reachable_stage: fn(Graph, GraphAnalysis, List<FactoryContract>, StoredNode) -> core.validated.Validated<String, Graph> = |value, analysis, contracts, result| => {
  let forward = forward_reachable(analysis)
  let unreachable = filter(((|candidate| => not(core.set.contains(forward, node_id(candidate)))) : fn(StoredNode) -> Bool), get(analysis, "nodes"))
  if (=)(count(unreachable), 0) then validate_dead_stage(value, analysis, contracts, result) else core.validated.invalid(["every node must be reachable from a root node whose input accepts Unit"])
}

let validate_output_coverage_stage: fn(Graph, GraphAnalysis, Map<String, List<nefor.mag.ProgramOperation>>, List<FactoryContract>, StoredNode) -> core.validated.Validated<String, Graph> = |value, analysis, operations_by_output, contracts, result| => {
  let bad_output_coverage = flat_map(((|candidate| => filter(((|output| => not(actor_output_coverage_valid(analysis, operations_by_output, output))) : fn(StoredPort) -> Bool), get(candidate, "outputs"))) : fn(Actor) -> List<StoredPort>), get(analysis, "actors"))
  let errors = map(((|output| => str("output coverage failed: ", canonical(OutputCoverageDescription {actor: endpoint_id(get(output, "endpoint")), output: port_address(output), output_type: get(output, "type"), available_handlers: output_handlers(analysis, operations_by_output, output), reason: "coverage is incomplete; every output alternative needs an ordinary route, operation subscription, or terminal output path"}))) : fn(StoredPort) -> String), bad_output_coverage)
  if (=)(count(bad_output_coverage), 0) then validate_reachable_stage(value, analysis, contracts, result) else core.validated.invalid(errors)
}

let validate_input_coverage_stage: fn(Graph, GraphAnalysis, Map<String, List<nefor.mag.ProgramOperation>>, List<FactoryContract>, StoredNode) -> core.validated.Validated<String, Graph> = |value, analysis, operations_by_output, contracts, result| => {
  let bad_input_coverage = filter(((|candidate| => not(actor_input_coverage_valid(analysis, candidate))) : fn(Actor) -> Bool), get(analysis, "actors"))
  let errors = map(((|candidate| => {
      let input = get(candidate, "input")
      str("input coverage failed: ", canonical(InputCoverageDescription {actor: get(candidate, "id"), input: port_address(input), expected_type: get(input, "type"), incoming_sources: actor_input_sources(analysis, candidate), reason: "sources must be compatible and exactly cover every product occurrence; check for missing, extra, or ambiguous occurrences"}))
    }) : fn(Actor) -> String), bad_input_coverage)
  if (=)(count(bad_input_coverage), 0) then validate_output_coverage_stage(value, analysis, operations_by_output, contracts, result) else core.validated.invalid(errors)
}

let validate_outputs_stage: fn(Graph, GraphAnalysis, Map<String, List<nefor.mag.ProgramOperation>>, List<FactoryContract>, StoredNode) -> core.validated.Validated<String, Graph> = |value, analysis, operations_by_output, contracts, result| => {
  let bad_outputs = filter(((|candidate| => not(output_shape_valid(analysis, candidate))) : fn(StoredNode) -> Bool), get(analysis, "nodes"))
  if (=)(count(bad_outputs), 0) then validate_input_coverage_stage(value, analysis, operations_by_output, contracts, result) else core.validated.invalid(["output nodes require an incoming edge and are terminal"])
}

let validate_roots_stage: fn(Graph, GraphAnalysis, Map<String, List<nefor.mag.ProgramOperation>>, List<FactoryContract>, StoredNode) -> core.validated.Validated<String, Graph> = |value, analysis, operations_by_output, contracts, result| => {
  let bad_roots = filter(((|candidate| => not(root_shape_valid(analysis, candidate))) : fn(StoredNode) -> Bool), get(analysis, "nodes"))
  if (=)(count(bad_roots), 0) then validate_outputs_stage(value, analysis, operations_by_output, contracts, result) else core.validated.invalid(map(((|candidate| => {
        let input = get(candidate, "input")
        str("root validation failed: ", canonical(RootValidationDescription {node: get(candidate, "id"), input: canonical(input), input_type: get(input, "type"), reason: "zero incoming edges; only inputs that accept Unit can be activated automatically"}))
      }) : fn(StoredNode) -> String), bad_roots))
}

let validate_boundaries_stage: fn(Graph, GraphAnalysis, Map<String, List<nefor.mag.ProgramOperation>>, List<FactoryContract>, StoredNode) -> core.validated.Validated<String, Graph> = |value, analysis, operations_by_output, contracts, result| => {
  let bad_boundaries = filter(((|candidate| => not(boundary_valid(candidate))) : fn(StoredNode) -> Bool), get(analysis, "nodes"))
  if (=)(count(bad_boundaries), 0) then validate_roots_stage(value, analysis, operations_by_output, contracts, result) else core.validated.invalid(["boundary node roles require their concrete source/output factory shape, and ordinary nodes cannot contain initial messages"])
}

let operation_id: fn(nefor.mag.ProgramOperation) -> String = |value| => get(value, "id")

let operation_valid: fn(GraphAnalysis, nefor.mag.ProgramOperation) -> Bool = |analysis, value| => {
  let on = operation_port(value)
  let declared = __map_get_or(get(analysis, "output_ports_by_address"), port_address_key(on), ([]: List<StoredPort>))
  let exact = filter(((|output| => if serialized_equal(get(output, "type_id"), get(on, "type_id")) then serialized_equal(get(output, "type"), get(on, "type")) else false) : fn(StoredPort) -> Bool), declared)
  if (=)(get(value, "id"), "") then false else if (=)(count(exact), 0) then false else not(terminal_output(analysis, on))
}

let validate_unique_output_stage: fn(Graph, GraphAnalysis, List<nefor.mag.ProgramOperation>, List<FactoryContract>) -> core.validated.Validated<String, Graph> = |value, analysis, operations, contracts| => {
  let authored_operations = concat(get(analysis, "graph_operations"), operations)
  let operation_conflicts = operation_conflict_errors(standalone_operation_occurrences(authored_operations))
  let all_operations = unique_definitions(authored_operations)
  let invalid = filter(((|candidate| => not(operation_valid(analysis, candidate))) : fn(nefor.mag.ProgramOperation) -> Bool), all_operations)
  let operations_by_output = group_by(((|candidate| => port_address_key(operation_port(candidate))) : fn(nefor.mag.ProgramOperation) -> String), all_operations)
  let result = first(get(analysis, "outputs"))
  if not((=)(count(operation_conflicts), 0)) then core.validated.invalid(operation_conflicts) else if not((=)(count(invalid), 0)) then core.validated.invalid(["program operations must observe a declared non-result output with matching trigger type"]) else validate_boundaries_stage(value, analysis, operations_by_output, contracts, result)
}

let validate_with_operations: fn(Graph, List<nefor.mag.ProgramOperation>, List<FactoryContract>) -> core.validated.Validated<String, Graph> = |value, operations, contracts| => {
  let analysis = analyze_graph(value)
  if (=)(count(get(analysis, "edges")), 0) then core.validated.invalid(["graph needs at least one edge"]) else if not((=)(count(get(analysis, "identity_conflicts")), 0)) then core.validated.invalid(get(analysis, "identity_conflicts")) else if not(actor_ids_valid(analysis)) then core.validated.invalid(["runtime actor ids must be unique across graph nodes"]) else if not(actor_ports_valid(analysis)) then core.validated.invalid(["actor ports must use their owning actor endpoint"]) else if not(logical_paths_valid(value)) then core.validated.invalid(["logical node paths must be non-empty and unique"]) else if not(logical_members_valid(value)) then core.validated.invalid(["every runtime actor must belong to exactly one logical node"]) else if not((=)(count(get(analysis, "outputs")), 1)) then core.validated.invalid(["graph needs exactly one concrete output node"]) else validate_unique_output_stage(value, analysis, operations, contracts)
}

let validate: fn(Graph, List<FactoryContract>) -> core.validated.Validated<String, Graph> = |value, contracts| => validate_with_operations(value, ([]: List<nefor.mag.ProgramOperation>), contracts)

let lower_actor: fn(Actor) -> LowerActor = |value| => LowerActor {id: get(value, "id"), factory: get(value, "factory"), type_arguments: get(value, "type_arguments"), input: get(value, "input"), outputs: get(value, "outputs"), params: get(value, "params")}
let lower_message: fn(Message) -> LowerMessage = |value| => LowerMessage {to: get(value, "to"), transforms: get(value, "transforms"), semantic_type: get(value, "semantic_type"), semantic_type_id: get(value, "semantic_type_id"), content: get(value, "content")}
let result_boundary: fn(LoweringAnalysis) -> ResultBoundary = |analysis| => ResultBoundary {from: normalized_boundary(get(first(get(analysis, "outputs")), "output"))}
let actor_descriptors: fn(List<Actor>) -> List<TypeDescriptor> = |actors| => flat_map(((|candidate| => concat([get(get(candidate, "input"), "type")], map(((|output| => get(output, "type")) : fn(StoredPort) -> TypeDescriptor), get(candidate, "outputs")))) : fn(Actor) -> List<TypeDescriptor>), actors)
let route_descriptors: fn(List<StoredRoute>) -> List<TypeDescriptor> = |routes| => flat_map(((|candidate| => concat([get(get(candidate, "from"), "type"), get(get(candidate, "to"), "type")], flat_map(transform_descriptors, get(candidate, "transforms")))) : fn(StoredRoute) -> List<TypeDescriptor>), routes)
let message_descriptors: fn(List<Message>) -> List<TypeDescriptor> = |messages| => flat_map(((|candidate| => concat([get(candidate, "semantic_type"), get(get(candidate, "to"), "type")], flat_map(transform_descriptors, get(candidate, "transforms")))) : fn(Message) -> List<TypeDescriptor>), messages)
let operation_descriptors: fn(List<nefor.mag.ProgramOperation>) -> List<TypeDescriptor> = |operations| => map(((|candidate| => get(operation_port(candidate), "type")) : fn(nefor.mag.ProgramOperation) -> TypeDescriptor), operations)
let program_descriptors: fn(LoweringAnalysis, List<nefor.mag.ProgramOperation>) -> List<TypeDescriptor> = |analysis, operations| => concat(actor_descriptors(get(analysis, "actors")), concat(route_descriptors(get(analysis, "routes")), concat(message_descriptors(get(analysis, "messages")), concat(operation_descriptors(operations), boundary_descriptors(get(first(get(analysis, "outputs")), "output"))))))
let delta_descriptors: fn(Delta) -> List<TypeDescriptor> = |value| => concat(actor_descriptors(get(value, "actors")), concat(route_descriptors(get(value, "routes")), message_descriptors(get(value, "messages"))))
let lower_program: fn(Graph) -> Modification = |topology| => {
  let projection = graph_projection(topology)
  let conflicts = get(projection, "identity_conflicts")
  let analysis = if (=)(count(conflicts), 0) then analyze_for_lowering(topology) else fail(conflicts)
  let operations = get(analysis, "operations")
  Modification {actors: map(lower_actor, get(analysis, "actors")), routes: map(lower_route, get(analysis, "routes")), messages: map(lower_message, get(analysis, "messages")), kills: [], types: descriptor_table(program_descriptors(analysis, operations)), nodes: get(analysis, "logical_nodes"), result: result_boundary(analysis)}
}
let lower: fn(Graph) -> Modification = |value| => lower_program(value)
let delta: fn(List<Actor>, List<StoredRoute>, List<Message>, List<String>) -> Delta = |actors, routes, messages, kills| => Delta {actors: actors, routes: routes, messages: messages, nodes: map(((|candidate| => logical_node([get(candidate, "id")], [get(candidate, "id")])) : fn(Actor) -> LogicalNode), actors), kills: kills}
let node_delta<I, O>: fn(Node<I, O>) -> Delta = |value| => Delta {actors: get(value, "actors"), routes: get(value, "routes"), messages: get(value, "messages"), nodes: get(value, "nodes"), kills: []}
let merge_delta: fn(Delta, Delta) -> Delta = |left, right| => Delta {actors: concat(get(left, "actors"), get(right, "actors")), routes: concat(get(left, "routes"), get(right, "routes")), messages: concat(get(left, "messages"), get(right, "messages")), nodes: concat(get(left, "nodes"), get(right, "nodes")), kills: concat(get(left, "kills"), get(right, "kills"))}
let delta_edge<I, T, O>: fn(Delta, Node<I, T>, Node<T, O>) -> Delta = |change, from, to| => Delta {actors: get(change, "actors"), routes: concat(get(change, "routes"), connect(get(from, "output"), get(to, "input"))), messages: get(change, "messages"), nodes: get(change, "nodes"), kills: get(change, "kills")}
let delta_route<A, B>: fn(Delta, Port<A>, Port<B>) -> Delta = |change, from, to| => Delta {actors: get(change, "actors"), routes: concat(get(change, "routes"), connect(from, to)), messages: get(change, "messages"), nodes: get(change, "nodes"), kills: get(change, "kills")}
let delta_message<T>: fn(Delta, Port<T>, T) -> Delta = |change, to, value| => Delta {actors: get(change, "actors"), routes: get(change, "routes"), messages: concat(get(change, "messages"), [typed_message(to, value)]), nodes: get(change, "nodes"), kills: get(change, "kills")}
let delta_message_front<T>: fn(Delta, Port<T>, T) -> Delta = |change, to, value| => Delta {actors: get(change, "actors"), routes: get(change, "routes"), messages: concat([typed_message(to, value)], get(change, "messages")), nodes: get(change, "nodes"), kills: get(change, "kills")}
let lower_delta: fn(Delta) -> LowerDelta = |value| => {
  let actors = get(value, "actors")
  let authored_messages = get(value, "messages")
  let delta_inputs = map(((|candidate| => get(candidate, "input")) : fn(Actor) -> StoredPort), actors)
  let unit_ports = filter(((|input| => (=)(canonical(type_id(get(input, "type"))), canonical(type_id(type_evidence(type_tag<Unit>()))))) : fn(StoredPort) -> Bool), delta_inputs)
  LowerDelta {actors: map(lower_actor, actors), routes: map(lower_route, get(value, "routes")), messages: map(lower_message, concat(authored_messages, bootstrap_messages(unit_ports, get(value, "routes"), authored_messages))), kills: get(value, "kills"), types: descriptor_table(delta_descriptors(value)), nodes: get(value, "nodes")}
}
let with_templateability: fn(Actor, Templateability) -> Actor = |actor, capability| => Actor {id: get(actor, "id"), factory: get(actor, "factory"), type_arguments: get(actor, "type_arguments"), params: get(actor, "params"), input: get(actor, "input"), outputs: get(actor, "outputs"), templateability: capability}

// Sequential substitution is a cross product of source and destination paths.
// No intermediary address survives: every executable route has actor leaves.
let prepend_flow: fn(Flow, BoundaryLeaf) -> BoundaryLeaf = |flow, leaf| => BoundaryLeaf {port: get(leaf, "port"), steps: concat(get(flow, "steps"), get(leaf, "steps"))}
let append_flow: fn(BoundaryLeaf, Flow) -> BoundaryLeaf = |leaf, flow| => BoundaryLeaf {port: get(leaf, "port"), steps: concat(get(leaf, "steps"), get(flow, "steps"))}
let compose_flows: fn(List<Flow>, List<Flow>) -> List<Flow> = |left, right| => flat_map(((|before| => map(((|after| => Flow {steps: concat(get(before, "steps"), get(after, "steps"))}) : fn(Flow) -> Flow), right)) : fn(Flow) -> List<Flow>), left)
let substitute_output: fn(StoredBoundary, StoredBoundary) -> StoredBoundary = |left, right| => StoredBoundary {`type`: get(right, "type"), type_id: get(right, "type_id"), leaves: concat(get(right, "leaves"), flat_map(((|leaf| => map(((|flow| => append_flow(leaf, flow)) : fn(Flow) -> BoundaryLeaf), get(right, "through"))) : fn(BoundaryLeaf) -> List<BoundaryLeaf>), get(left, "leaves"))), through: compose_flows(get(left, "through"), get(right, "through"))}
let composed_input<I, A, O>: fn(Node<I, A>, Node<A, O>) -> Port<I> = |left, right| => {
  let left_input = store_boundary(get(left, "input"))
  let left_output = store_boundary(get(left, "output"))
  let right_input = store_boundary(get(right, "input"))
  boundary(type_tag<I>(), concat(get(left_input, "leaves"), flat_map(((|flow| => map(((|leaf| => prepend_flow(flow, leaf)) : fn(BoundaryLeaf) -> BoundaryLeaf), get(right_input, "leaves"))) : fn(Flow) -> List<BoundaryLeaf>), get(left_output, "through"))), [])
}
let composed_output<I, A, O>: fn(Node<I, A>, Node<A, O>) -> Port<O> = |left, right| => Port<O> {`type`: type_tag<O>(), boundary: substitute_output(store_boundary(get(left, "output")), store_boundary(get(right, "output")))}
let boundary_with_steps<I, O>: fn(Port<I>, TypeTag<O>, List<Transform>) -> Port<O> = |value, tag, steps| => {
  let stored = store_boundary(value)
  let flow = Flow {steps: steps}
  boundary(tag, map(((|leaf| => append_flow(leaf, flow)) : fn(BoundaryLeaf) -> BoundaryLeaf), get(stored, "leaves")), compose_flows(get(stored, "through"), [flow]))
}
let input_with_steps<I, O>: fn(TypeTag<I>, List<Transform>, Port<O>) -> Port<I> = |tag, steps, value| => boundary(tag, map(((|leaf| => prepend_flow(Flow {steps: steps}, leaf)) : fn(BoundaryLeaf) -> BoundaryLeaf), get(store_boundary(value), "leaves")), [])

let resolved_output: fn(Map<String, List<Edge>>, List<String>, StoredNode) -> StoredBoundary = |incoming, visited, node| => {
  let id = node_id(node)
  let own = get(node, "output")
  let edges = __map_get_or(incoming, id, ([]: List<Edge>))
  if (=)(count(get(own, "through")), 0) then own else if (=)(count(edges), 0) then own else if contains_string(visited, id) then fail(["transparent boundary cycle"]) else (((| | => {
    let upstream = map(((|edge| => resolved_output(incoming, concat(visited, [id]), get(edge, "from"))) : fn(Edge) -> StoredBoundary), edges)
    let joined = StoredBoundary {`type`: get(get(node, "input"), "type"), type_id: get(get(node, "input"), "type_id"), leaves: flat_map(((|value| => get(value, "leaves")) : fn(StoredBoundary) -> List<BoundaryLeaf>), upstream), through: flat_map(((|value| => get(value, "through")) : fn(StoredBoundary) -> List<Flow>), upstream)}
    substitute_output(joined, own)
  }) : fn() -> StoredBoundary))()
}
let resolved_edges: fn(List<Edge>) -> List<Edge> = |edges| => {
  let incoming = group_by(((|edge| => node_id(get(edge, "to"))) : fn(Edge) -> String), edges)
  map(((|edge| => {
    let from = get(edge, "from")
    let to = get(edge, "to")
    let output = resolved_output(incoming, [], from)
    Edge {from: stored_node_output(from, output), to: stored_node_output(to, resolved_output(incoming, [], to)), routes: unique_definitions(concat(get(edge, "routes"), boundary_routes(output, get(to, "input"))))}
  }) : fn(Edge) -> Edge), edges)
}
let external_route_occurrences: fn(List<Edge>) -> List<RouteOccurrence> = |edges| => flat_map(((|edge| => indexed_map(((|index, route| => RouteOccurrence {value: route, provenance: occurrence_provenance_for(str(get(get(edge, "from"), "id"), " -> ", get(get(edge, "to"), "id")), concat(route_logical_paths(get(get(edge, "from"), "nodes"), route), route_logical_paths(get(get(edge, "to"), "nodes"), route)), index)}) : fn(Int, StoredRoute) -> RouteOccurrence), get(edge, "routes"))) : fn(Edge) -> List<RouteOccurrence>), edges)
let boundary_unit: fn(StoredBoundary) -> Bool = |value| => serialized_equal(get(value, "type"), type_evidence(type_tag<Unit>()))
let root_shape_valid: fn(GraphAnalysis, StoredNode) -> Bool = |analysis, candidate| => if (=)(incoming_count(analysis, node_id(candidate)), 0) then boundary_unit(get(candidate, "input")) else true
let boundary_valid: fn(StoredNode) -> Bool = |candidate| => if not((=)(count(get(candidate, "messages")), 0)) then false else if role(candidate, "output") then if (=)(count(get(candidate, "actors")), 0) then (=)(count(get(candidate, "routes")), 0) else false else if role(candidate, "source") then boundary_unit(get(candidate, "input")) else role(candidate, "ordinary")
let bootstrap_message: fn(StoredPort) -> Message = |input| => stored_message(input, MessageContent<Unit> {kind: get(input, "wire"), value: nil})
let bootstrap_messages: fn(List<StoredPort>, List<StoredRoute>, List<Message>) -> List<Message> = |ports, routes, messages| => {
  let routes_by_input = group_by(((|route| => port_address_key(get(route, "to"))) : fn(StoredRoute) -> String), routes)
  let messages_by_input = group_by(((|message| => port_address_key(get(message, "to"))) : fn(Message) -> String), messages)
  map(bootstrap_message, filter(((|candidate| => input_needs_bootstrap(routes_by_input, messages_by_input, candidate)) : fn(StoredPort) -> Bool), ports))
}
let lower_route: fn(StoredRoute) -> LowerRoute = |value| => LowerRoute {id: get(value, "id"), from: get(value, "from"), to: get(value, "to"), transforms: get(value, "transforms")}
let terminal_output: fn(GraphAnalysis, StoredPort) -> Bool = |analysis, output| => not((=)(count(filter(((|leaf| => same_port_address(get(leaf, "port"), output)) : fn(BoundaryLeaf) -> Bool), flat_map(((|node| => get(get(node, "output"), "leaves")) : fn(StoredNode) -> List<BoundaryLeaf>), get(analysis, "outputs")))), 0))

let transform_output: fn(TypeDescriptor, Transform) -> TypeDescriptor = |input, step| => match step {
  case Unit(expected) => if descriptor_accepts(expected, input) then type_evidence(type_tag<Unit>()) else fail(["discard input type mismatch"]),
  case Project(spec) => if descriptor_accepts(get(spec, "input"), input) then if serialized_equal(item_at(type_components(get(spec, "input")), get(spec, "index")), get(spec, "output")) then get(spec, "output") else fail(["projection output type mismatch"]) else fail(["projection input type mismatch"]),
  case Pack(spec) => if descriptor_accepts(get(spec, "payload"), input) then if constructor_payload_matches(get(spec, "owner"), get(spec, "constructor"), get(spec, "payload")) then get(spec, "owner") else fail(["pack constructor mismatch"]) else fail(["pack input type mismatch"]),
  case Unpack(spec) => if descriptor_accepts(get(spec, "owner"), input) then if constructor_payload_matches(get(spec, "owner"), get(spec, "constructor"), get(spec, "payload")) then get(spec, "payload") else fail(["unpack constructor mismatch"]) else fail(["unpack input type mismatch"]),
  case Assemble(spec) => if descriptor_accepts(item_at(get(spec, "inputs"), get(spec, "slot")), input) then get(spec, "output") else fail(["assembly slot input type mismatch"]),
  case EmptyList(item) => list_type(item),
}
let transformed_type: fn(TypeDescriptor, List<Transform>) -> TypeDescriptor = |input, steps| => fold(transform_output, input, steps)
let route_valid: fn(GraphAnalysis, StoredRoute) -> Bool = |analysis, value| => if port_is_output(analysis, get(value, "from")) then if port_is_input(analysis, get(value, "to")) then descriptor_accepts(get(get(value, "to"), "type"), transformed_type(get(get(value, "from"), "type"), get(value, "transforms"))) else false else false
let actor_input_source_types: fn(GraphAnalysis, Actor) -> List<TypeDescriptor> = |analysis, candidate| => {
  let key = port_address_key(get(candidate, "input"))
  let incoming = __map_get_or(get(analysis, "routes_by_input"), key, ([]: List<StoredRoute>))
  let messages = __map_get_or(get(analysis, "messages_by_input"), key, ([]: List<Message>))
  unique_definitions(concat(map(((|route| => transformed_type(get(get(route, "from"), "type"), get(route, "transforms"))) : fn(StoredRoute) -> TypeDescriptor), incoming), map(((|message| => transformed_type(get(message, "semantic_type"), get(message, "transforms"))) : fn(Message) -> TypeDescriptor), messages)))
}
let actor_input_coverage_valid: fn(GraphAnalysis, Actor) -> Bool = |analysis, candidate| => descriptor_input_covered_by(get(get(candidate, "input"), "type"), actor_input_source_types(analysis, candidate))
let route_handler_types: fn(GraphAnalysis, StoredPort) -> List<TypeDescriptor> = |analysis, output| => map(((|route| => get(get(route, "from"), "type")) : fn(StoredRoute) -> TypeDescriptor), __map_get_or(get(analysis, "routes_by_output"), port_address_key(output), ([]: List<StoredRoute>)))

type IndexedItem<T> {index: Int, value: T}
let item_at<T>: fn(List<T>, Int) -> T = |values, index| => get(first(filter(((|entry| => (=)(get(entry, "index"), index)) : fn(IndexedItem<T>) -> Bool), indexed_map(((|position, value| => IndexedItem<T> {index: position, value: value}) : fn(Int, T) -> IndexedItem<T>), values))), "value")

// Cohort addresses are local to the consuming actor (or the result boundary).
// The downstream structural path distinguishes repeated equal-typed slots;
// neither producer identity nor descriptor equality assigns an occurrence.
let downstream_slots: fn(List<Transform>) -> List<Int> = |steps| => flat_map(((|step| => match step {
  case Assemble(spec) => [get(spec, "slot")],
  case Project(spec) => [get(spec, "index")],
  case Unit(value) => [],
  case Pack(value) => [],
  case Unpack(value) => [],
  case EmptyList(value) => [],
}) : fn(Transform) -> List<Int>), steps)
let normalize_transforms: fn(List<Transform>) -> List<Transform> = |steps| => if (=)(count(steps), 0) then [] else (((| | => {
  let tail = remove_at(steps, 0)
  let head = match first(steps) {
    case Assemble(spec) => named(Transform, Assemble, Assembly {inputs: get(spec, "inputs"), output: get(spec, "output"), slot: get(spec, "slot"), path: concat([count(tail)], downstream_slots(tail)), kind: get(spec, "kind")}),
    case Project(value) => named(Transform, Project, value),
    case Unit(value) => named(Transform, Unit, value),
    case Pack(value) => named(Transform, Pack, value),
    case Unpack(value) => named(Transform, Unpack, value),
    case EmptyList(value) => named(Transform, EmptyList, value),
  }
  concat([head], normalize_transforms(tail))
}) : fn() -> List<Transform>))()
let normalized_boundary: fn(StoredBoundary) -> StoredBoundary = |value| => StoredBoundary {`type`: get(value, "type"), type_id: get(value, "type_id"), leaves: map(((|leaf| => BoundaryLeaf {port: get(leaf, "port"), steps: normalize_transforms(get(leaf, "steps"))}) : fn(BoundaryLeaf) -> BoundaryLeaf), get(value, "leaves")), through: map(((|flow| => Flow {steps: normalize_transforms(get(flow, "steps"))}) : fn(Flow) -> Flow), get(value, "through"))}
let root_leaf_message: fn(BoundaryLeaf) -> Message = |leaf| => {
  let port = get(leaf, "port")
  let unit = type_evidence(type_tag<Unit>())
  Message {to: port, transforms: normalize_transforms(get(leaf, "steps")), semantic_type: unit, semantic_type_id: type_id(unit), content: pack(MessageContent<Unit> {kind: get(port, "wire"), value: nil})}
}
let root_messages: fn(List<StoredNode>, List<StoredRoute>, List<Message>) -> List<Message> = |roots, routes, messages| => {
  let destinations = concat(map(((|route| => port_address_key(get(route, "to"))) : fn(StoredRoute) -> String), routes), map(((|message| => port_address_key(get(message, "to"))) : fn(Message) -> String), messages))
  let leaves = flat_map(((|node| => get(get(node, "input"), "leaves")) : fn(StoredNode) -> List<BoundaryLeaf>), filter(((|node| => boundary_unit(get(node, "input"))) : fn(StoredNode) -> Bool), roots))
  map(root_leaf_message, filter(((|leaf| => not(contains_string(destinations, port_address_key(get(leaf, "port")))) ) : fn(BoundaryLeaf) -> Bool), leaves))
}

type AssemblyOccurrence {destination: String, spec: Assembly}
let assembly_occurrences: fn(String, List<Transform>) -> List<AssemblyOccurrence> = |destination, steps| => flat_map(((|step| => match step {
  case Assemble(spec) => [AssemblyOccurrence {destination: destination, spec: spec}],
  case Unit(value) => [], case Project(value) => [], case Pack(value) => [], case Unpack(value) => [], case EmptyList(value) => [],
}) : fn(Transform) -> List<AssemblyOccurrence>), normalize_transforms(steps))
let assembly_key: fn(AssemblyOccurrence) -> String = |value| => canonical([get(value, "destination"), canonical(get(get(value, "spec"), "path"))])
let assembly_shape_valid: fn(Assembly) -> Bool = |spec| => {
  let slot_types = get(spec, "inputs")
  let output = get(spec, "output")
  if (=)(get(spec, "kind"), "product") then if (=)(count(slot_types), 2) then if (=)(type_constructor(output), "") then serialized_equal(type_components(output), slot_types) else false else false else if (=)(get(spec, "kind"), "list") then if (=)(count(slot_types), 0) then false else if serialized_equal(output, list_type(first(slot_types))) then (=)(count(unique_definitions(slot_types)), 1) else false else false
}
let assembly_group_valid: fn(List<AssemblyOccurrence>) -> Bool = |values| => {
  let spec = get(first(values), "spec")
  let slot_types = get(spec, "inputs")
  let expected = indexed_map(((|index, input| => index) : fn(Int, TypeDescriptor) -> Int), slot_types)
  let slots = unique_definitions(map(((|value| => get(get(value, "spec"), "slot")) : fn(AssemblyOccurrence) -> Int), values))
  let consistent = filter(((|value| => not(serialized_equal(assoc(get(value, "spec"), "slot", 0), assoc(spec, "slot", 0)))) : fn(AssemblyOccurrence) -> Bool), values)
  if assembly_shape_valid(spec) then if (=)(count(consistent), 0) then definition_set_equal(expected, slots) else false else false
}
let assembly_errors: fn(GraphAnalysis) -> List<String> = |analysis| => {
  let routes = flat_map(((|route| => assembly_occurrences(str("actor:", port_address_key(get(route, "to"))), get(route, "transforms"))) : fn(StoredRoute) -> List<AssemblyOccurrence>), get(analysis, "routes"))
  let messages = flat_map(((|message| => assembly_occurrences(str("actor:", port_address_key(get(message, "to"))), get(message, "transforms"))) : fn(Message) -> List<AssemblyOccurrence>), get(analysis, "messages"))
  let results = flat_map(((|node| => {
    let output = get(node, "output")
    concat(flat_map(((|leaf| => assembly_occurrences("result", get(leaf, "steps"))) : fn(BoundaryLeaf) -> List<AssemblyOccurrence>), get(output, "leaves")), flat_map(((|flow| => assembly_occurrences("result", get(flow, "steps"))) : fn(Flow) -> List<AssemblyOccurrence>), get(output, "through")))
  }) : fn(StoredNode) -> List<AssemblyOccurrence>), get(analysis, "outputs"))
  let all = concat(routes, concat(messages, results))
  let grouped = group_by(assembly_key, all)
  let invalid = filter(((|key| => not(assembly_group_valid(core.map.get(grouped, key)))) : fn(String) -> Bool), ordered_strings(map(assembly_key, all)))
  map(((|key| => str("invalid or incomplete destination assembly: ", key)) : fn(String) -> String), invalid)
}
let transform_descriptors: fn(Transform) -> List<TypeDescriptor> = |step| => match step {
  case Unit(input) => [input, type_evidence(type_tag<Unit>())],
  case Project(spec) => [get(spec, "input"), get(spec, "output")],
  case Pack(spec) => [get(spec, "owner"), get(spec, "payload")],
  case Unpack(spec) => [get(spec, "owner"), get(spec, "payload")],
  case Assemble(spec) => concat(get(spec, "inputs"), [get(spec, "output")]),
  case EmptyList(item) => [item, list_type(item)],
}
let boundary_descriptors: fn(StoredBoundary) -> List<TypeDescriptor> = |value| => concat([get(value, "type")], concat(flat_map(((|leaf| => concat([get(get(leaf, "port"), "type")], flat_map(transform_descriptors, get(leaf, "steps")))) : fn(BoundaryLeaf) -> List<TypeDescriptor>), get(value, "leaves")), flat_map(((|flow| => flat_map(transform_descriptors, get(flow, "steps"))) : fn(Flow) -> List<TypeDescriptor>), get(value, "through"))))

let stored_node_output: fn(StoredNode, StoredBoundary) -> StoredNode = |value, output| => StoredNode {id: get(value, "id"), role: get(value, "role"), actors: get(value, "actors"), routes: get(value, "routes"), messages: get(value, "messages"), operations: get(value, "operations"), nodes: get(value, "nodes"), occurrences: get(value, "occurrences"), executions: get(value, "executions"), input: get(value, "input"), output: output}
let message_valid: fn(GraphAnalysis, Message) -> Bool = |analysis, value| => if port_is_input(analysis, get(value, "to")) then if serialized_equal(get(value, "semantic_type_id"), type_id(get(value, "semantic_type"))) then descriptor_accepts(get(get(value, "to"), "type"), transformed_type(get(value, "semantic_type"), get(value, "transforms"))) else false else false
let result_value_valid: fn(StoredBoundary) -> Bool = |value| => {
  let expected = get(value, "type")
  let bad_leaves = filter(((|leaf| => not(descriptor_accepts(expected, transformed_type(get(get(leaf, "port"), "type"), get(leaf, "steps"))))) : fn(BoundaryLeaf) -> Bool), get(value, "leaves"))
  let bad_flows = filter(((|flow| => not(descriptor_accepts(expected, transformed_type(type_evidence(type_tag<Unit>()), get(flow, "steps"))))) : fn(Flow) -> Bool), get(value, "through"))
  if (=)(count(bad_leaves), 0) then (=)(count(bad_flows), 0) else false
}
