import core.types.{}

import nefor.graph.{}
import nefor.mag.{}

// Public node composition. Fixed combinators are anonymous topology junctions;
// only capability and dynamic-cardinality work is represented by actors.
let composite_id: fn(String, String, String) -> String = |left, operator, right| => {
  let left_part = str(str(count(left), ":"), left)
  let operator_part = str(str(count(operator), ":"), operator)
  let right_part = str(str(count(right), ":"), right)
  str("nefor.node.composite:", str(left_part, str(operator_part, right_part)))
}

let compound_nodes: fn(String, List<nefor.graph.Actor>, List<nefor.graph.LogicalNode>) -> List<nefor.graph.LogicalNode> = |name, owned, children| => concat([nefor.graph.logical_node([name], nefor.graph.actor_ids(owned))], nefor.graph.prefix_logical_nodes(name, children))
let transparent_child_occurrences<I, O>: fn(String, Int, nefor.graph.Node<I, O>) -> List<nefor.graph.DefinitionOccurrence> = |parent, position, child| => nefor.graph.place_occurrences(parent, position, get(child, "occurrences"))
let compound_child_occurrences<I, O>: fn(String, Int, nefor.graph.Node<I, O>) -> List<nefor.graph.DefinitionOccurrence> = |parent, position, child| => nefor.graph.prefix_occurrences(parent, transparent_child_occurrences(parent, position, child))
let transparent_child_executions<I, O>: fn(String, Int, nefor.graph.Node<I, O>) -> List<nefor.graph.ExecutionOccurrence> = |parent, position, child| => nefor.graph.place_executions(parent, position, nefor.graph.node_execution_occurrences(child))
let compound_child_executions<I, O>: fn(String, Int, nefor.graph.Node<I, O>) -> List<nefor.graph.ExecutionOccurrence> = |parent, position, child| => nefor.graph.prefix_executions(parent, transparent_child_executions(parent, position, child))

let named<I, O>: fn(String, nefor.graph.Node<I, O>) -> nefor.graph.Node<I, O> = |name, value| => nefor.graph.node_with_occurrences_and_nodes_and_junctions(get(value, "id"), get(value, "role"), get(value, "actors"), get(value, "junctions"), get(value, "routes"), get(value, "messages"), get(value, "operations"), compound_nodes(name, [], get(value, "nodes")), nefor.graph.prefix_occurrences(name, get(value, "occurrences")), nefor.graph.prefix_executions(name, get(value, "executions")), get(value, "input"), get(value, "output"))
let rename_path_root: fn(String, nefor.graph.LogicalNode) -> nefor.graph.LogicalNode = |name, value| => nefor.graph.logical_node(concat([name], remove_at(get(value, "path"), 0)), get(value, "members"))
let rename<I, O>: fn(String, nefor.graph.Node<I, O>) -> nefor.graph.Node<I, O> = |name, value| => nefor.graph.node_with_occurrences_and_nodes_and_junctions(get(value, "id"), get(value, "role"), get(value, "actors"), get(value, "junctions"), get(value, "routes"), get(value, "messages"), get(value, "operations"), map(((|candidate| => rename_path_root(name, candidate)) : fn(nefor.graph.LogicalNode) -> nefor.graph.LogicalNode), get(value, "nodes")), nefor.graph.rename_occurrences(name, get(value, "occurrences")), nefor.graph.rename_executions(name, get(value, "executions")), get(value, "input"), get(value, "output"))

let sequential_role<A, B, C>: fn(nefor.graph.Node<A, B>, nefor.graph.Node<B, C>) -> String = |left, right| => if (=)(get(left, "role"), "source") then "source" else "ordinary"
let compose<A, B, C>: fn(String, nefor.graph.Node<A, B>, nefor.graph.Node<B, C>) -> nefor.graph.Node<A, C> = |id, left, right| => nefor.graph.node_with_occurrences_and_nodes_and_junctions(id, sequential_role(left, right), concat(get(left, "actors"), get(right, "actors")), concat(get(left, "junctions"), get(right, "junctions")), concat(concat(get(left, "routes"), get(right, "routes")), [nefor.graph.stored_route(get(left, "output"), get(right, "input"))]), concat(get(left, "messages"), get(right, "messages")), concat(get(left, "operations"), get(right, "operations")), concat(get(left, "nodes"), get(right, "nodes")), concat(transparent_child_occurrences(id, 0, left), transparent_child_occurrences(id, 1, right)), concat(transparent_child_executions(id, 0, left), transparent_child_executions(id, 1, right)), get(left, "input"), get(right, "output"))
let (>>>)<A, B, C>: fn(nefor.graph.Node<A, B>, nefor.graph.Node<B, C>) -> nefor.graph.Node<A, C> = |left, right| => compose(composite_id(get(left, "id"), ">>>", get(right, "id")), left, right)

let unary_junction_node<I, O>: fn(String, nefor.graph.JunctionOperation, nefor.graph.Port<I>, nefor.graph.Port<O>) -> nefor.graph.Node<I, O> = |id, operation, input, output| => nefor.graph.node_with_junctions(id, "ordinary", [], [nefor.graph.junction(id, operation, [nefor.graph.store_port(input)], [nefor.graph.store_port(output)])], [], [], input, output)

let discard<T>: fn(String) -> nefor.graph.Node<T, Unit> = |id| => unary_junction_node(id, nefor.graph.unit_operation, nefor.graph.junction_port(id, type_tag<T>(), "nefor.node.DiscardInput"), nefor.graph.junction_port(id, type_tag<Unit>(), "mag.Unit"))
let then<I, A, B>: fn(String, nefor.graph.Node<I, A>, nefor.graph.Node<Unit, B>) -> nefor.graph.Node<I, B> = |id, left, right| => {
  let discarded: nefor.graph.Node<I, Unit> = compose(str(id, ".discarded"), left, discard<A>(str(id, ".discard")))
  compose(id, discarded, right)
}
let (*>)<I, A, B>: fn(nefor.graph.Node<I, A>, nefor.graph.Node<Unit, B>) -> nefor.graph.Node<I, B> = |left, right| => then(composite_id(get(left, "id"), "*>", get(right, "id")), left, right)

let keep_left<A, B>: fn(String) -> nefor.graph.Node<(A, B), A> = |id| => unary_junction_node(id, nefor.graph.product_first_operation, nefor.graph.junction_port(id, type_tag<(A, B)>(), "nefor.node.ProductInput"), nefor.graph.junction_port(id, type_tag<A>(), "nefor.node.ProductLeft"))
let before<I, A, B>: fn(String, nefor.graph.Node<I, A>, nefor.graph.Node<Unit, B>) -> nefor.graph.Node<I, A> = |id, left, right| => {
  let retained: nefor.graph.Node<A, A> = nefor.graph.identity<A>(str(id, ".retained"))
  let triggered: nefor.graph.Node<A, B> = then(str(id, ".right"), discard<A>(str(id, ".trigger")), right)
  let completed: nefor.graph.Node<A, (A, B)> = fanout(str(id, ".completed"), retained, triggered)
  let after_left: nefor.graph.Node<I, (A, B)> = compose(str(id, ".after-left"), left, completed)
  compose(id, after_left, keep_left<A, B>(str(id, ".result")))
}
let (<*)<I, A, B>: fn(nefor.graph.Node<I, A>, nefor.graph.Node<Unit, B>) -> nefor.graph.Node<I, A> = |left, right| => before(composite_id(get(left, "id"), "<*", get(right, "id")), left, right)

let fanout<I, A, B>: fn(String, nefor.graph.Node<I, A>, nefor.graph.Node<I, B>) -> nefor.graph.Node<I, (A, B)> = |id, left, right| => {
  let input_id = str(id, ".input")
  let input_in = nefor.graph.junction_port(input_id, type_tag<I>(), "input")
  let input_out = nefor.graph.junction_port(input_id, type_tag<I>(), "output")
  let input = nefor.graph.junction(input_id, nefor.graph.pass_operation, [nefor.graph.store_port(input_in)], [nefor.graph.store_port(input_out)])
  let output_id = str(id, ".output")
  let left_slot = nefor.graph.junction_port(output_id, type_tag<A>(), "slot:0")
  let right_slot = nefor.graph.junction_port(output_id, type_tag<B>(), "slot:1")
  let output = nefor.graph.junction_port(output_id, type_tag<(A, B)>(), "output")
  let join = nefor.graph.junction(output_id, nefor.graph.product_join_operation, [nefor.graph.store_port(left_slot), nefor.graph.store_port(right_slot)], [nefor.graph.store_port(output)])
  nefor.graph.node_with_occurrences_and_nodes_and_junctions(id, "ordinary", concat(get(left, "actors"), get(right, "actors")), concat([input, join], concat(get(left, "junctions"), get(right, "junctions"))), concat(concat(get(left, "routes"), get(right, "routes")), [nefor.graph.stored_route(input_out, get(left, "input")), nefor.graph.stored_route(input_out, get(right, "input")), nefor.graph.stored_route(get(left, "output"), left_slot), nefor.graph.stored_route(get(right, "output"), right_slot)]), concat(get(left, "messages"), get(right, "messages")), concat(get(left, "operations"), get(right, "operations")), compound_nodes(id, [], concat(get(left, "nodes"), get(right, "nodes"))), concat(compound_child_occurrences(id, 0, left), compound_child_occurrences(id, 1, right)), concat(compound_child_executions(id, 0, left), compound_child_executions(id, 1, right)), input_in, output)
}
let (&&&)<I, A, B>: fn(nefor.graph.Node<I, A>, nefor.graph.Node<I, B>) -> nefor.graph.Node<I, (A, B)> = |left, right| => fanout(composite_id(get(left, "id"), "&&&", get(right, "id")), left, right)

let parallel<A, B, C, D>: fn(String, nefor.graph.Node<A, B>, nefor.graph.Node<C, D>) -> nefor.graph.Node<(A, C), (B, D)> = |id, left, right| => {
  let split_id = str(id, ".input")
  let split_input = nefor.graph.junction_port(split_id, type_tag<(A, C)>(), "input")
  let split_left = nefor.graph.junction_port(split_id, type_tag<A>(), "left")
  let split_right = nefor.graph.junction_port(split_id, type_tag<C>(), "right")
  let split = nefor.graph.junction(split_id, nefor.graph.product_split_operation, [nefor.graph.store_port(split_input)], [nefor.graph.store_port(split_left), nefor.graph.store_port(split_right)])
  let join_id = str(id, ".output")
  let left_slot = nefor.graph.junction_port(join_id, type_tag<B>(), "slot:0")
  let right_slot = nefor.graph.junction_port(join_id, type_tag<D>(), "slot:1")
  let output = nefor.graph.junction_port(join_id, type_tag<(B, D)>(), "output")
  let join = nefor.graph.junction(join_id, nefor.graph.product_join_operation, [nefor.graph.store_port(left_slot), nefor.graph.store_port(right_slot)], [nefor.graph.store_port(output)])
  nefor.graph.node_with_occurrences_and_nodes_and_junctions(id, "ordinary", concat(get(left, "actors"), get(right, "actors")), concat([split, join], concat(get(left, "junctions"), get(right, "junctions"))), concat(concat(get(left, "routes"), get(right, "routes")), [nefor.graph.stored_route(split_left, get(left, "input")), nefor.graph.stored_route(split_right, get(right, "input")), nefor.graph.stored_route(get(left, "output"), left_slot), nefor.graph.stored_route(get(right, "output"), right_slot)]), concat(get(left, "messages"), get(right, "messages")), concat(get(left, "operations"), get(right, "operations")), compound_nodes(id, [], concat(get(left, "nodes"), get(right, "nodes"))), concat(compound_child_occurrences(id, 0, left), compound_child_occurrences(id, 1, right)), concat(compound_child_executions(id, 0, left), compound_child_executions(id, 1, right)), split_input, output)
}
let (***)<A, B, C, D>: fn(nefor.graph.Node<A, B>, nefor.graph.Node<C, D>) -> nefor.graph.Node<(A, C), (B, D)> = |left, right| => parallel(composite_id(get(left, "id"), "***", get(right, "id")), left, right)

let pack_adt<T, O>: fn(String, String) -> nefor.graph.Node<T, O> = |id, constructor| => {
  let input = nefor.graph.junction_port(id, type_tag<T>(), "payload")
  let output = nefor.graph.junction_port(id, type_tag<O>(), "value")
  unary_junction_node(id, nefor.graph.adt_pack_operation(nefor.mag.AdtPackSpec {owner: type_evidence(type_tag<O>()), payload: type_evidence(type_tag<T>()), constructor: constructor}), input, output)
}

let choose_adt<I, O, A, B, C, D>: fn(String, String, String, nefor.graph.Node<A, C>, nefor.graph.Node<B, D>) -> nefor.graph.Node<I, O> = |id, first_constructor, second_constructor, left, right| => {
  let split_id = str(id, ".split")
  let input = nefor.graph.junction_port(split_id, type_tag<I>(), "value")
  let split_left = nefor.graph.junction_port(split_id, type_tag<A>(), first_constructor)
  let split_right = nefor.graph.junction_port(split_id, type_tag<B>(), second_constructor)
  let split = nefor.graph.junction(split_id, nefor.graph.adt_unpack_operation(nefor.mag.AdtUnpackSpec {owner: type_evidence(type_tag<I>()), branches: [nefor.mag.AdtBranch {constructor: first_constructor, payload: type_evidence(type_tag<A>()), wire: first_constructor}, nefor.mag.AdtBranch {constructor: second_constructor, payload: type_evidence(type_tag<B>()), wire: second_constructor}]}), [nefor.graph.store_port(input)], [nefor.graph.store_port(split_left), nefor.graph.store_port(split_right)])
  let lift_left = pack_adt<C, O>(str(id, ".left"), first_constructor)
  let lift_right = pack_adt<D, O>(str(id, ".right"), second_constructor)
  let output_node = nefor.graph.identity<O>(str(id, ".output"))
  nefor.graph.node_with_occurrences_and_nodes_and_junctions(id, "ordinary", concat(get(left, "actors"), get(right, "actors")), concat([split], concat(get(left, "junctions"), concat(get(right, "junctions"), concat(get(lift_left, "junctions"), concat(get(lift_right, "junctions"), get(output_node, "junctions")))))), concat(get(left, "routes"), concat(get(right, "routes"), concat(get(lift_left, "routes"), concat(get(lift_right, "routes"), concat(get(output_node, "routes"), [nefor.graph.stored_route(split_left, get(left, "input")), nefor.graph.stored_route(split_right, get(right, "input")), nefor.graph.stored_route(get(left, "output"), get(lift_left, "input")), nefor.graph.stored_route(get(right, "output"), get(lift_right, "input")), nefor.graph.stored_route(get(lift_left, "output"), get(output_node, "input")), nefor.graph.stored_route(get(lift_right, "output"), get(output_node, "input"))]))))), concat(get(left, "messages"), get(right, "messages")), concat(get(left, "operations"), get(right, "operations")), compound_nodes(id, [], concat(get(left, "nodes"), get(right, "nodes"))), concat(compound_child_occurrences(id, 0, left), compound_child_occurrences(id, 1, right)), concat(compound_child_executions(id, 0, left), compound_child_executions(id, 1, right)), input, get(output_node, "output"))
}

let choose<A, B, C, D>: fn(String, nefor.graph.Node<A, C>, nefor.graph.Node<B, D>) -> nefor.graph.Node<core.types.Either<A, B>, core.types.Either<C, D>> = |id, left, right| => choose_adt<core.types.Either<A, B>, core.types.Either<C, D>, A, B, C, D>(id, "Left", "Right", left, right)
let (+++)<A, B, C, D>: fn(nefor.graph.Node<A, C>, nefor.graph.Node<B, D>) -> nefor.graph.Node<core.types.Either<A, B>, core.types.Either<C, D>> = |left, right| => choose(composite_id(get(left, "id"), "+++", get(right, "id")), left, right)

let sequence_id<I, O>: fn(List<nefor.graph.Node<I, O>>) -> String = |nodes| => fold(((|id, candidate| => composite_id(id, "sequence", get(candidate, "id"))) : fn(String, nefor.graph.Node<I, O>) -> String), "nefor.node.sequence", nodes)
let sequence_nonempty<I, O>: fn(String, List<nefor.graph.Node<I, O>>) -> nefor.graph.Node<I, List<O>> = |id, nodes| => {
  let first_node = first(nodes)
  let relay = nefor.graph.identity<I>(str(id, ".input"))
  let collector_id = str(id, ".collector")
  let slots = indexed_map(((|index, candidate| => nefor.graph.junction_port(collector_id, type_tag<O>(), str("slot:", str(index)))) : fn(Int, nefor.graph.Node<I, O>) -> nefor.graph.Port<O>), nodes)
  let output = nefor.graph.junction_port(collector_id, type_tag<List<O>>(), "output")
  let collector = nefor.graph.junction(collector_id, nefor.graph.collect_operation, map(((|slot| => nefor.graph.store_port(slot)) : fn(nefor.graph.Port<O>) -> nefor.graph.StoredPort), slots), [nefor.graph.store_port(output)])
  let child_actors = flat_map(((|candidate| => get(candidate, "actors")) : fn(nefor.graph.Node<I, O>) -> List<nefor.graph.Actor>), nodes)
  let child_junctions = flat_map(((|candidate| => get(candidate, "junctions")) : fn(nefor.graph.Node<I, O>) -> List<nefor.graph.Junction>), nodes)
  let child_routes = flat_map(((|candidate| => get(candidate, "routes")) : fn(nefor.graph.Node<I, O>) -> List<nefor.graph.StoredRoute>), nodes)
  let child_messages = flat_map(((|candidate| => get(candidate, "messages")) : fn(nefor.graph.Node<I, O>) -> List<nefor.graph.Message>), nodes)
  let child_operations = flat_map(((|candidate| => get(candidate, "operations")) : fn(nefor.graph.Node<I, O>) -> List<nefor.mag.ProgramOperation>), nodes)
  let child_occurrences = flat_map(((|group| => group) : fn(List<nefor.graph.DefinitionOccurrence>) -> List<nefor.graph.DefinitionOccurrence>), indexed_map(((|index, candidate| => compound_child_occurrences(id, index, candidate)) : fn(Int, nefor.graph.Node<I, O>) -> List<nefor.graph.DefinitionOccurrence>), nodes))
  let child_executions = flat_map(((|group| => group) : fn(List<nefor.graph.ExecutionOccurrence>) -> List<nefor.graph.ExecutionOccurrence>), indexed_map(((|index, candidate| => compound_child_executions(id, index, candidate)) : fn(Int, nefor.graph.Node<I, O>) -> List<nefor.graph.ExecutionOccurrence>), nodes))
  let input_routes = map(((|candidate| => nefor.graph.stored_route(get(relay, "output"), get(candidate, "input"))) : fn(nefor.graph.Node<I, O>) -> nefor.graph.StoredRoute), nodes)
  let indexed_nodes = indexed_map(((|index, candidate| => nefor.graph.stored_route(get(candidate, "output"), nefor.graph.junction_port(collector_id, type_tag<O>(), str("slot:", str(index))))) : fn(Int, nefor.graph.Node<I, O>) -> nefor.graph.StoredRoute), nodes)
  nefor.graph.node_with_occurrences_and_nodes_and_junctions(id, "ordinary", child_actors, concat(get(relay, "junctions"), concat(child_junctions, [collector])), concat(get(relay, "routes"), concat(child_routes, concat(input_routes, indexed_nodes))), concat(get(relay, "messages"), child_messages), concat(get(relay, "operations"), child_operations), compound_nodes(id, [], flat_map(((|candidate| => get(candidate, "nodes")) : fn(nefor.graph.Node<I, O>) -> List<nefor.graph.LogicalNode>), nodes)), child_occurrences, child_executions, get(relay, "input"), output)
}
let sequence<I, O>: fn(List<nefor.graph.Node<I, O>>) -> nefor.graph.Node<I, List<O>> = |nodes| => sequence_nonempty(sequence_id(nodes), nodes)
