// Asking the person running the workflow to decide. This is a workflow step,
// separate from the approval of an agent's tool calls.
import nefor.capability.{}

import nefor.contracts.{}

import nefor.graph.{}

// The text the person approved, as they left it.
type HumanWorkflowApproval {content: String}

type HumanWorkflowRejection {reason: String}

type HumanWorkflowDecision = Approved(HumanWorkflowApproval) | Rejected(HumanWorkflowRejection)

// prompt is the label shown with the request.
type ApprovalConfig {prompt: String}

// A node that shows the incoming text to the person and waits for their
// decision.
let approval_gate: fn(String, ApprovalConfig) -> nefor.graph.Node<nefor.contracts.TextAnswer, HumanWorkflowDecision> = |id, config| =>
  nefor.capability.human_approval<HumanWorkflowDecision>(id, get(config, "prompt"))
