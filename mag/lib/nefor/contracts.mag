// The data that workflows exchange with agents and commands: what an agent
// takes and returns, how its tool calls are approved, and what a command
// produces. Types only; the nodes that use them are in the other nefor
// modules.

// The output type of an agent that answers in plain text. With any other
// output type the agent returns a value of that type.
newtype TextAnswer = String

// A ready-made input turn for an agent. An agent whose input type is
// ProviderInput receives the content as it is; any other input type is
// presented to the agent as its task.
type ProviderInput {content: JsonValue}

// A string that may be absent: value is meaningful only when present is true.
type OptionalIdentifier {present: Bool, value: String}

// What the model provider reported when a request failed.
type ProviderError {message: String, detail: OptionalIdentifier}

// Why an agent ended without a result.
type AgentErrorReason = ProviderError(ProviderError)

// The Error side of every agent's Result: the reason, and the last output
// the agent drafted before it stopped (JSON null when there was none).
type AgentError {last_output: JsonValue, reason: AgentErrorReason}

// What an agent may do with its tools, from the narrowest policy to the widest.
// The constructors are declared in that order: ReadOnly < Default. The runtime
// compares policies by this order (lua/libs/tool/approval.lua repeats it once
// for the gate and the workflow runner).
//
// ReadOnly: the agent may only read. A tool call that writes or has other
// effects is rejected, in every permission mode, and so is a workflow that
// declares such nodes or an agent with a wider policy.
// Default: the runtime's configured approval behaviour for the current
// permission mode, never a bypass.
type ToolApprovalPolicy = ReadOnly | Default

// How long a command may run. A bounded value must be strictly positive.
type Timeout = Unlimited | Milliseconds(Int) | Seconds(Int) | Minutes(Int)

// A command that ended by itself, with its exit code.
type ProcessExited {code: Int}

// A command that was ended by a signal.
type ProcessSignaled {signal: Int}

type ProcessTermination = ProcessExited(ProcessExited) | ProcessSignaled(ProcessSignaled)

// What a command produced. A non-zero exit code is still a ProcessResult, not
// a failure of the workflow.
type ProcessResult {stdout: String, stderr: String, termination: ProcessTermination}

let no_identifier: fn() -> OptionalIdentifier = | | => OptionalIdentifier {present: false, value: ""}

let identifier: fn(String) -> OptionalIdentifier = |value| => OptionalIdentifier {present: true, value: value}

// Shared authoring policy; provider settings remain separate. Disabled carries
// explicit Unit so its serialized payload remains null.
type CompactionThresholds {soft_percent: Float, step_percent: Float, hard_percent: Float}
type CompactionPolicy = Disabled(Unit) | Thresholds(CompactionThresholds)
let disabled_compaction = CompactionPolicy.Disabled(nil)
