import core.types.{}

import nefor.graph.{}

import nefor.mag.{}

import nefor.contracts.{}

import nefor.dynamic.{}

let adapter_factory = "nefor.factory.adapter"

let llm_factory = "nefor.factory.llm"

let structured_output_factory = "nefor.factory.structured-output"

let run_tool_factory = "nefor.factory.run-tool"

let tool_result_factory = "nefor.factory.tool-result"

let retry_gate_factory = "nefor.factory.retry-gate"

type AdapterParams {seed: String, schema: TypeSchema}

type OptionalReasoningEffort {present: Bool, value: String}

type OptionalModelProfile {present: Bool, value: String}

let reasoning_effort: fn(String) -> OptionalReasoningEffort = |value| => OptionalReasoningEffort {present: true, value: value}

let no_reasoning_effort = OptionalReasoningEffort {present: false, value: ""}

type ModelProfile {name: String}

let model_profile: fn(String) -> ModelProfile = |name| => ModelProfile {name: name}

let no_model_profile = OptionalModelProfile {present: false, value: ""}

let selected_model_profile: fn(ModelProfile) -> OptionalModelProfile = |profile| => OptionalModelProfile {present: true, value: get(profile, "name")}

type ResolvedModel {provider: String, model: String, reasoning_effort: OptionalReasoningEffort}

type AuthoredModel = ResolvedModel(ResolvedModel) | ModelProfile(ModelProfile)

type LlmParams {model: String, provider: String, reasoning_effort: OptionalReasoningEffort, model_profile: OptionalModelProfile, system: String, tools: List<String>, output_type: SemanticTypeId, error_type: SemanticTypeId, provider_error_type: SemanticTypeId}

type StructuredOutputParams {model: String, provider: String, reasoning_effort: OptionalReasoningEffort, model_profile: OptionalModelProfile, system: String, tools: List<String>, schema: TypeSchema, output_type: SemanticTypeId, error_type: SemanticTypeId, provider_error_type: SemanticTypeId, dynamic: Bool, dynamic_item_type: SemanticTypeId, dynamic_item_descriptor: TypeDescriptor}

type RunToolParams {model: String, provider: String, model_profile: OptionalModelProfile, conversation_peer: String, tools: List<String>, tool_approval_policy: nefor.contracts.ToolApprovalRuntimeRules}

type ToolResultParams {}

type RetryGateParams {max_retries: Int}

type AgentConfig<M> {model: M, system: String, tools: List<String>, tool_approval_policy: nefor.contracts.ToolApprovalPolicy}

type RetryGateConfig {max_retries: Int}

// Every agent has one public nominal Result<AgentError, O> port. Workflows
// continue successful values with the ordinary result combinators and preserve
// AgentError as an explicit alternative.
// The output descriptor selects the protocol; callers cannot mix schemas,
// item evidence and runtime output contracts independently.
type OrdinaryOutput {schema: TypeSchema, descriptor: TypeDescriptor}
type DynamicOutput {schema: TypeSchema, item: TypeDescriptor}
type OutputContract = Ordinary(OrdinaryOutput) | Dynamic(DynamicOutput)

let dynamic_output_contract: fn(TypeDescriptor) -> OutputContract = |descriptor| => {
  let arguments = type_arguments(descriptor)
  let item = first(arguments)
  if (=)(count(arguments), 1) then OutputContract.Dynamic(DynamicOutput {schema: descriptor_schema(list_type(item)), item: item}) else fail(["DynamicList output requires exactly one concrete argument"])
}

let output_contract: fn(TypeDescriptor) -> OutputContract = |descriptor| => {
  let dynamic_constructor = type_constructor(type_evidence(type_tag<nefor.dynamic.DynamicList<Unit>>()))
  if (=)(type_constructor(descriptor), dynamic_constructor) then dynamic_output_contract(descriptor) else OutputContract.Ordinary(OrdinaryOutput {schema: descriptor_schema(descriptor), descriptor: descriptor})
}

let agent<M, I, O>: fn(String, fn(M) -> AuthoredModel, AgentConfig<M>) -> nefor.graph.Node<I, core.types.Result<nefor.contracts.AgentError, O>> = |id, resolve_model, config| => {
  let input_type = type_tag<I>()
  let output_type = type_tag<O>()
  let contract = output_contract(type_evidence(output_type))
  let schema = match contract {case Ordinary(value) => get(value, "schema"), case Dynamic(value) => get(value, "schema")}
  let dynamic = match contract {case Ordinary(value) => false, case Dynamic(value) => true}
  let dynamic_item_descriptor = match contract {case Ordinary(value) => get(value, "descriptor"), case Dynamic(value) => get(value, "item")}
  let dynamic_item_type = type_id(dynamic_item_descriptor)
  let authored_model = resolve_model(get(config, "model"))
  let resolved_model = match authored_model { case ResolvedModel(value) => value, case ModelProfile(value) => ResolvedModel {provider: "", model: "", reasoning_effort: no_reasoning_effort} }
  let selected_profile = match authored_model { case ResolvedModel(value) => no_model_profile, case ModelProfile(value) => selected_model_profile(value) }
  let entry_id = str(id, ".entry")
  let llm_id = str(id, ".llm")
  let run_tool_id = str(id, ".run-tool")
  let tool_result_id = str(id, ".tool-result")
  // ProviderInput is already a complete provider turn, so it continues
  // unchanged. Every other semantic type starts a fresh typed user turn.
  // The runtime wire is derived here and is not part of the authoring API.
  let input_wire = if (=)(canonical(type_id(type_evidence(input_type))), canonical(type_id(type_evidence(type_tag<nefor.contracts.ProviderInput>())))) then "generic-provider.ProviderOut" else "nefor.agent.Input"
  let entry_in = nefor.graph.port(entry_id, input_type, input_wire)
  let entry_out = nefor.graph.port(entry_id, type_tag<nefor.contracts.ProviderInput>(), "generic-provider.ProviderOut")
  let llm_in = nefor.graph.port(llm_id, type_tag<nefor.contracts.ProviderInput>(), "generic-provider.ProviderOut")
  let tool_calls = nefor.graph.port(llm_id, type_tag<nefor.contracts.ToolCalls>(), "generic-tool.ToolCalls")
  let result = nefor.graph.port(llm_id, type_tag<core.types.Result<nefor.contracts.AgentError, O>>(), "nefor.agent.Result")
  let run_in = nefor.graph.port(run_tool_id, type_tag<nefor.contracts.ToolCalls>(), "generic-tool.ToolCalls")
  let run_out = nefor.graph.port(run_tool_id, type_tag<nefor.contracts.ToolHandle>(), "generic-tool.ToolHandle")
  let result_in = nefor.graph.port(tool_result_id, type_tag<nefor.contracts.ToolHandle>(), "generic-tool.ToolHandle")
  let result_out = nefor.graph.port(tool_result_id, type_tag<nefor.contracts.ProviderInput>(), "generic-provider.ProviderOut")
  nefor.graph.node_with_operations_and_nodes(id, "ordinary", [nefor.graph.closed_actor(entry_id, adapter_factory, [type_evidence(input_type)], AdapterParams {seed: "provider-in", schema: type_schema(input_type)}, nefor.graph.store_port(entry_in), [nefor.graph.store_port(entry_out)], []), if if not(dynamic) then (=)(canonical(type_id(type_evidence(output_type))), canonical(type_id(type_evidence(type_tag<nefor.contracts.TextAnswer>())))) else false then nefor.graph.closed_actor(llm_id, llm_factory, [type_evidence(type_tag<core.types.Result<nefor.contracts.AgentError, O>>())], LlmParams {model: get(resolved_model, "model"), provider: get(resolved_model, "provider"), reasoning_effort: get(resolved_model, "reasoning_effort"), model_profile: selected_profile, system: get(config, "system"), tools: or(get(config, "tools"), ([]: List<String>)), output_type: type_id(type_evidence(output_type)), error_type: type_id(type_evidence(type_tag<nefor.contracts.AgentError>())), provider_error_type: type_id(type_evidence(type_tag<nefor.contracts.ProviderError>()))}, nefor.graph.store_port(llm_in), [nefor.graph.store_port(tool_calls), nefor.graph.store_port(result)], []) else nefor.graph.with_templateability(nefor.graph.closed_actor(llm_id, structured_output_factory, [type_evidence(output_type), type_evidence(type_tag<core.types.Result<nefor.contracts.AgentError, O>>())], if dynamic then StructuredOutputParams {model: get(resolved_model, "model"), provider: get(resolved_model, "provider"), reasoning_effort: get(resolved_model, "reasoning_effort"), model_profile: selected_profile, system: get(config, "system"), tools: or(get(config, "tools"), ([]: List<String>)), schema: schema, dynamic: dynamic, output_type: type_id(type_evidence(output_type)), error_type: type_id(type_evidence(type_tag<nefor.contracts.AgentError>())), provider_error_type: type_id(type_evidence(type_tag<nefor.contracts.ProviderError>())), dynamic_item_type: dynamic_item_type, dynamic_item_descriptor: dynamic_item_descriptor} else StructuredOutputParams {model: get(resolved_model, "model"), provider: get(resolved_model, "provider"), reasoning_effort: get(resolved_model, "reasoning_effort"), model_profile: selected_profile, system: get(config, "system"), tools: or(get(config, "tools"), ([]: List<String>)), schema: schema, output_type: type_id(type_evidence(output_type)), error_type: type_id(type_evidence(type_tag<nefor.contracts.AgentError>())), provider_error_type: type_id(type_evidence(type_tag<nefor.contracts.ProviderError>())), dynamic: dynamic, dynamic_item_type: dynamic_item_type, dynamic_item_descriptor: dynamic_item_descriptor}, nefor.graph.store_port(llm_in), [nefor.graph.store_port(tool_calls), nefor.graph.store_port(result)], []), if dynamic then named(nefor.graph.Templateability, Unsupported, "dynamic producers are streaming workers") else named(nefor.graph.Templateability, Closed, [])), nefor.graph.closed_actor(run_tool_id, run_tool_factory, [], RunToolParams {model: get(resolved_model, "model"), provider: get(resolved_model, "provider"), model_profile: selected_profile, conversation_peer: llm_id, tools: or(get(config, "tools"), ([]: List<String>)), tool_approval_policy: nefor.contracts.normalize_tool_approval_policy(get(config, "tool_approval_policy"))}, nefor.graph.store_port(run_in), [nefor.graph.store_port(run_out)], [nefor.graph.Relocation {path: ["conversation_peer"], shape: "actor_id"}]), nefor.graph.closed_actor(tool_result_id, tool_result_factory, [], ToolResultParams {}, nefor.graph.store_port(result_in), [nefor.graph.store_port(result_out)], [])], [nefor.graph.stored_route(entry_out, llm_in), nefor.graph.stored_route(tool_calls, run_in), nefor.graph.stored_route(run_out, result_in), nefor.graph.stored_route(result_out, llm_in)], [], [], [nefor.graph.logical_node([id], []), nefor.graph.logical_node([id, "entry"], [entry_id]), nefor.graph.logical_node([id, "llm"], [llm_id]), nefor.graph.logical_node([id, "run-tool"], [run_tool_id]), nefor.graph.logical_node([id, "tool-result"], [tool_result_id])], entry_in, result)
}

// Base toolset shorthands for common delegated-agent capability profiles.
// Explicit custom :tools lists remain the right shape for narrower
// roles or config-specific tools.
import nefor.toolsets.{}

let read_only_tools = nefor.toolsets.read_only

let general_tools = nefor.toolsets.general

let retry_gate<T>: fn(String, RetryGateConfig) -> nefor.graph.Node<T, nefor.contracts.RetryDecision<T>> = |id, config| => {
  let `type` = type_tag<T>()
  let actor_id = str(id, ".retry-gate")
  let input = nefor.graph.port(actor_id, `type`, "nefor.retry.Input")
  let result = nefor.graph.port(actor_id, type_tag<nefor.contracts.RetryDecision<T>>(), "nefor.retry.Result")
  nefor.graph.node_with_operations_and_nodes(id, "ordinary", [nefor.graph.with_templateability(nefor.graph.actor(actor_id, retry_gate_factory, [type_evidence(`type`), type_evidence(type_tag<nefor.contracts.RetryDecision<T>>())], RetryGateParams {max_retries: get(config, "max_retries")}, nefor.graph.store_port(input), [nefor.graph.store_port(result)]), named(nefor.graph.Templateability, Unsupported, "retry gates retain cross-activation state"))], [], [], [], [nefor.graph.logical_node([id], [actor_id])], input, result)
}
