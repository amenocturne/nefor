// Building agent nodes, for a configuration's own agent module. Workflows do
// not use this module directly: a configuration wraps agent in a module that
// names its own models.
import core.types.{}

import nefor.contracts.{}

import nefor.graph.{}

import nefor.llm.{}

// A reasoning effort that may be absent; value is a provider-neutral name
// such as "medium".
type OptionalReasoningEffort {present: Bool, value: String}

let reasoning_effort: fn(String) -> OptionalReasoningEffort = |value| => OptionalReasoningEffort {present: true, value: value}

let no_reasoning_effort = OptionalReasoningEffort {present: false, value: ""}

type CompactionThresholds = nefor.contracts.CompactionThresholds
type CompactionPolicy = nefor.contracts.CompactionPolicy
let disabled_compaction = nefor.contracts.disabled_compaction

// A fixed provider and model written into the program.
type ResolvedModel {compaction_policy: CompactionPolicy, provider: String, model: String, reasoning_effort: OptionalReasoningEffort}

// The name of a profile that the runtime resolves to a provider and model
// when a run starts.
type ModelProfile {name: String}

let model_profile: fn(String) -> ModelProfile = |name| => ModelProfile {name: name}

// What a configuration's model choice stands for.
type AuthoredModel = ResolvedModel(ResolvedModel) | ModelProfile(ModelProfile)

// What one agent is. M is the configuration's own model vocabulary; system is
// the agent's instructions; tools names exactly the tools it may call.
type AgentConfig<M> {model: M, system: String, tools: List<String>, tool_approval_policy: nefor.contracts.ToolApprovalPolicy}

// An agent node: it receives an I as its task and produces Ok(O), or
// Error(AgentError) when it ends without a result. resolve_model turns the
// configuration's model value into an AuthoredModel. With O = TextAnswer the
// agent answers in plain text; with O = DynamicList<T> it emits items one by
// one; with any other O it returns a value of that type.
let agent<M, I, O>: fn(String, fn(M) -> AuthoredModel, AgentConfig<M>) -> nefor.graph.Node<I, core.types.Result<nefor.contracts.AgentError, O>> = |id, resolve_model, config| => {
  let authored = resolve_model(get(config, "model"))
  let fixed = match authored { case ResolvedModel(value) => value, case ModelProfile(value) => ResolvedModel {compaction_policy: disabled_compaction, provider: "", model: "", reasoning_effort: no_reasoning_effort} }
  let profile = match authored { case ResolvedModel(value) => nefor.llm.no_model_profile, case ModelProfile(value) => nefor.llm.model_profile(get(value, "name")) }
  let effort = get(fixed, "reasoning_effort")
  nefor.llm.agent<I, O>(id, nefor.llm.AgentSpec {
    provider: get(fixed, "provider"),
    model: get(fixed, "model"),
    reasoning_effort: nefor.llm.OptionalReasoningEffort {present: get(effort, "present"), value: get(effort, "value")},
    model_profile: profile,
    compaction_policy: get(fixed, "compaction_policy"),
    system: get(config, "system"),
    tools: get(config, "tools"),
    tool_approval_policy: get(config, "tool_approval_policy")
  })
}
