import core.types.{}

// Validation is a library algebra, not a distinguished evaluator result.
type ValidationErrors<E> {errors: List<E>}

type Validated<E, T> = Valid(T) | Invalid(ValidationErrors<E>)

let valid<E, T>: fn(T) -> Validated<E, T> = |value| => Validated<E, T>.Valid(value)

let invalid<E, T>: fn(List<E>) -> Validated<E, T> = |errors| => Validated<E, T>.Invalid(ValidationErrors<E> {errors: errors})

let valid<E, T>: fn(Validated<E, T>) -> Bool = |validated| => match validated { case Valid(accepted) => true, case Invalid(rejected) => false }

let map<E, T, U>: fn(fn(T) -> U, Validated<E, T>) -> Validated<E, U> = |f, validated| => match validated { case Valid(accepted) => Validated<E, U>.Valid(f(accepted)), case Invalid(rejected) => Validated<E, U>.Invalid(rejected) }

let and_then<E, T, U>: fn(fn(T) -> Validated<E, U>, Validated<E, T>) -> Validated<E, U> = |f, validated| => match validated { case Valid(accepted) => f(accepted), case Invalid(rejected) => Validated<E, U>.Invalid(rejected) }
