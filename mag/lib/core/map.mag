import core.types.{}

// Native maps are unordered immutable data. Their storage order is never
// observable; deterministic ordering exists only at artifact serialization.
let empty<K, V>: fn() -> Map<K, V> = | | => __map_empty(type_tag<K>())

// insert requires a new key. put is the explicit replacement/upsert operation.
let insert<K, V>: fn(Map<K, V>, K, V) -> Map<K, V> = |map, key, value| => __map_insert(map, key, value)

let put<K, V>: fn(Map<K, V>, K, V) -> Map<K, V> = |map, key, value| => __map_put(map, key, value)

let contains_key<K, V>: fn(Map<K, V>, K) -> Bool = |map, key| => __map_contains(map, key)

let get<K, V>: fn(Map<K, V>, K) -> V = |map, key| => __map_get(map, key)

let get_or<K, V>: fn(Map<K, V>, K, V) -> V = |map, key, fallback| => __map_get_or(map, key, fallback)

let lookup<K, V>: fn(Map<K, V>, K) -> core.types.Option<V> = |map, key| => if __map_contains(map, key) then core.types.Option<V>.Some(__map_get(map, key)) else core.types.Option<V>.None()

let count<K, V>: fn(Map<K, V>) -> Int = |map| => __map_count(map)
