// Small algebraic types shared by MAG libraries. These are ordinary nominal
// data types; the evaluator has no special knowledge of them.
type Option<T> = Some(T) | None

type Either<L, R> = Left(L) | Right(R)

type Result<E, T> = Ok(T) | Error(E)

let some<T>: fn(T) -> Option<T> = |value| => Option<T>.Some(value)

let none<T>: fn() -> Option<T> = | | => Option<T>.None

let left<L, R>: fn(L) -> Either<L, R> = |value| => Either<L, R>.Left(value)

let right<L, R>: fn(R) -> Either<L, R> = |value| => Either<L, R>.Right(value)

let ok<E, T>: fn(T) -> Result<E, T> = |value| => Result<E, T>.Ok(value)

let error<E, T>: fn(E) -> Result<E, T> = |value| => Result<E, T>.Error(value)

let option_map<T, U>: fn(fn(T) -> U, Option<T>) -> Option<U> = |f, option| => match option { case Some(present) => Option<U>.Some(f(present)), case None => Option<U>.None }

let either_map<L, T, U>: fn(fn(T) -> U, Either<L, T>) -> Either<L, U> = |f, either| => match either { case Left(left_value) => Either<L, U>.Left(left_value), case Right(right_value) => Either<L, U>.Right(f(right_value)) }

let result_map<E, T, U>: fn(fn(T) -> U, Result<E, T>) -> Result<E, U> = |f, result| => match result { case Error(failure) => Result<E, U>.Error(failure), case Ok(value) => Result<E, U>.Ok(f(value)) }

let result_and_then<E, T, U>: fn(fn(T) -> Result<E, U>, Result<E, T>) -> Result<E, U> = |f, result| => match result { case Error(failure) => Result<E, U>.Error(failure), case Ok(value) => f(value) }
