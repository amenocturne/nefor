// The convenience import for workflow authors: import nefor.{...} selects any
// of these names. Each is declared, with its description, in the module it is
// taken from below; every other nefor.* module is an internal detail.
import nefor.actors.{}
import nefor.collections.{}
import nefor.contracts.{}
import nefor.human.{}
import nefor.path.{}
import nefor.process.{}
import nefor.retry.{}
import nefor.shell.{}
import nefor.toolsets.{}
import nefor.workflow.{}
import nefor.worktree.{}

// nefor.workflow: nodes, combining them, the Result channel.
type Node<I, O> = nefor.workflow.Node<I, O>
let compile_graph = nefor.workflow.compile_graph
let source = nefor.workflow.source
let identity = nefor.workflow.identity
let discard = nefor.workflow.discard
let `>>>` = nefor.workflow.`>>>`
let compose = nefor.workflow.compose
let `*>` = nefor.workflow.`*>`
let then = nefor.workflow.then
let `<*` = nefor.workflow.`<*`
let before = nefor.workflow.before
let `&&&` = nefor.workflow.`&&&`
let fanout = nefor.workflow.fanout
let `***` = nefor.workflow.`***`
let parallel = nefor.workflow.parallel
let keep_left = nefor.workflow.keep_left
let `+++` = nefor.workflow.`+++`
let choose = nefor.workflow.choose
let sequence = nefor.workflow.sequence
let node_named = nefor.workflow.node_named
let rename = nefor.workflow.rename
let lift = nefor.workflow.lift
let and_then = nefor.workflow.and_then
let `>=>` = nefor.workflow.`>=>`
let result_map = nefor.workflow.result_map
let result_map_named = nefor.workflow.result_map_named
let map_error = nefor.workflow.map_error
let map_error_named = nefor.workflow.map_error_named

// nefor.contracts: what agents and commands take and return.
type TextAnswer = nefor.contracts.TextAnswer
type ProviderInput = nefor.contracts.ProviderInput
type ProviderError = nefor.contracts.ProviderError
type AgentErrorReason = nefor.contracts.AgentErrorReason
type AgentError = nefor.contracts.AgentError
type ToolApprovalPolicy = nefor.contracts.ToolApprovalPolicy
type Timeout = nefor.contracts.Timeout
type ProcessExited = nefor.contracts.ProcessExited
type ProcessSignaled = nefor.contracts.ProcessSignaled
type ProcessTermination = nefor.contracts.ProcessTermination
type ProcessResult = nefor.contracts.ProcessResult

// nefor.shell, nefor.process, nefor.path: commands.
type ShellScriptParams = nefor.shell.ShellScriptParams
let script = nefor.shell.script
type ProcessExecParams = nefor.process.ProcessExecParams
let exec = nefor.process.exec
let cwd = nefor.process.cwd
let join = nefor.path.join

// nefor.worktree: Git worktrees.
type CreateSpec = nefor.worktree.CreateSpec
type OpenSpec = nefor.worktree.OpenSpec
type Worktree = nefor.worktree.Worktree
type WorktreeError = nefor.worktree.WorktreeError
let create = nefor.worktree.create
let open = nefor.worktree.open

// nefor.collections: collections sized at run time.
type DynamicList<T> = nefor.collections.DynamicList<T>
let traverse = nefor.collections.traverse
let context = nefor.collections.context

// nefor.retry and nefor.human: retry loops and human decisions.
type RetryGateConfig = nefor.retry.RetryGateConfig
type RetryDecision<T> = nefor.retry.RetryDecision<T>
let retry_gate = nefor.retry.retry_gate
type ApprovalConfig = nefor.human.ApprovalConfig
type HumanWorkflowApproval = nefor.human.HumanWorkflowApproval
type HumanWorkflowRejection = nefor.human.HumanWorkflowRejection
type HumanWorkflowDecision = nefor.human.HumanWorkflowDecision
let approval_gate = nefor.human.approval_gate

// nefor.toolsets: the configuration's ready-made tool lists.
let read_only_tools = nefor.toolsets.read_only
let general_tools = nefor.toolsets.general

// nefor.actors: building agent nodes, for a configuration's agent module.
type OptionalReasoningEffort = nefor.actors.OptionalReasoningEffort
let reasoning_effort = nefor.actors.reasoning_effort
let no_reasoning_effort = nefor.actors.no_reasoning_effort
type ModelProfile = nefor.actors.ModelProfile
let model_profile = nefor.actors.model_profile
type CompactionThresholds = nefor.actors.CompactionThresholds
type CompactionPolicy = nefor.actors.CompactionPolicy
let disabled_compaction = nefor.actors.disabled_compaction
type ResolvedModel = nefor.actors.ResolvedModel
type AuthoredModel = nefor.actors.AuthoredModel
type AgentConfig<M> = nefor.actors.AgentConfig<M>
let agent = nefor.actors.agent
