{
  "name": "starter-global-interrupt-recovers-for-next-turn",
  "command": {
    "argv": ["bash", "tests/tui/run-nefor-under-test.sh"],
    "cwd": ".",
    "cols": 120,
    "rows": 36
  },
  "steps": [
    {"kind": "wait_text", "text": "mock-model", "timeout_ms": 30000},
    {"kind": "type", "text": "show me help"},
    {"kind": "key", "key": "Enter"},
    {"kind": "wait_text", "text": "MOCK PROVIDER", "timeout_ms": 30000},
    {"kind": "key", "key": "Escape"},
    {"kind": "key", "key": "Escape"},
    {"kind": "key", "key": "Escape"},
    {"kind": "type", "text": "the secret key is recovery-ok"},
    {"kind": "key", "key": "Enter"},
    {"kind": "wait_text", "text": "secret key is now", "timeout_ms": 30000},
    {"kind": "wait_not_text", "text": "[thinking", "timeout_ms": 10000},
    {"kind": "key", "key": "CtrlC"},
    {"kind": "wait_text", "text": "NEFOR_EXIT_CODE=0", "timeout_ms": 10000},
    {"kind": "wait_exit", "timeout_ms": 10000}
  ]
}
