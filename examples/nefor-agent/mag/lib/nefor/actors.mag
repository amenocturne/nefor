(require "nefor.graph")
(require "nefor.contracts")

(type AgentConfig {:id String
                   :model nefor.contracts.OptionalIdentifier
                   :profile nefor.contracts.OptionalIdentifier
                   :provider String
                   :system String
                   :tools (List String)
                   :da-policy nefor.contracts.DaPolicy
                   :max-corrections Int})
(type ApprovalConfig {:id String :prompt String})
(type RetryGateConfig {:id String :max-retries Int})
(type BranchNode [I A B]
  {:id String
   :actors (List nefor.graph.Actor)
   :routes (List nefor.graph.StoredRoute)
   :messages (List nefor.graph.Message)
   :input (nefor.graph.Port I)
   :first (nefor.graph.Port A)
   :second (nefor.graph.Port B)})

(def branch-node-delta (fn [I A B]
  [[fragment (BranchNode I A B)]] -> nefor.graph.Delta
  (as nefor.graph.Delta
    {:actors (get fragment "actors")
     :routes (get fragment "routes")
     :messages (get fragment "messages")
     :kills []})))

(def task-source (fn [[id String] [prompt String]]
  -> (nefor.graph.Node Unit nefor.contracts.Task)
  (nefor.graph.source id
    (type-tag nefor.contracts.Task)
    (as nefor.contracts.Task {:prompt prompt}))))

;; Every agent has one public result port with semantic type `O | AgentError`.
;; The stable result wire carries the selected constructor identity. Ordinary
;; edges route compatible arms directly; `result-arm` creates a typed resident
;; subscription on that same actor/wire without inserting a selector actor.
(def agent (fn [I O] [[config AgentConfig] [input-type (TypeTag I)]
                [input-wire String] [output-type (TypeTag O)]]
  -> (nefor.graph.Node I (| O nefor.contracts.AgentError))
  (let [id (get config "id")
        entry-id (str id ".entry")
        llm-id (str id ".llm")
        run-tool-id (str id ".run-tool")
        tool-result-id (str id ".tool-result")

        entry-in (nefor.graph.port entry-id input-type input-wire)
        entry-out (nefor.graph.port entry-id
                    (type-tag nefor.contracts.ProviderInput)
                    "generic-provider.ProviderOut")
        llm-in (nefor.graph.port llm-id
                  (type-tag nefor.contracts.ProviderInput)
                  "generic-provider.ProviderOut")
        tool-calls (nefor.graph.port llm-id
                     (type-tag nefor.contracts.ToolCalls)
                     "generic-tool.ToolCalls")
        result (nefor.graph.port llm-id
                 (type-tag (| O nefor.contracts.AgentError))
                 "nefor.agent.Result")
        run-in (nefor.graph.port run-tool-id
                 (type-tag nefor.contracts.ToolCalls)
                 "generic-tool.ToolCalls")
        run-out (nefor.graph.port run-tool-id
                  (type-tag nefor.contracts.ToolHandle)
                  "generic-tool.ToolHandle")
        result-in (nefor.graph.port tool-result-id
                    (type-tag nefor.contracts.ToolHandle)
                    "generic-tool.ToolHandle")
        result-out (nefor.graph.port tool-result-id
                     (type-tag nefor.contracts.ProviderInput)
                     "generic-provider.ProviderOut")]

    (as (nefor.graph.Node I (| O nefor.contracts.AgentError)) {:id id :role "ordinary" :actors
       [(nefor.graph.actor entry-id (specialize nefor.factory.adapter [I])
         (as nefor.contracts.AdapterParams
           {:seed "provider-in" :schema (type-schema input-type)})
         (nefor.graph.store-port entry-in)
         [(nefor.graph.store-port entry-out)])
       (nefor.graph.actor llm-id (specialize nefor.factory.structured-output [O])
         (as nefor.contracts.StructuredOutputParams {:model (get config "model")
          :profile (get config "profile")
          :provider (get config "provider")
          :system (get config "system")
          :tools (or (get config "tools") (as (List String) []))
          :schema (type-schema output-type)
          :output_type (type-id (type-evidence output-type))
          :error_type
            (type-id (type-evidence (type-tag nefor.contracts.AgentError)))
          :provider_error_type
            (type-id (type-evidence (type-tag nefor.contracts.ProviderError)))
          :validation_error_type
            (type-id
              (type-evidence (type-tag nefor.contracts.OutputValidationError)))
          :max_corrections (get config "max-corrections")})
         (nefor.graph.store-port llm-in)
         [(nefor.graph.store-port tool-calls)
          (nefor.graph.store-port result)])
       (nefor.graph.actor run-tool-id nefor.factory.run-tool
         (as nefor.contracts.RunToolParams
           {:tools (or (get config "tools") (as (List String) []))
            :da-policy (get config "da-policy")})
         (nefor.graph.store-port run-in) [(nefor.graph.store-port run-out)])
       (nefor.graph.actor tool-result-id nefor.factory.tool-result
         (as nefor.contracts.ToolResultParams {})
         (nefor.graph.store-port result-in)
         [(nefor.graph.store-port result-out)])]
     :routes [(nefor.graph.stored-route entry-out llm-in)
              (nefor.graph.stored-route tool-calls run-in)
              (nefor.graph.stored-route run-out result-in)
              (nefor.graph.stored-route result-out llm-in)]
     :messages []
     :input entry-in
     :output result}))))

;; Base toolset shorthands for common delegated-agent capability profiles.
;; Explicit custom :tools lists remain the right shape for narrower
;; roles or config-specific tools.
(require "nefor.toolsets")
(def read-only-tools nefor.toolsets.read-only)
(def general-tools nefor.toolsets.general)

(def result-arm (fn [I O T]
  [[fragment (nefor.graph.Node I (| O nefor.contracts.AgentError))]
   [type (TypeTag T)]] -> (nefor.graph.Port T)
  (let [result (get fragment "output")]
    (nefor.graph.port (get result "actor") type (get result "wire")))))

(def retry-gate (fn [T] [[config RetryGateConfig] [type (TypeTag T)]]
  -> (BranchNode T (nefor.contracts.Continue T) (nefor.contracts.Exhausted T))
  (let [id (get config "id")
        actor-id (str id ".retry-gate")
        input (nefor.graph.port actor-id type "nefor.retry.Input")
        continued (nefor.graph.port actor-id
                    (type-tag (nefor.contracts.Continue T))
                    "nefor.retry.Continue")
        exhausted (nefor.graph.port actor-id
                    (type-tag (nefor.contracts.Exhausted T))
                    "nefor.retry.Exhausted")]
    (as (BranchNode T (nefor.contracts.Continue T) (nefor.contracts.Exhausted T))
      {:id id
       :actors [(nefor.graph.actor actor-id
                  (specialize nefor.factory.retry-gate [T])
                  (as nefor.contracts.RetryGateParams
                    {:max_retries (get config "max-retries")})
                  (nefor.graph.store-port input)
                  [(nefor.graph.store-port continued)
                   (nefor.graph.store-port exhausted)])]
       :routes (as (List nefor.graph.StoredRoute) [])
       :messages (as (List nefor.graph.Message) [])
       :input input
       :first continued
       :second exhausted}))))

(def approval-gate (fn [[config ApprovalConfig]]
  -> (BranchNode nefor.contracts.FinalAnswer nefor.contracts.Approved nefor.contracts.Rejected)
  (let [id (get config "id")
        actor-id (str id ".human")
        input (nefor.graph.port actor-id
                (type-tag nefor.contracts.FinalAnswer)
                "generic-provider.FinalAnswer")
        approved (nefor.graph.port actor-id
                   (type-tag nefor.contracts.Approved)
                   "human.Approved")
        rejected (nefor.graph.port actor-id
                   (type-tag nefor.contracts.Rejected)
                   "human.Rejected")]
    (as (BranchNode nefor.contracts.FinalAnswer nefor.contracts.Approved nefor.contracts.Rejected)
     {:id id :actors [(nefor.graph.actor actor-id nefor.factory.human
                (as nefor.contracts.HumanParams {:prompt (get config "prompt")})
                (nefor.graph.store-port input)
                [(nefor.graph.store-port approved)
                 (nefor.graph.store-port rejected)])]
     :routes (as (List nefor.graph.StoredRoute) [])
     :messages []
     :input input
     :first approved
     :second rejected}))))
