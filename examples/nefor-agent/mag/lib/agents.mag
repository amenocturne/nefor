// The agents of this configuration. A workflow builds every agent with
// agents.agent<Input, Output>(id, agents.AgentConfig {...}).
import core.types.{}

import agents.models.{}

import nefor.actors.{}

import nefor.contracts.{}

import nefor.graph.{}

// A model choice for the model field: one of the values below.
type Model = agents.models.Model

// The configuration's model for real work.
let standard = agents.models.Model.Standard

// The scripted mock provider: canned answers without a real model, for demos
// and tests.
let mock = agents.models.Model.Mock

// What one agent is.
type AgentConfig {
  // Which model runs the agent.
  model: Model,
  // The agent's own instructions. The runtime places them after this
  // configuration's common agent prompt and before the MAG context.
  system: String,
  // The tools the agent may call together with what it may do with them:
  // nefor.read_only_tools (the agent may only read; it can search with
  // commands by running read-only workflows, and anything that writes is
  // rejected in every permission mode), nefor.general_tools (the configured
  // approval behaviour for the current permission mode), or
  // nefor.contracts.Toolset {policy: ..., tools: [...]} for another selection.
  // The policy is ToolApprovalPolicy.ReadOnly or ToolApprovalPolicy.Default.
  toolset: nefor.contracts.Toolset
}

// An agent node: it receives an I as its task and produces Ok(O), or
// Error(AgentError) when it ends without a result. id names the node in the
// run.
let agent<I, O>: fn(String, AgentConfig) -> nefor.graph.Node<I, core.types.Result<nefor.contracts.AgentError, O>> = |id, config| => nefor.actors.agent<agents.models.Model, I, O>(id, agents.models.resolve, nefor.actors.AgentConfig<agents.models.Model> {model: get(config, "model"), system: get(config, "system"), toolset: get(config, "toolset")})
