import core.types.{}

import nefor.actors.{}


import nefor.contracts.{}


import nefor.graph.{}

// This example configuration owns the finite model vocabulary. Nefor only
// asks for one typed resolver; each constructor may author a concrete model or
// a configuration-resolved run profile.
type Model = Standard(Unit) | Mock(Unit)

let standard = named(Model, Standard, nil)

let mock = named(Model, Mock, nil)

let resolve_model: fn(Model) -> nefor.actors.AuthoredModel = |model| => match model { case Standard(value) => named(nefor.actors.AuthoredModel, ResolvedModel, nefor.actors.ResolvedModel {provider: "chatgpt", model: "gpt-5.6-sol", reasoning_effort: nefor.actors.reasoning_effort("medium")}), case Mock(value) => named(nefor.actors.AuthoredModel, ResolvedModel, nefor.actors.ResolvedModel {provider: "mock-provider", model: "mock-model", reasoning_effort: nefor.actors.reasoning_effort("medium")}) }

type AgentConfig {model: Model, system: String, tools: List<String>, tool_approval_policy: nefor.contracts.ToolApprovalPolicy}


let agent<I, O>: fn(String, AgentConfig) -> nefor.graph.Node<I, core.types.Result<nefor.contracts.AgentError, O>> = |id, config| => nefor.actors.agent<Model, I, O>(id, resolve_model, nefor.actors.AgentConfig<Model> {model: get(config, "model"), system: get(config, "system"), tools: get(config, "tools"), tool_approval_policy: get(config, "tool_approval_policy")})
