;; Each user message executes one short-lived lead constellation over the
;; persistent canonical chat history. Runtime-selected provider/model/system
;; values overlay lead.llm params before execution.

(require "nefor.actors")
(require "nefor.artifact")
(require "nefor.contracts")
(require "nefor.graph")

(let [start (nefor.graph.source "lead-task"
              (type-tag nefor.contracts.Task)
              (as nefor.contracts.Task {:prompt "<initial task text>"}))
      lead
      (nefor.actors.agent
        (as nefor.actors.AgentConfig {:id "lead"
         :model (nefor.contracts.no-identifier)
         :profile (nefor.contracts.no-identifier)
         :provider "chatgpt"
         :system ""
         :tools ["read_file"
                 "read_image"
                 "instructions"
                 "edit_file"
                 "graph-status"
                 "await-run"
                 "terminate-graph"
                 "write-review"
                 "mag"
                 "mag-eval"]
         :da-policy (nefor.contracts.no-da-policy)
         :max-corrections 2})
        (type-tag nefor.contracts.Task)
        "task"
        (type-tag nefor.contracts.FinalAnswer))
      result (nefor.graph.output "lead-output"
               (type-tag (| nefor.contracts.FinalAnswer nefor.contracts.AgentError)))
      topology (fn [[graph nefor.graph.Graph]] -> nefor.graph.Graph
                 (nefor.graph.add-edges graph
                   [(nefor.graph.edge start lead)
                    (nefor.graph.edge lead result)]))]
  (nefor.artifact.compile topology))
