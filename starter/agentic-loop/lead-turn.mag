;; Each user message executes one short-lived lead constellation over the
;; persistent canonical chat history. Runtime-selected provider/model/system
;; values overlay lead.llm params before execution.

(require "nefor.actors")
(require "nefor.artifact")
(require "nefor.contracts")
(require "nefor.graph")

(let [lead
      (nefor.actors.agent
        (as nefor.actors.AgentConfig {:id "lead"
         :model nil
         :profile nil
         :provider "chatgpt"
         :system ""
         :tools ["read_file"
                 "read_image"
                 "instructions"
                 "edit_file"
                 "graph-status"
                 "await-run"
                 "terminate-graph"
                 "write-review"
                 "mag"
                 "mag-eval"]
         :da-policy nil
         :max-corrections 2})
        (type-tag nefor.contracts.Task)
        "task"
        (type-tag nefor.contracts.FinalAnswer))
      initial
      (nefor.graph.message
        "lead.entry"
        (as Data {:kind "task" :prompt "<initial task text>"}))
      program
      (nefor.graph.finish
        lead
        (as (List nefor.graph.Message) [initial])
        (as (List nefor.graph.Rule) []))]
  (nefor.artifact.compile program))
