;; A downstream reviewer deliberately accepts the builder's whole result union,
;; so a failed builder can preserve partial output and still continue the graph.
(require "nefor.actors")
(require "nefor.artifact")
(require "nefor.contracts")
(require "nefor.graph")

(type BuildReport {:summary String})
(type ReviewReport {:assessment String})

(let [start (nefor.graph.source "recovery-input"
              (type-tag nefor.contracts.Task)
              (as nefor.contracts.Task {:prompt "Implement the change"}))
      builder
      (nefor.actors.agent
        (as nefor.actors.AgentConfig {:id "builder"
         :model (nefor.contracts.no-identifier)
         :profile (nefor.contracts.no-identifier) :provider "mock-provider"
         :system "Build the requested change." :tools (as (List String) [])
         :da-policy (nefor.contracts.no-da-policy) :max-corrections 0})
        (type-tag nefor.contracts.Task) "task" (type-tag BuildReport))
      reviewer
      (nefor.actors.agent
        (as nefor.actors.AgentConfig {:id "reviewer"
         :model (nefor.contracts.no-identifier)
         :profile (nefor.contracts.no-identifier) :provider "mock-provider"
         :system "Review the builder result, including retained partial output."
         :tools (as (List String) [])
         :da-policy (nefor.contracts.no-da-policy) :max-corrections 0})
        (type-tag (| BuildReport nefor.contracts.AgentError))
        "nefor.agent.Result"
        (type-tag ReviewReport))
      result (nefor.graph.output "recovery-output"
               (type-tag (| ReviewReport nefor.contracts.AgentError)))]
  (nefor.artifact.compile
    (fn [[graph nefor.graph.Graph]] -> nefor.graph.Graph
      (nefor.graph.add-edges graph
        [(nefor.graph.edge start builder)
         (nefor.graph.edge builder reviewer)
         (nefor.graph.edge reviewer result)]))))
