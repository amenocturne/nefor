;; Da policy definitions — per-node bash approval rules.
;;
;; Attach one to an agent/bash node via `:da-policy`
;; (e.g. `:da-policy (get policies "read-only-bash")`). Lowering places it on
;; the node's run-tool actor, which threads it into every `tool.invoke`
;; request (starter/mag-kernel/factories/run-tool.lua, "da-policy threading");
;; the tool-gate reads it to narrow bash approvals for that node.

(def read-only-bash {:allow ["ls" "cat" "head" "tail" "grep" "find" "wc" "git log" "git diff" "git show"]
                     :deny ["rm" "mv" "cp" "chmod" "chown" "sudo" "curl" "wget"]})

(def build-bash {:allow ["just *" "cargo *" "npm *" "bun *" "uv *" "make *" "git *"]
                 :deny ["rm -rf" "sudo" "curl" "wget"]})

(def deploy-bash {:allow ["just deploy*" "docker *" "ansible *" "ssh *"]
                  :deny ["rm -rf" "sudo rm"]})
