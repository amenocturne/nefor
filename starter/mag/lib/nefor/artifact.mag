(require "core.validated")
(require "nefor.graph")

(def format "nefor.graph-modification/v1")
(def delta-format "nefor.graph-delta/v1")

;; Authored programs are pure Graph -> Graph transformations. Compilation
;; applies one to empty-graph; the host recognizes only the final Artifact
;; wrapper and executes it as a fresh run.
(def compile (fn [[transform (Fn nefor.graph.Graph nefor.graph.Graph)]]
                 -> Artifact
  (let [graph (transform nefor.graph.empty-graph)
        checked (nefor.graph.validate
                  graph
                  (map nefor.graph.foreign-contract
                       (as (List Data)
                           (get (as (Map String Data) inputs)
                                "foreign_contracts"))))
        checked-tag (get checked "tag")]
    (if (= checked-tag "core.validated.Valid")
      (artifact format
        (nefor.graph.lower
          (get (as (core.validated.Valid nefor.graph.Graph) checked)
               "value")))
      (let [ignored (fail checked)]
        (artifact format {}))))))

(def compile-program (fn [[transform (Fn nefor.graph.Graph nefor.graph.Graph)]
                          [rules (List nefor.graph.Rule)]]
                         -> Artifact
  (let [graph (transform nefor.graph.empty-graph)
        checked (nefor.graph.validate
                  graph
                  (map nefor.graph.foreign-contract
                       (as (List Data)
                           (get (as (Map String Data) inputs)
                                "foreign_contracts"))))
        checked-tag (get checked "tag")]
    (if (= checked-tag "core.validated.Valid")
      (artifact format
        (nefor.graph.lower-program
          (as nefor.graph.Program
            {:graph (get (as (core.validated.Valid nefor.graph.Graph) checked) "value")
             :rules rules})))
      (let [ignored (fail checked)]
        (artifact format {}))))))

;; A rule result is deliberately a different host format. It has no result
;; boundary and cannot replace the run's immutable rule subscriptions.
(def delta (fn [[change nefor.graph.Delta]] -> Artifact
  (artifact delta-format (nefor.graph.lower-delta change))))
