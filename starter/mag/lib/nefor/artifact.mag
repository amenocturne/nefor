(require "core.validated")
(require "nefor.graph")

(def format "nefor.graph-modification/v1")
(def delta-format "nefor.graph-delta/v1")

;; Validation and lowering are explicit library calls. The host recognizes
;; only the final Artifact wrapper.
(def compile (fn [[graph nefor.graph.Graph]]
                 -> Artifact
  (let [checked (nefor.graph.validate
                  graph
                  (map nefor.graph.foreign-contract
                       (as (List Data)
                           (get (as (Map String Data) inputs)
                                "foreign_contracts"))))
        checked-tag (get checked "tag")]
    (if (= checked-tag "core.validated.Valid")
      (artifact format
        (nefor.graph.lower
          (get (as (core.validated.Valid nefor.graph.Graph) checked)
               "value")))
      (let [ignored (fail checked)]
        (artifact format {}))))))

;; A rule result is deliberately a different host format. It has no result
;; boundary and cannot replace the run's immutable rule subscriptions.
(def delta (fn [[change nefor.graph.Delta]] -> Artifact
  (artifact delta-format (nefor.graph.lower-delta change))))
