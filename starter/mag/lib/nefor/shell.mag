(require "nefor.graph")
(require "nefor.contracts")

(type BashOptions {:timeout_ms nefor.contracts.Timeout})

;; Shell execution is a foreign capability wrapped by ordinary library code.
(def bash (fn [I] [[id String] [command String] [options BashOptions]
               [input-type (TypeTag I)] [input-wire String]] -> (nefor.graph.Node I nefor.contracts.Text)
  (let [input (nefor.graph.port id
                input-type
                input-wire)
        output (nefor.graph.port id
                 (type-tag nefor.contracts.Text)
                 "mag.Text")]
    (as (nefor.graph.Node I nefor.contracts.Text)
     {:id id :role "ordinary" :actors [(nefor.graph.actor id nefor.factory.bash
                (as nefor.contracts.BashParams
                  {:command command
                   :timeout_ms (get options "timeout_ms")})
                (nefor.graph.store-port input)
                [(nefor.graph.store-port output)])]
     :routes (as (List nefor.graph.StoredRoute) [])
     :messages []
     :input input
     :output output}))))

(def command (fn [[id String] [text String]] -> (nefor.graph.Node Unit nefor.contracts.Text)
  (bash id text
        (as BashOptions {:timeout_ms (nefor.contracts.no-timeout)})
        (type-tag Unit) "mag.Unit")))

(def command-with-options
  (fn [[id String] [text String] [options BashOptions]] -> (nefor.graph.Node Unit nefor.contracts.Text)
    (bash id text options (type-tag Unit) "mag.Unit")))

(def pipe-command (fn [[id String] [text String]] -> (nefor.graph.Node nefor.contracts.Text nefor.contracts.Text)
  (bash id text
        (as BashOptions {:timeout_ms (nefor.contracts.no-timeout)})
        (type-tag nefor.contracts.Text)
        "mag.Text")))
