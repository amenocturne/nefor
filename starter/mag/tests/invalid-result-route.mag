(require "nefor.graph")
(require "nefor.shell")

;; Regression: a declared result port is terminal and cannot simultaneously
;; feed another actor.
(let [first (nefor.shell.command "first" "printf first")
      second (nefor.shell.pipe-command "second" "cat")
      program
      (nefor.graph.graph
        (concat (get first "actors") (get second "actors"))
        [(nefor.graph.store-route
           (nefor.graph.route (get first "output") (get second "input")))
         (nefor.graph.store-route
           (nefor.graph.route (get second "output") (get second "input")))]
        [(nefor.shell.start-message first)]
        (as (List nefor.graph.Rule) [])
        (get first "output"))
      bash-contract
      (nefor.graph.foreign-contract
        (as Data
          {:identity "nefor.factory.bash"
           :type_scheme
           {:input_tags ["mag.Unit" "mag.Text"]
            :outputs ["mag.Text"]}}))]
  (fail (nefor.graph.validate program [bash-contract])))
